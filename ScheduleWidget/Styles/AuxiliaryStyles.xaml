<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Opt-in styles: the original schedule window keeps its existing resources. -->
    <SolidColorBrush x:Key="AuxCanvasBrush" Color="#F5F5F7"/>
    <SolidColorBrush x:Key="AuxSurfaceBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="AuxInkBrush" Color="#1D1D1F"/>
    <SolidColorBrush x:Key="AuxMutedBrush" Color="#6E6E73"/>
    <SolidColorBrush x:Key="AuxActionBrush" Color="#1D1D1F"/>
    <SolidColorBrush x:Key="AuxFocusBrush" Color="#1D1D1F"/>
    <SolidColorBrush x:Key="AuxHairlineBrush" Color="#E0E0E0"/>
    <SolidColorBrush x:Key="AuxDarkBrush" Color="#252527"/>
    <SolidColorBrush x:Key="AuxOnDarkBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="AuxOnDarkMutedBrush" Color="#CCCCCC"/>
    <SolidColorBrush x:Key="AuxOnDarkBlueBrush" Color="#FFFFFF"/>
    <CornerRadius x:Key="AuxButtonCorners">3</CornerRadius>

    <Style x:Key="AuxTitle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Segoe UI"/>
        <Setter Property="FontSize" Value="32"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource AuxInkBrush}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>
    <Style x:Key="AuxSectionTitle" TargetType="TextBlock" BasedOn="{StaticResource AuxTitle}">
        <Setter Property="FontSize" Value="17"/>
    </Style>
    <Style x:Key="AuxCaption" TargetType="TextBlock">
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FontWeight" Value="Normal"/>
        <Setter Property="Foreground" Value="{DynamicResource AuxMutedBrush}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="LineHeight" Value="20"/>
    </Style>
    <Style x:Key="AuxBody" TargetType="TextBlock" BasedOn="{StaticResource AuxCaption}">
        <Setter Property="FontSize" Value="17"/>
        <Setter Property="LineHeight" Value="25"/>
        <Setter Property="Foreground" Value="{DynamicResource AuxInkBrush}"/>
    </Style>
    <Style x:Key="AuxSection" TargetType="Border">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="{DynamicResource AuxHairlineBrush}"/>
        <Setter Property="BorderThickness" Value="0,1,0,0"/>
        <Setter Property="CornerRadius" Value="0"/>
        <Setter Property="Padding" Value="0,20,0,0"/>
    </Style>
    <Style x:Key="AuxRoundSection" TargetType="Border" BasedOn="{StaticResource AuxSection}">
        <Setter Property="Background" Value="{DynamicResource AuxSurfaceBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="12"/>
        <Setter Property="Padding" Value="18"/>
    </Style>

    <Style x:Key="AuxPrimaryButton" TargetType="Button">
        <Setter Property="Background" Value="{DynamicResource AuxActionBrush}"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="BorderBrush" Value="{DynamicResource AuxActionBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FontWeight" Value="Normal"/>
        <Setter Property="Padding" Value="20,8"/>
        <Setter Property="MinHeight" Value="40"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Template"><Setter.Value>
            <ControlTemplate TargetType="Button">
                <Border x:Name="Face" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{DynamicResource AuxButtonCorners}" Padding="{TemplateBinding Padding}"
                        RenderTransformOrigin="0.5,0.5" SnapsToDevicePixels="True">
                    <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                </Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Face" Property="BorderBrush" Value="{DynamicResource AuxFocusBrush}"/><Setter TargetName="Face" Property="BorderThickness" Value="2"/></Trigger>
                    <Trigger Property="IsPressed" Value="True"><Setter TargetName="Face" Property="RenderTransform"><Setter.Value><ScaleTransform ScaleX="0.95" ScaleY="0.95"/></Setter.Value></Setter></Trigger>
                    <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Face" Property="Opacity" Value="0.4"/></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate>
        </Setter.Value></Setter>
    </Style>
    <!-- Outline button: action-colored frame; the text uses the theme's readable shade of the action color (App.xaml / AuxTheme). -->
    <Style x:Key="AuxSecondaryButton" TargetType="Button" BasedOn="{StaticResource AuxPrimaryButton}">
        <Setter Property="Background" Value="{DynamicResource AuxSurfaceBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource AuxActionTextBrush}"/>
    </Style>
    <Style x:Key="AuxUtilityButton" TargetType="Button" BasedOn="{StaticResource AuxPrimaryButton}">
        <Setter Property="Background" Value="{DynamicResource AuxSurfaceBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource AuxInkBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource AuxHairlineBrush}"/>
        <Setter Property="MinHeight" Value="36"/>
        <Setter Property="Padding" Value="12,6"/>
        <Setter Property="Template"><Setter.Value>
            <ControlTemplate TargetType="Button">
                <Border x:Name="Face" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="3" Padding="{TemplateBinding Padding}" RenderTransformOrigin="0.5,0.5">
                    <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                </Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Face" Property="BorderBrush" Value="{DynamicResource AuxFocusBrush}"/></Trigger>
                    <Trigger Property="IsPressed" Value="True"><Setter TargetName="Face" Property="RenderTransform"><Setter.Value><ScaleTransform ScaleX="0.95" ScaleY="0.95"/></Setter.Value></Setter></Trigger>
                    <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Face" Property="Opacity" Value="0.4"/></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate>
        </Setter.Value></Setter>
    </Style>
    <Style x:Key="AuxCompactButton" TargetType="Button" BasedOn="{StaticResource AuxSecondaryButton}">
        <Setter Property="MinHeight" Value="30"/><Setter Property="FontSize" Value="12"/><Setter Property="Padding" Value="10,3"/>
    </Style>
    <Style x:Key="AuxSaveButton" TargetType="Button" BasedOn="{StaticResource AuxPrimaryButton}">
        <Style.Resources><CornerRadius x:Key="AuxButtonCorners">3</CornerRadius></Style.Resources>
    </Style>
    <Style x:Key="AuxCancelButton" TargetType="Button" BasedOn="{StaticResource AuxSaveButton}">
        <Setter Property="Background" Value="{DynamicResource AuxSurfaceBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource AuxInkBrush}"/>
    </Style>
    <Style x:Key="AuxSaveCompactButton" TargetType="Button" BasedOn="{StaticResource AuxSaveButton}">
        <Setter Property="MinHeight" Value="30"/><Setter Property="FontSize" Value="12"/><Setter Property="Padding" Value="10,3"/>
    </Style>
    <Style x:Key="AuxCancelCompactButton" TargetType="Button" BasedOn="{StaticResource AuxCancelButton}">
        <Setter Property="MinHeight" Value="30"/><Setter Property="FontSize" Value="12"/><Setter Property="Padding" Value="10,3"/>
    </Style>

    <Style x:Key="AuxTextBox" TargetType="TextBox">
        <Setter Property="Margin" Value="0,4,0,12"/>
        <Setter Property="Background" Value="{DynamicResource AuxSurfaceBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource AuxInkBrush}"/>
        <Setter Property="CaretBrush" Value="{DynamicResource AuxActionBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource AuxHairlineBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="MinHeight" Value="36"/>
        <Setter Property="Padding" Value="12,7"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Template"><Setter.Value>
            <ControlTemplate TargetType="TextBox">
                <Border x:Name="Face" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="3">
                    <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                </Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="Face" Property="BorderBrush" Value="{DynamicResource AuxFocusBrush}"/></Trigger>
                    <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Face" Property="Opacity" Value="0.4"/></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate>
        </Setter.Value></Setter>
    </Style>
    <Style x:Key="AuxPasswordBox" TargetType="PasswordBox">
        <Setter Property="Margin" Value="0,4,0,16"/>
        <Setter Property="Background" Value="{DynamicResource AuxSurfaceBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource AuxInkBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource AuxHairlineBrush}"/>
        <Setter Property="BorderThickness" Value="1"/><Setter Property="MinHeight" Value="36"/>
        <Setter Property="Padding" Value="12,8"/><Setter Property="FontSize" Value="14"/>
        <Setter Property="Template"><Setter.Value>
            <ControlTemplate TargetType="PasswordBox">
                <Border x:Name="Face" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="3">
                    <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"/>
                </Border>
                <ControlTemplate.Triggers><Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="Face" Property="BorderBrush" Value="{DynamicResource AuxFocusBrush}"/></Trigger></ControlTemplate.Triggers>
            </ControlTemplate>
        </Setter.Value></Setter>
    </Style>
    <!-- The drop-down's colors (TextBrush, CardBrush …) come from the window: AuxTheme sets them per theme (Light = the old fixed values). -->
    <Style x:Key="AuxComboBox" TargetType="ComboBox" BasedOn="{StaticResource WidgetComboBox}">
        <Setter Property="Background" Value="{DynamicResource AuxSurfaceBrush}"/><Setter Property="Foreground" Value="{DynamicResource AuxInkBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource AuxHairlineBrush}"/><Setter Property="FontSize" Value="14"/>
        <Setter Property="MinHeight" Value="36"/><Setter Property="Padding" Value="12,4"/>
        <Setter Property="ItemContainerStyle"><Setter.Value>
            <Style TargetType="ComboBoxItem">
                <Setter Property="Foreground" Value="{DynamicResource AuxInkBrush}"/><Setter Property="Padding" Value="10,8"/>
                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBoxItem">
                    <Border x:Name="ItemFace" Background="Transparent" CornerRadius="3" Padding="{TemplateBinding Padding}">
                        <ContentPresenter Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsSelected" Value="True"><Setter TargetName="ItemFace" Property="Background" Value="{DynamicResource AuxCanvasBrush}"/></Trigger>
                        <!-- Action (not Ink) behind the white text: Dark's ink is near-white, which hid the hovered item. -->
                        <Trigger Property="IsHighlighted" Value="True"><Setter TargetName="ItemFace" Property="Background" Value="{DynamicResource AuxActionBrush}"/><Setter Property="Foreground" Value="White"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate></Setter.Value></Setter>
            </Style>
        </Setter.Value></Setter>
        <Setter Property="Template"><Setter.Value>
            <ControlTemplate TargetType="ComboBox">
                <Grid>
                    <Border x:Name="Face" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="3" Padding="{TemplateBinding Padding}">
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="20"/></Grid.ColumnDefinitions>
                            <ContentPresenter Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}" VerticalAlignment="Center"/>
                            <Path Grid.Column="1" Data="M0,0 L4,4 8,0" Stroke="{DynamicResource AuxMutedBrush}" StrokeThickness="1" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>
                    <ToggleButton Focusable="False" ClickMode="Press" IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                        <ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Border Background="Transparent"/></ControlTemplate></ToggleButton.Template>
                    </ToggleButton>
                    <Popup x:Name="PART_Popup" IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True" Focusable="False">
                        <Border Background="{DynamicResource AuxSurfaceBrush}" BorderBrush="{DynamicResource AuxHairlineBrush}" BorderThickness="1" Padding="4"
                                MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}">
                            <ScrollViewer MaxHeight="250" HorizontalScrollBarVisibility="Disabled"><ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/></ScrollViewer>
                        </Border>
                    </Popup>
                </Grid>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="Face" Property="BorderBrush" Value="{DynamicResource AuxFocusBrush}"/></Trigger>
                    <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4"/></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate>
        </Setter.Value></Setter>
    </Style>
    <Style x:Key="AuxCheckBox" TargetType="CheckBox">
        <Setter Property="Foreground" Value="{DynamicResource AuxInkBrush}"/><Setter Property="FontSize" Value="14"/>
        <Setter Property="MinHeight" Value="32"/><Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Padding" Value="6,0,0,0"/>
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="CheckBox">
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="18"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Border x:Name="CheckFace" Width="17" Height="17" CornerRadius="2" Background="{DynamicResource AuxSurfaceBrush}" BorderBrush="{DynamicResource AuxMutedBrush}" BorderThickness="1" VerticalAlignment="Center">
                    <Path x:Name="Tick" Data="M2,7 L5,10 11,3" Stroke="White" StrokeThickness="1.5" Visibility="Collapsed"/>
                </Border>
                <ContentPresenter Grid.Column="1" Margin="{TemplateBinding Padding}" VerticalAlignment="Center"/>
            </Grid>
            <ControlTemplate.Triggers>
                <Trigger Property="IsChecked" Value="True"><Setter TargetName="CheckFace" Property="Background" Value="{DynamicResource AuxActionBrush}"/><Setter TargetName="CheckFace" Property="BorderBrush" Value="{DynamicResource AuxActionBrush}"/><Setter TargetName="Tick" Property="Visibility" Value="Visible"/></Trigger>
                <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="CheckFace" Property="BorderThickness" Value="2"/></Trigger>
                <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4"/></Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="AuxToggleButton" TargetType="ToggleButton" BasedOn="{StaticResource WidgetToggleButton}">
        <Style.Resources><SolidColorBrush x:Key="AccentBrush" Color="#1D1D1F"/><SolidColorBrush x:Key="BorderBrush" Color="#D2D2D7"/><SolidColorBrush x:Key="CardBrush" Color="#FFFFFF"/></Style.Resources>
        <Setter Property="Template"><Setter.Value>
            <ControlTemplate TargetType="ToggleButton">
                <Border x:Name="Track" Background="#D2D2D7" CornerRadius="3" Padding="3">
                    <Rectangle x:Name="Thumb" Fill="White" Width="18" Height="18" RadiusX="2" RadiusY="2" HorizontalAlignment="Left"/>
                </Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsChecked" Value="True"><Setter TargetName="Track" Property="Background" Value="{DynamicResource AuxActionBrush}"/><Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right"/></Trigger>
                    <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4"/></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate>
        </Setter.Value></Setter>
    </Style>
    <!-- ON / OFF pill switch: green track with ON while on, light gray with OFF while off; round white knob.
         Used for every on/off setting (also on CheckBoxes: they are ToggleButtons). The ON green stays the bright iOS green
         #34C759 the user picked from a reference image; the OFF word is the darker gray #636366 so it stays readable;
         keyboard focus draws a ring in the focus color. -->
    <Style x:Key="AuxOnOffSwitch" TargetType="ToggleButton">
        <Setter Property="Width" Value="68"/><Setter Property="Height" Value="30"/><Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template"><Setter.Value>
            <ControlTemplate TargetType="ToggleButton">
                <Grid>
                    <Border x:Name="Track" CornerRadius="15" Background="#E5E5EA" BorderBrush="#D1D1D6" BorderThickness="1"/>
                    <TextBlock x:Name="OnText" Text="ON" Foreground="White" FontSize="11" FontWeight="Bold" Margin="11,0,0,0"
                               HorizontalAlignment="Left" VerticalAlignment="Center" Visibility="Collapsed"/>
                    <TextBlock x:Name="OffText" Text="OFF" Foreground="#636366" FontSize="11" FontWeight="Bold" Margin="0,0,9,0"
                               HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    <Ellipse x:Name="Knob" Width="24" Height="24" Margin="3,0" Fill="White" HorizontalAlignment="Left" VerticalAlignment="Center">
                        <Ellipse.Effect><DropShadowEffect BlurRadius="4" ShadowDepth="1" Opacity="0.3"/></Ellipse.Effect>
                    </Ellipse>
                </Grid>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsChecked" Value="True">
                        <Setter TargetName="Track" Property="Background" Value="#34C759"/><Setter TargetName="Track" Property="BorderBrush" Value="#2DB14E"/>
                        <Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right"/>
                        <Setter TargetName="OnText" Property="Visibility" Value="Visible"/><Setter TargetName="OffText" Property="Visibility" Value="Collapsed"/>
                    </Trigger>
                    <Trigger Property="IsKeyboardFocused" Value="True">
                        <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource AuxFocusBrush}"/><Setter TargetName="Track" Property="BorderThickness" Value="2"/>
                    </Trigger>
                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Track" Property="Opacity" Value="0.9"/></Trigger>
                    <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate>
        </Setter.Value></Setter>
    </Style>
    <Style x:Key="AuxTabItem" TargetType="TabItem">
        <Setter Property="Foreground" Value="{DynamicResource AuxInkBrush}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="FontSize" Value="14"/><Setter Property="Padding" Value="16,10"/>
        <Setter Property="Margin" Value="2"/><Setter Property="MinHeight" Value="40"/>
        <Setter Property="Template"><Setter.Value>
            <ControlTemplate TargetType="TabItem">
                <Border x:Name="Face" Background="{TemplateBinding Background}" CornerRadius="3" BorderBrush="Transparent" BorderThickness="1" Padding="{TemplateBinding Padding}">
                    <ContentPresenter x:Name="HeaderLabel" ContentSource="Header" HorizontalAlignment="Center" VerticalAlignment="Center" TextElement.Foreground="{DynamicResource AuxMutedBrush}"/>
                </Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsSelected" Value="True"><Setter TargetName="Face" Property="Background" Value="{DynamicResource AuxActionBrush}"/><Setter TargetName="HeaderLabel" Property="TextElement.Foreground" Value="White"/></Trigger>
                    <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Face" Property="BorderBrush" Value="{DynamicResource AuxFocusBrush}"/></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate>
        </Setter.Value></Setter>
    </Style>
    <Style x:Key="AuxTabs" TargetType="TabControl">
        <Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/>
        <Setter Property="ItemContainerStyle" Value="{StaticResource AuxTabItem}"/>
        <Setter Property="Template"><Setter.Value>
            <ControlTemplate TargetType="TabControl">
                <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <Border Background="{DynamicResource AuxCanvasBrush}" Padding="3" HorizontalAlignment="Left" Margin="0,0,0,16">
                        <TabPanel IsItemsHost="True" KeyboardNavigation.TabIndex="1"/>
                    </Border>
                    <ContentPresenter Grid.Row="1" x:Name="PART_SelectedContentHost" ContentSource="SelectedContent"/>
                </Grid>
            </ControlTemplate>
        </Setter.Value></Setter>
    </Style>
    <Style x:Key="AuxMenuItem" TargetType="MenuItem">
        <Setter Property="Background" Value="{DynamicResource AuxSurfaceBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource AuxInkBrush}"/>
        <Setter Property="FontSize" Value="14"/><Setter Property="Padding" Value="12,8"/>
        <Setter Property="MinHeight" Value="36"/>
    </Style>
    <Style x:Key="AuxContextMenu" TargetType="ContextMenu">
        <Setter Property="Background" Value="{DynamicResource AuxSurfaceBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource AuxInkBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource AuxHairlineBrush}"/>
        <Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="8"/>
        <Setter Property="HasDropShadow" Value="False"/>
        <Setter Property="Template"><Setter.Value>
            <ControlTemplate TargetType="ContextMenu">
                <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                    <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle"/>
                </Border>
            </ControlTemplate>
        </Setter.Value></Setter>
    </Style>
</ResourceDictionary>
