<Window x:Class="ScheduleWidget.PetSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:ScheduleWidget"
        Title="캐릭터 설정" Width="380" Height="640" MinWidth="330" MinHeight="420" WindowStartupLocation="Manual"
        ShowInTaskbar="False" ResizeMode="CanResizeWithGrip" WindowStyle="None"
        Background="{DynamicResource AuxCanvasBrush}" Foreground="{DynamicResource AuxInkBrush}" FontFamily="Segoe UI"
        PreviewKeyDown="PetSettings_KeyDown">
    <Window.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="Styles/AuxiliaryStyles.xaml"/>
    </ResourceDictionary.MergedDictionaries></ResourceDictionary></Window.Resources>
    <!-- Everything about the mini window's pets in one place (opened by right-clicking a pet). Changes apply at once.
         No title bar or icon: drag the header to move, X to close. -->
    <Border BorderBrush="{DynamicResource AuxHairlineBrush}" BorderThickness="1">
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Grid Background="Transparent" Margin="18,14,10,10" MouseLeftButtonDown="Header_MouseLeftButtonDown" Cursor="SizeAll">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock x:Name="HeaderTitle" Text="캐릭터 설정" Style="{StaticResource AuxTitle}" FontSize="22" TextTrimming="CharacterEllipsis"/>
                <TextBlock x:Name="HeaderHint" Text="바꾸는 즉시 미니 창에 반영되고 저장됩니다." Style="{StaticResource AuxCaption}" Margin="0,4,0,0"/>
            </StackPanel>
            <Button Grid.Column="1" Width="34" Height="34" Padding="0" VerticalAlignment="Top" Cursor="Hand" Style="{StaticResource AuxUtilityButton}"
                    Click="Close_Click" AutomationProperties.Name="닫기">
                <Path Data="M4,4 L12,12 M12,4 L4,12" Width="12" Height="12" Stretch="Fill" Stroke="{DynamicResource AuxMutedBrush}"
                      StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
            </Button>
        </Grid>
    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="18,4,18,18">

            <!-- Pets (1~3): pick one to edit its action; change / remove it; add another. -->
            <Border Style="{StaticResource AuxRoundSection}" Padding="12" Margin="0,0,0,10">
                <StackPanel>
                    <TextBlock Text="캐릭터" Style="{StaticResource AuxSectionTitle}" Margin="0,0,0,8"/>
                    <ItemsControl x:Name="PetList">
                        <ItemsControl.ItemTemplate><DataTemplate>
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <RadioButton GroupName="Pets" IsChecked="{Binding Selected, Mode=OneWay}" Tag="{Binding Index}" Checked="Pet_Checked"
                                             VerticalContentAlignment="Center" Foreground="{DynamicResource AuxInkBrush}">
                                    <TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis" FontSize="13"/>
                                </RadioButton>
                                <!-- 보이기: hide this one pet without removing it (beside the TODO window: not the last one showing). -->
                                <CheckBox Grid.Column="1" Content="보이기" Tag="{Binding Index}" IsChecked="{Binding Shown, Mode=OneWay}" IsEnabled="{Binding CanHide}" Click="PetShown_Click"
                                          VerticalAlignment="Center" Margin="6,0,2,0" Style="{StaticResource AuxCheckBox}" AutomationProperties.Name="이 캐릭터 보이기"/>
                                <Button Grid.Column="2" Content="바꾸기" Tag="{Binding Index}" Height="28" Padding="10,0" Margin="6,0,0,0"
                                        Style="{StaticResource AuxCompactButton}" Click="ChangePet_Click"/>
                                <Button Grid.Column="3" Content="빼기" Tag="{Binding Index}" Height="28" Padding="10,0" Margin="4,0,0,0"
                                        IsEnabled="{Binding CanRemove}" Style="{StaticResource AuxCompactButton}" Click="RemovePet_Click"/>
                            </Grid>
                        </DataTemplate></ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Button x:Name="AddPetButton" Content="캐릭터 추가 (최대 3)" Height="32" Margin="0,4,0,0" Style="{StaticResource AuxCompactButton}" Click="AddPet_Click"/>
                </StackPanel>
            </Border>

            <!-- The selected pet's action. -->
            <Border Style="{StaticResource AuxRoundSection}" Padding="12" Margin="0,0,0,10">
                <StackPanel>
                    <TextBlock x:Name="ActionTitle" Text="동작" Style="{StaticResource AuxSectionTitle}" Margin="0,0,0,8" TextTrimming="CharacterEllipsis"/>
                    <ItemsControl x:Name="ActionButtons">
                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="3"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate><DataTemplate>
                            <Button Content="{Binding Label}" Tag="{Binding Key}" ToolTip="{Binding Tip}" Click="Action_Click" Height="30" Margin="2" Padding="3,0">
                                <Button.Style><Style TargetType="Button" BasedOn="{StaticResource AuxCompactButton}">
                                    <Style.Triggers><DataTrigger Binding="{Binding Selected}" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource AuxActionBrush}"/><Setter Property="Foreground" Value="White"/>
                                    </DataTrigger></Style.Triggers>
                                </Style></Button.Style>
                            </Button>
                        </DataTemplate></ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <!-- 타이핑 반응 (offered for sprite pets): what it reads of the keyboard. -->
                    <TextBlock x:Name="TypingHint" Visibility="Collapsed" TextWrapping="Wrap" Style="{StaticResource AuxCaption}" Margin="2,6,0,0"
                               Text="타이핑 반응: 다른 앱에서 타자를 쳐도 캐릭터가 따라 움직입니다. 어떤 키를 눌렀는지는 읽지 않고, 눌렀다는 사실만 셉니다."/>
                </StackPanel>
            </Border>

            <!-- Size, visibility and where the pets stand around the calendar (the TODO window's pets: around that window,
                 kept apart from the mini window's; the labels say which). -->
            <Border Style="{StaticResource AuxRoundSection}" Padding="12" Margin="0,0,0,10">
                <StackPanel>
                    <CheckBox x:Name="VisibleToggle" Content="미니 창에 캐릭터 표시" Style="{StaticResource AuxCheckBox}" Click="Visible_Click" Margin="0,0,0,10"/>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBlock x:Name="ScaleTitle" Text="크기" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource AuxInkBrush}"/>
                        <TextBlock x:Name="ScaleText" Grid.Column="1" Text="100%" Foreground="{DynamicResource AuxInkBrush}"/>
                    </Grid>
                    <Slider x:Name="ScaleSlider" Minimum="50" Maximum="300" TickFrequency="10" IsSnapToTickEnabled="True" IsMoveToPointEnabled="True"
                            local:SliderInteraction.EnableMouseDrag="True" ValueChanged="Scale_ValueChanged" AutomationProperties.Name="캐릭터 크기"/>
                    <!-- 좌우 반전: mirrors the selected pet's drawing (every action); its spot and size stay. -->
                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBlock x:Name="FlipTitle" Text="좌우 반전" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource AuxInkBrush}"/>
                        <CheckBox x:Name="FlipSwitch" Grid.Column="1" Margin="10,0,0,0" Style="{StaticResource AuxOnOffSwitch}" VerticalAlignment="Center"
                                  Click="Flip_Click" AutomationProperties.Name="이 캐릭터 좌우 반전"/>
                    </Grid>
                    <TextBlock x:Name="PlacementTitle" Text="위치 (달력 기준)" FontWeight="SemiBold" Foreground="{DynamicResource AuxInkBrush}" Margin="0,12,0,6"/>
                    <ComboBox x:Name="SideCombo" Height="32" Style="{StaticResource AuxComboBox}" SelectionChanged="Placement_Changed" AutomationProperties.Name="캐릭터를 둘 쪽">
                        <ComboBoxItem x:Name="SideLeftItem" Content="달력 왼쪽"/>
                        <ComboBoxItem x:Name="SideRightItem" Content="달력 오른쪽"/>
                    </ComboBox>
                    <Grid Margin="0,10,0,2">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBlock Text="세로 위치" Foreground="{DynamicResource AuxInkBrush}"/>
                        <TextBlock x:Name="VerticalText" Grid.Column="1" Text="아래" Foreground="{DynamicResource AuxInkBrush}"/>
                    </Grid>
                    <Slider x:Name="VerticalSlider" Minimum="0" Maximum="100" TickFrequency="5" IsSnapToTickEnabled="True" IsMoveToPointEnabled="True"
                            local:SliderInteraction.EnableMouseDrag="True" ValueChanged="Placement_Changed" AutomationProperties.Name="캐릭터 세로 위치"/>
                    <Grid Margin="0,10,0,2">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBlock x:Name="GapTitle" Text="달력과 간격" Foreground="{DynamicResource AuxInkBrush}"/>
                        <TextBlock x:Name="GapText" Grid.Column="1" Text="8px" Foreground="{DynamicResource AuxInkBrush}"/>
                    </Grid>
                    <Slider x:Name="GapSlider" Minimum="-80" Maximum="60" TickFrequency="2" IsSnapToTickEnabled="True" IsMoveToPointEnabled="True"
                            local:SliderInteraction.EnableMouseDrag="True" ValueChanged="Placement_Changed" AutomationProperties.Name="캐릭터와 달력 사이 간격"/>
                    <TextBlock Text="왼쪽/오른쪽이나 간격을 바꾸면 드래그로 옮긴 캐릭터가 기본 배치로 돌아갑니다. 세로 위치는 높이만 맞춥니다."
                               TextWrapping="Wrap" Style="{StaticResource AuxCaption}" Margin="0,6,0,10"/>
                    <Button x:Name="PlaceButton" Content="드래그로 위치 설정" Height="34" Style="{StaticResource AuxPrimaryButton}" Click="Place_Click"/>
                    <TextBlock x:Name="PlaceHint" Text="누르면 이 창이 닫히고, 캐릭터를 끌어서 달력 주위 어디에나 놓을 수 있습니다."
                               TextWrapping="Wrap" Style="{StaticResource AuxCaption}" Margin="0,6,0,0"/>
                </StackPanel>
            </Border>
            <!-- 초기화: two presses (the first turns it into 정말 초기화), like the app's 삭제. -->
            <Button x:Name="ResetButton" Content="초기화" Height="32" HorizontalAlignment="Left" Padding="14,0" Margin="0,4,0,0"
                    Style="{StaticResource AuxCompactButton}" Click="Reset_Click" AutomationProperties.Name="캐릭터 설정 초기화"/>
            <TextBlock x:Name="ResetHint" Text="모든 캐릭터를 보이게, 크기 100%, 좌우 반전 끔, 기본 위치(달력 왼쪽·아래·간격 8px), 동작 대기로 되돌립니다. 캐릭터 목록은 그대로 둡니다."
                       TextWrapping="Wrap" Style="{StaticResource AuxCaption}" Margin="0,6,0,0"/>
        </StackPanel>
    </ScrollViewer>
    </Grid>
    </Border>
</Window>
