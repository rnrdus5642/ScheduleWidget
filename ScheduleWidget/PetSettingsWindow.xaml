<Window x:Class="ScheduleWidget.PetSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:ScheduleWidget"
        Title="캐릭터 설정" Width="380" Height="640" MinWidth="330" MinHeight="420" WindowStartupLocation="Manual"
        ShowInTaskbar="False" ResizeMode="CanResizeWithGrip" WindowStyle="None"
        Background="{DynamicResource AuxCanvasBrush}" Foreground="{DynamicResource AuxInkBrush}" FontFamily="Segoe UI" FontSize="14"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display" PreviewKeyDown="PetSettings_KeyDown">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Styles/AuxiliaryStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <Style x:Key="PetCard" TargetType="Border" BasedOn="{StaticResource AuxRoundSection}">
                <Setter Property="Padding" Value="16"/>
                <Setter Property="Margin" Value="0,0,0,14"/>
            </Style>
            <Style x:Key="PetButton" TargetType="Button" BasedOn="{StaticResource AuxCompactButton}">
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="MinHeight" Value="34"/>
                <Setter Property="Padding" Value="8,5"/>
            </Style>
            <Style x:Key="PetHint" TargetType="TextBlock" BasedOn="{StaticResource AuxCaption}">
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="LineHeight" Value="18"/>
            </Style>
            <Style x:Key="PetValue" TargetType="TextBlock">
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Foreground" Value="{DynamicResource AuxInkBrush}"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
            </Style>
            <ItemsPanelTemplate x:Key="PetActionsWidePanel"><UniformGrid Columns="3"/></ItemsPanelTemplate>
            <ItemsPanelTemplate x:Key="PetActionsNarrowPanel"><UniformGrid Columns="2"/></ItemsPanelTemplate>
        </ResourceDictionary>
    </Window.Resources>
    <Border x:Name="PetSettingsRoot" BorderBrush="{DynamicResource AuxHairlineBrush}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <Grid x:Name="PetEditorHeader" Background="Transparent" Margin="18,16,12,14" MouseLeftButtonDown="Header_MouseLeftButtonDown" Cursor="SizeAll">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,10,0">
                    <TextBlock Text="캐릭터 설정" Style="{StaticResource PetHint}" Margin="0,0,0,3"/>
                    <TextBlock x:Name="HeaderTitle" Style="{StaticResource AuxTitle}" FontSize="21" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
                    <TextBlock x:Name="HeaderHint" Text="변경 내용은 자동 저장됩니다." Style="{StaticResource PetHint}" Margin="0,5,0,0"/>
                </StackPanel>
                <Button x:Name="PersonalHelpButton" Grid.Column="1" Content="?" Width="30" Height="34" MinHeight="34" Padding="0" Margin="0,0,6,0" VerticalAlignment="Top"
                        Style="{StaticResource AuxUtilityButton}" Click="Help_Click" ToolTip="캐릭터 추가 방법" AutomationProperties.Name="캐릭터 만들기와 다운로드 안내"/>
                <Button Grid.Column="2" Width="34" Height="34" MinHeight="34" Padding="0" VerticalAlignment="Top" Style="{StaticResource AuxUtilityButton}"
                        Click="Close_Click" ToolTip="닫기" AutomationProperties.Name="닫기">
                    <Path Data="M4,4 L12,12 M12,4 L4,12" Width="12" Height="12" Stretch="Fill" Stroke="{DynamicResource AuxMutedBrush}"
                          StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                </Button>
            </Grid>
            <ScrollViewer x:Name="PetSettingsScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel x:Name="SettingsBody" Margin="18,0,18,18">
                    <Border x:Name="GlobalVisibilitySection" Style="{StaticResource PetCard}">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center" Margin="0,0,14,0">
                                <TextBlock x:Name="GlobalVisibilityLabel" Text="달력에 캐릭터 표시" Style="{StaticResource AuxSectionTitle}"/>
                                <TextBlock x:Name="GlobalHiddenHint" Text="전체 표시를 켜면 개별 표시 설정대로 나타납니다." Style="{StaticResource PetHint}" Margin="0,5,0,0" Visibility="Collapsed"/>
                            </StackPanel>
                            <CheckBox x:Name="VisibleToggle" Grid.Column="1" Style="{StaticResource AuxOnOffSwitch}" VerticalAlignment="Center"
                                      Click="Visible_Click" AutomationProperties.LabeledBy="{Binding ElementName=GlobalVisibilityLabel}"/>
                        </Grid>
                    </Border>

                    <Grid x:Name="SettingsSections" SizeChanged="SettingsSections_SizeChanged">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition x:Name="PlacementColumnWidth" Width="0"/></Grid.ColumnDefinitions>
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>

                        <Border x:Name="PetRosterSection" Style="{StaticResource PetCard}" VerticalAlignment="Top">
                            <StackPanel>
                                <Grid Margin="0,0,0,14">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="내 캐릭터" Style="{StaticResource AuxSectionTitle}"/>
                                    <TextBlock x:Name="PetCountText" Grid.Column="1" Style="{StaticResource PetHint}" VerticalAlignment="Center"/>
                                </Grid>
                                <ItemsControl x:Name="PetList">
                                    <ItemsControl.ItemTemplate><DataTemplate>
                                        <Border Background="{DynamicResource AuxCanvasBrush}" CornerRadius="8" Padding="12" Margin="0,0,0,10">
                                            <StackPanel>
                                                <Grid Margin="0,0,0,12">
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                    <TextBlock x:Name="PetNameLabel" Text="{Binding Label}" ToolTip="{Binding Name}" FontSize="15" FontWeight="SemiBold"
                                                               Foreground="{DynamicResource AuxInkBrush}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                                    <TextBlock Grid.Column="1" Text="표시" Style="{StaticResource PetHint}" Margin="10,0,8,0" VerticalAlignment="Center"/>
                                                    <CheckBox Grid.Column="2" Tag="{Binding Index}" IsChecked="{Binding Shown, Mode=OneWay}" IsEnabled="{Binding CanHide}"
                                                              Style="{StaticResource AuxOnOffSwitch}" Click="PetShown_Click" ToolTip="{Binding VisibilityHint}" ToolTipService.ShowOnDisabled="True"
                                                              AutomationProperties.Name="{Binding VisibilityName}"/>
                                                </Grid>
                                                <UniformGrid Columns="3">
                                                    <Button Content="개별 설정" Tag="{Binding Index}" Margin="0,0,4,0" Style="{StaticResource PetButton}" Click="ConfigurePet_Click"
                                                            ToolTip="크기, 동작, 좌우 반전과 개별 위치를 설정합니다."/>
                                                    <Button Content="바꾸기" Tag="{Binding Index}" Margin="2,0" Style="{StaticResource PetButton}" Click="ChangePet_Click"
                                                            ToolTip="다른 캐릭터로 바꿉니다."/>
                                                    <Button Content="빼기" Tag="{Binding Index}" Margin="4,0,0,0" IsEnabled="{Binding CanRemove}" Style="{StaticResource PetButton}" Click="RemovePet_Click"
                                                            ToolTip="{Binding RemoveHint}" ToolTipService.ShowOnDisabled="True"/>
                                                </UniformGrid>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate></ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <Button x:Name="AddPetButton" Content="캐릭터 추가" Style="{StaticResource PetButton}" Click="AddPet_Click" ToolTipService.ShowOnDisabled="True"/>
                                <Button x:Name="CharacterHelpButton" Content="캐릭터 추가 방법" Style="{StaticResource PetButton}" Click="Help_Click" Margin="0,8,0,0"
                                        ToolTip="직접 만들거나 웹에서 받은 캐릭터를 추가하는 방법"/>
                            </StackPanel>
                        </Border>

                        <Border x:Name="PersonalAppearancePanel" Style="{StaticResource PetCard}">
                            <StackPanel>
                                <TextBlock Text="표시와 크기" Style="{StaticResource AuxSectionTitle}" Margin="0,0,0,16"/>
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="이 캐릭터 표시" Foreground="{DynamicResource AuxInkBrush}" VerticalAlignment="Center"/>
                                    <CheckBox x:Name="IndividualVisibleToggle" Grid.Column="1" Style="{StaticResource AuxOnOffSwitch}" Click="IndividualVisible_Click"
                                              AutomationProperties.Name="이 캐릭터 표시" ToolTipService.ShowOnDisabled="True"/>
                                </Grid>
                                <Grid Margin="0,18,0,6">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <TextBlock x:Name="ScaleTitle" Text="크기" Foreground="{DynamicResource AuxInkBrush}"/>
                                    <TextBlock x:Name="ScaleText" Grid.Column="1" Text="100%" Style="{StaticResource PetValue}"/>
                                </Grid>
                                <Slider x:Name="ScaleSlider" Minimum="50" Maximum="300" TickFrequency="10" IsSnapToTickEnabled="True" IsMoveToPointEnabled="True"
                                        local:SliderInteraction.EnableMouseDrag="True" ValueChanged="Scale_ValueChanged" AutomationProperties.Name="캐릭터 크기"/>
                                <Grid Margin="0,16,0,0">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <TextBlock x:Name="FlipTitle" Text="좌우 반전" Foreground="{DynamicResource AuxInkBrush}" VerticalAlignment="Center"/>
                                    <CheckBox x:Name="FlipSwitch" Grid.Column="1" Style="{StaticResource AuxOnOffSwitch}" Click="Flip_Click" AutomationProperties.Name="이 캐릭터 좌우 반전"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <StackPanel x:Name="PlacementColumn" Grid.Row="1" VerticalAlignment="Top">
                            <Border Style="{StaticResource PetCard}">
                                <StackPanel>
                                    <TextBlock x:Name="PlacementSectionTitle" Text="전체 배치" Style="{StaticResource AuxSectionTitle}" Margin="0,0,0,14"/>
                                    <Button x:Name="PlaceButton" Content="드래그로 배치" Style="{StaticResource AuxPrimaryButton}" Click="Place_Click" ToolTipService.ShowOnDisabled="True"/>
                                    <TextBlock x:Name="PlaceHint" Style="{StaticResource PetHint}" Margin="0,8,0,0"/>
                                    <Button x:Name="PositionResetButton" Content="위치만 초기화" Style="{StaticResource PetButton}" Margin="0,12,0,0" Click="PositionReset_Click"/>
                                </StackPanel>
                            </Border>
                            <Border x:Name="ActionSection" Style="{StaticResource PetCard}">
                                <StackPanel>
                                    <TextBlock x:Name="ActionTitle" Text="동작" Style="{StaticResource AuxSectionTitle}" Margin="0,0,0,12"/>
                                    <ItemsControl x:Name="ActionButtons" ItemsPanel="{StaticResource PetActionsWidePanel}" SizeChanged="ActionButtons_SizeChanged">
                                        <ItemsControl.ItemTemplate><DataTemplate>
                                            <Button Content="{Binding Label}" Tag="{Binding Key}" ToolTip="{Binding Tip}" Click="Action_Click" Margin="2" Padding="4,7"
                                                    AutomationProperties.Name="{Binding Label}">
                                                <Button.ContentTemplate><DataTemplate><TextBlock Text="{Binding}" TextWrapping="Wrap" TextAlignment="Center"/></DataTemplate></Button.ContentTemplate>
                                                <Button.Style><Style TargetType="Button" BasedOn="{StaticResource PetButton}">
                                                    <Style.Triggers><DataTrigger Binding="{Binding Selected}" Value="True">
                                                        <Setter Property="Background" Value="{DynamicResource AuxActionBrush}"/><Setter Property="Foreground" Value="White"/>
                                                    </DataTrigger></Style.Triggers>
                                                </Style></Button.Style>
                                            </Button>
                                        </DataTemplate></ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <TextBlock x:Name="StillImageHint" Text="정지 이미지는 동작을 바꿀 수 없습니다." Visibility="Collapsed" Style="{StaticResource PetHint}" Margin="0,10,0,0"/>
                                    <TextBlock x:Name="TypingHint" Visibility="Collapsed" Style="{StaticResource PetHint}" Margin="0,10,0,0"/>
                                </StackPanel>
                            </Border>
                            <Button x:Name="ResetButton" Content="초기화" HorizontalAlignment="Left" Style="{StaticResource PetButton}" Click="Reset_Click"/>
                            <TextBlock x:Name="ResetHint" Style="{StaticResource PetHint}" Margin="0,6,0,0"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Border>
</Window>
