<Window x:Class="ScheduleWidget.UpdateConfirmationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ScheduleWidget 업데이트" Width="560" Height="620" MinWidth="360" MinHeight="400"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize" ShowInTaskbar="False"
        Background="{DynamicResource AuxSurfaceBrush}" Foreground="{DynamicResource AuxInkBrush}"
        FontFamily="Segoe UI, Malgun Gothic" FontSize="13" Language="ko-KR"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display"
        KeyboardNavigation.TabNavigation="Cycle" AutomationProperties.Name="업데이트 설치 확인">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Styles/AuxiliaryStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <CornerRadius x:Key="AuxButtonCorners">8</CornerRadius>
            <Style x:Key="UpdateActionButton" TargetType="Button" BasedOn="{StaticResource AuxPrimaryButton}">
                <Setter Property="Height" Value="42"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True"><Setter Property="Opacity" Value="0.85"/></Trigger>
                </Style.Triggers>
            </Style>
            <Style x:Key="UpdateQuietButton" TargetType="Button" BasedOn="{StaticResource UpdateActionButton}">
                <Setter Property="Background" Value="{DynamicResource AuxSurfaceBrush}"/>
                <Setter Property="Foreground" Value="{DynamicResource AuxInkBrush}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource AuxHairlineBrush}"/>
                <Setter Property="FontWeight" Value="Normal"/>
            </Style>
        </ResourceDictionary>
    </Window.Resources>
    <Border Background="{DynamicResource AuxSurfaceBrush}" BorderBrush="{DynamicResource AuxHairlineBrush}" BorderThickness="1">
        <Grid x:Name="DialogLayout">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid Margin="28,26,20,24">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <Border Width="46" Height="46" CornerRadius="12" Background="{DynamicResource AuxCanvasBrush}" VerticalAlignment="Center" Margin="0,0,14,0">
                    <Path Data="M12,3 L12,15 M7,10 L12,15 L17,10 M4,17 L4,21 L20,21 L20,17"
                          Width="24" Height="26" Stretch="Uniform" Stroke="{DynamicResource AuxActionTextBrush}"
                          StrokeThickness="1.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="ScheduleWidget" FontSize="12" Foreground="{DynamicResource AuxMutedBrush}" Margin="0,0,0,5"/>
                    <TextBlock Text="새 업데이트가 있어요" FontSize="24" FontWeight="SemiBold" TextWrapping="Wrap"/>
                </StackPanel>
                <Button Grid.Column="2" Width="30" Height="30" MinHeight="30" Padding="0" Margin="8,-8,0,0" VerticalAlignment="Top"
                        Style="{StaticResource UpdateQuietButton}" Background="Transparent" BorderThickness="0"
                        Click="Later_Click" ToolTip="닫기" AutomationProperties.Name="업데이트 창 닫기">
                    <Path Data="M1,1 L11,11 M11,1 L1,11" Width="12" Height="12" Stroke="{DynamicResource AuxMutedBrush}"
                          StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                </Button>
            </Grid>

            <Border Grid.Row="1" Background="{DynamicResource AuxCanvasBrush}" CornerRadius="10" Padding="18,14" Margin="28,0,28,0">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="현재 버전" FontSize="11" Foreground="{DynamicResource AuxMutedBrush}"/>
                        <TextBlock x:Name="CurrentVersion" FontSize="14" Margin="0,6,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                    <Path Grid.Column="1" Data="M1,6 L15,6 M10,1 L15,6 L10,11" Width="16" Height="12" Margin="16,0,20,0"
                          Stroke="{DynamicResource AuxMutedBrush}" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" VerticalAlignment="Center"/>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="새 버전" FontSize="11" Foreground="{DynamicResource AuxMutedBrush}"/>
                        <TextBlock x:Name="NewVersion" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource AuxActionTextBrush}"
                                   Margin="0,6,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Row="2" Margin="28,24,22,20">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <TextBlock Text="달라진 점" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,12"/>
                <ScrollViewer x:Name="NotesScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                              PanningMode="VerticalOnly" Focusable="True" AutomationProperties.Name="업데이트 변경 내용">
                    <StackPanel x:Name="NotesContent" Margin="0,0,10,0"/>
                </ScrollViewer>
            </Grid>

            <Border x:Name="ActionFooter" Grid.Row="3" Background="{DynamicResource AuxCanvasBrush}" BorderBrush="{DynamicResource AuxHairlineBrush}"
                    BorderThickness="0,1,0,0" Padding="28,18,28,22">
                <StackPanel>
                    <TextBlock Text="일정과 설정은 그대로 유지됩니다." FontSize="12" TextWrapping="Wrap"/>
                    <TextBlock Text="설치가 끝나면 앱이 다시 시작됩니다." FontSize="12" Foreground="{DynamicResource AuxMutedBrush}"
                               TextWrapping="Wrap" Margin="0,5,0,0"/>
                    <Grid Margin="0,18,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Button x:Name="LaterButton" Content="나중에" Style="{StaticResource UpdateQuietButton}" IsCancel="True"
                                Margin="0,0,10,0" Click="Later_Click" AutomationProperties.Name="업데이트 나중에 설치"/>
                        <Button x:Name="InstallButton" Grid.Column="1" Content="업데이트 설치" Style="{StaticResource UpdateActionButton}"
                                IsDefault="True" Click="Install_Click" AutomationProperties.Name="업데이트 다운로드 및 설치"/>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
