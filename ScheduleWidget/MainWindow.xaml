<Window x:Class="ScheduleWidget.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:ScheduleWidget"
        Title="일정 목록"
        Height="500" Width="360" MinWidth="300" MinHeight="380"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="False" PreviewKeyDown="MainWindow_PreviewKeyDown"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">

    <Window.Resources>
        <Style x:Key="WidgetDateComboBox"
               TargetType="{x:Type ComboBox}"
               BasedOn="{StaticResource WidgetComboBox}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
        </Style>
        <!-- One menu for every card instead of one per card. The card that opened it is its PlacementTarget, whose item
             the handlers act on (GetScheduleItemFromContextMenu). -->
        <ContextMenu x:Key="TodoCardMenu" DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
            <MenuItem Header="수정" Click="EditSchedule_Click"/>
            <MenuItem Header="완료 / 미완료" Click="CompleteSchedule_Click"/>
            <MenuItem Header="카드 색상 선택" Click="ScheduleColor_Click"/>
            <MenuItem Header="기본 색상으로" Click="ResetScheduleColor_Click"/>
            <MenuItem Header="이 일정 보내기" Click="ShareSchedule_Click"/>
            <MenuItem Header="삭제" Click="RemoveSchedule_Click"/>
            <Separator/>
            <MenuItem Header="종료" Click="ExitApplication_Click"/>
        </ContextMenu>
    </Window.Resources>

    <!-- No drop shadow: the border fills the window (clipped), so a shadow only cost a blur pass on every repaint. -->
    <Border x:Name="MainBorder"
            CornerRadius="20"
            ClipToBounds="True"
            Background="{DynamicResource BackgroundBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1"
            Padding="1">

        <Grid x:Name="WidgetContent"
              ClipToBounds="True"
              SizeChanged="WidgetContent_SizeChanged">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="60"/>
                    <RowDefinition Height="36"/>
                    <RowDefinition Height="*"/>
                    <!-- Auto (at least 144, set on the add form): taller only while 여러 날 shows its 종료 날짜 row. -->
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- compact header -->
                <Border Grid.Row="0"
                        Background="{DynamicResource TopBarBrush}"
                        CornerRadius="19,0,0,0"
                        Padding="16,0"
                        MouseLeftButtonDown="TopBar_MouseLeftButtonDown">
                    <Grid VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="32"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="32"/>
                            <ColumnDefinition Width="32"/>
                            <ColumnDefinition Width="32"/>
                            <ColumnDefinition Width="32"/>
                            <ColumnDefinition Width="32"/>
                        </Grid.ColumnDefinitions>

                        <Border Width="30" Height="30"
                                CornerRadius="15"
                                Background="{DynamicResource AccentBrush}"
                                VerticalAlignment="Center">
                            <Path Data="M2,3 H14 V14 H2 Z M5,1 V5 M11,1 V5 M2,6 H14"
                                  Width="16"
                                  Height="16"
                                  Stretch="Fill"
                                  Stroke="{DynamicResource AccentForegroundBrush}"
                                  StrokeThickness="1.35"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  StrokeLineJoin="Round"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Grid.Column="1"
                                   Text="일정"
                                   Foreground="{DynamicResource TextBrush}"
                                   FontSize="17"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center"
                                   Margin="10,0,0,0"/>
                        <ToggleButton x:Name="ModeToggle"
                                      Grid.Column="2"
                                      Style="{StaticResource WidgetModeButton}"
                                      ToolTip="이동/크기 조절"
                                      AutomationProperties.Name="이동/크기 조절"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"
                                      Checked="ModeToggle_Checked"
                                      Unchecked="ModeToggle_Unchecked">
                            <ToggleButton.Content>
                                <Path Data="M10,0 L14,4 L11,4 L11,9 L16,9 L16,6 L20,10 L16,14 L16,11 L11,11 L11,16 L14,16 L10,20 L6,16 L9,16 L9,11 L4,11 L4,14 L0,10 L4,6 L4,9 L9,9 L9,4 L6,4 Z"
                                      Width="16"
                                      Height="16"
                                      Stretch="Fill"
                                      Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type ToggleButton}}}"/>
                            </ToggleButton.Content>
                        </ToggleButton>
                        <Button x:Name="MonitorButton"
                                Grid.Column="3"
                                Style="{StaticResource WidgetIconButton}"
                                Width="32"
                                Height="32"
                                ToolTip="모니터 선택"
                                AutomationProperties.Name="모니터 선택"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Click="MonitorButton_Click">
                            <Path Data="M2,3 H18 V14 H2 Z M6,18 H14 M10,14 V18"
                                  Width="17"
                                  Height="17"
                                  Stretch="Fill"
                                  Stroke="{DynamicResource SubTextBrush}"
                                  StrokeThickness="1.5"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  StrokeLineJoin="Round"/>
                        </Button>
                        <Button x:Name="OpenSettingsButton" Grid.Column="4"
                                Style="{StaticResource WidgetIconButton}"
                                Width="32"
                                Height="32"
                                ToolTip="설정"
                                AutomationProperties.Name="설정"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Click="SettingsButton_Click">
                            <Grid Width="17" Height="17">
                                <Rectangle Width="3.5"
                                           Height="17"
                                           Fill="{DynamicResource SubTextBrush}"
                                           RadiusX="1.5"
                                           RadiusY="1.5"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                                <Rectangle Width="3.5"
                                           Height="17"
                                           Fill="{DynamicResource SubTextBrush}"
                                           RadiusX="1.5"
                                           RadiusY="1.5"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           RenderTransformOrigin="0.5,0.5">
                                    <Rectangle.RenderTransform>
                                        <RotateTransform Angle="45"/>
                                    </Rectangle.RenderTransform>
                                </Rectangle>
                                <Rectangle Width="3.5"
                                           Height="17"
                                           Fill="{DynamicResource SubTextBrush}"
                                           RadiusX="1.5"
                                           RadiusY="1.5"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           RenderTransformOrigin="0.5,0.5">
                                    <Rectangle.RenderTransform>
                                        <RotateTransform Angle="90"/>
                                    </Rectangle.RenderTransform>
                                </Rectangle>
                                <Rectangle Width="3.5"
                                           Height="17"
                                           Fill="{DynamicResource SubTextBrush}"
                                           RadiusX="1.5"
                                           RadiusY="1.5"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           RenderTransformOrigin="0.5,0.5">
                                    <Rectangle.RenderTransform>
                                        <RotateTransform Angle="135"/>
                                    </Rectangle.RenderTransform>
                                </Rectangle>
                                <Ellipse Width="7"
                                         Height="7"
                                         Fill="{DynamicResource TopBarBrush}"
                                         Stroke="{DynamicResource SubTextBrush}"
                                         StrokeThickness="2"
                                         HorizontalAlignment="Center"
                                         VerticalAlignment="Center"/>
                            </Grid>
                        </Button>
                        <!-- 👤: show / hide the pets beside this window (same pets and clicks as the mini window). -->
                        <Button x:Name="MainPetsButton" Grid.Column="5"
                                Style="{StaticResource WidgetIconButton}"
                                Width="32"
                                Height="32"
                                ToolTip="캐릭터 켜기 / 끄기"
                                AutomationProperties.Name="캐릭터 켜기 / 끄기"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Click="MainPetsButton_Click">
                            <TextBlock Text="👤" FontFamily="Segoe UI Emoji" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Button>
                        <Button x:Name="CloseScheduleListButton" Grid.Column="6"
                                Style="{StaticResource WidgetIconButton}"
                                Width="32"
                                Height="32"
                                ToolTip="일정 목록 닫기"
                                AutomationProperties.Name="일정 목록 닫기"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Click="CloseScheduleList_Click">
                            <Path Data="M4,4 L14,14 M14,4 L4,14"
                                  Width="14"
                                  Height="14"
                                  Stretch="Fill"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
                                  StrokeThickness="1.8"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"/>
                        </Button>
                    </Grid>
                </Border>

                <!-- schedule list -->

                <Border Grid.Row="2"
                        Background="{DynamicResource BackgroundBrush}"
                        Padding="13,13,13,3">
                    <!-- Virtualized: only the cards in view are built (a Google import can bring hundreds), scrolled by pixels. -->
                    <ItemsControl x:Name="ScheduleList" BorderThickness="0"
                                  VirtualizingPanel.IsVirtualizing="True"
                                  VirtualizingPanel.ScrollUnit="Pixel"
                                  ScrollViewer.CanContentScroll="True">
                        <ItemsControl.Template>
                            <ControlTemplate TargetType="{x:Type ItemsControl}">
                                <ScrollViewer x:Name="ScheduleScroll"
                                              VerticalScrollBarVisibility="Hidden"
                                              HorizontalScrollBarVisibility="Disabled"
                                              CanContentScroll="True"
                                              PanningMode="VerticalOnly">
                                    <ItemsPresenter/>
                                </ScrollViewer>
                            </ControlTemplate>
                        </ItemsControl.Template>
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <VirtualizingStackPanel/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource TodoCard}"
                                        CornerRadius="13"
                                        Margin="0,0,0,8"
                                        BorderBrush="{DynamicResource CardBorderBrush}"
                                        BorderThickness="1"
                                        ClipToBounds="True"
                                        SnapsToDevicePixels="True"
                                        ContextMenu="{StaticResource TodoCardMenu}">

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0"
                                                    VerticalAlignment="Center"
                                                    Margin="14,11,8,11">
                                            <TextBlock Text="{Binding Title}"
                                                       Style="{StaticResource TodoTitle}"
                                                       FontSize="{DynamicResource TitleFontSize}"
                                                       FontWeight="SemiBold"
                                                       TextWrapping="Wrap"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding DateString}"
                                                       Style="{StaticResource TodoDate}"
                                                       FontSize="10"
                                                       Margin="0,5,0,0"/>
                                        </StackPanel>

                                        <Border Grid.Column="1"
                                                Background="{DynamicResource ControlHoverBrush}"
                                                CornerRadius="9"
                                                Padding="8,5"
                                                MinWidth="52"
                                                Margin="0,10,10,10"
                                                VerticalAlignment="Center">
                                            <TextBlock Text="{Binding DDay}"
                                                       Style="{StaticResource TodoStatus}"
                                                       FontSize="{DynamicResource DDayFontSize}"
                                                       FontWeight="Bold"
                                                       HorizontalAlignment="Center"
                                                       TextAlignment="Center"/>
                                        </Border>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Border>

                <!-- add schedule -->
                <Border Grid.Row="3"
                        MinHeight="144"
                        Background="{DynamicResource BottomBarBrush}"
                        CornerRadius="0,0,0,19"
                        Padding="13,11,13,12"
                        BorderBrush="{DynamicResource CardBorderBrush}"
                        BorderThickness="0,1,0,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="34"/>
                            <RowDefinition Height="42"/>
                            <RowDefinition Height="42"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBox x:Name="TitleInput"
                                 Grid.Row="0"
                                 Height="34"
                                 Style="{StaticResource WidgetTextBox}"
                                 FontSize="12"
                                 ToolTip="일정 제목"
                                 KeyDown="TitleInput_KeyDown"/>

                        <Grid Grid.Row="1"
                              Margin="0,6,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0"
                                Background="{DynamicResource CardBrush}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="11"
                                HorizontalAlignment="Stretch"
                                Padding="5,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="29"/>
                                    <ColumnDefinition Width="42"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="24"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="24"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Grid Grid.Column="0"
                                      Width="28"
                                      Height="28"
                                      HorizontalAlignment="Left"
                                      VerticalAlignment="Center">
                                    <Border Background="Transparent"
                                            CornerRadius="8">
                                        <Path Data="M2,3 H14 V14 H2 Z M5,1 V5 M11,1 V5 M2,6 H14"
                                              Width="15"
                                              Height="15"
                                              Stretch="Fill"
                                              Stroke="{DynamicResource AccentBrush}"
                                              StrokeThickness="1.3"
                                              StrokeStartLineCap="Round"
                                              StrokeEndLineCap="Round"
                                              StrokeLineJoin="Round"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                                    </Border>
                                    <!-- SafeDatePicker: a DatePicker that screen readers / UI Automation can't crash. -->
                                    <local:SafeDatePicker x:Name="CalendarPicker"
                                                Width="28"
                                                Height="28"
                                                Opacity="0"
                                                ToolTip="달력에서 날짜 선택"
                                                SelectedDateChanged="CalendarPicker_SelectedDateChanged"
                                                BorderThickness="0"
                                                Background="Transparent"
                                                FocusVisualStyle="{x:Null}"
                                                Focusable="False"
                                                IsTabStop="False"
                                                VerticalAlignment="Center">
                                        <local:SafeDatePicker.Resources>
                                            <Style TargetType="DatePickerTextBox">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </Style>
                                            <Style x:Key="WidgetCalendarDayButton" TargetType="{x:Type CalendarDayButton}">
                                                <Setter Property="Background" Value="Transparent"/>
                                                <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                                                <Setter Property="BorderBrush" Value="Transparent"/>
                                                <Setter Property="BorderThickness" Value="0"/>
                                                <Setter Property="Width" Value="24"/>
                                                <Setter Property="Height" Value="24"/>
                                                <Setter Property="Margin" Value="1"/>
                                                <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                                <Setter Property="VerticalContentAlignment" Value="Center"/>
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="{x:Type CalendarDayButton}">
                                                            <Border x:Name="DayBorder"
                                                                    Background="{TemplateBinding Background}"
                                                                    BorderBrush="{TemplateBinding BorderBrush}"
                                                                    BorderThickness="{TemplateBinding BorderThickness}"
                                                                    CornerRadius="7">
                                                                <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                                                                  Content="{TemplateBinding Content}"
                                                                                  ContentTemplate="{TemplateBinding ContentTemplate}"
                                                                                  TextElement.Foreground="{TemplateBinding Foreground}"/>
                                                            </Border>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter TargetName="DayBorder" Property="Background" Value="{DynamicResource ControlHoverBrush}"/>
                                                                </Trigger>
                                                                <Trigger Property="IsToday" Value="True">
                                                                    <Setter TargetName="DayBorder" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                                                    <Setter TargetName="DayBorder" Property="BorderThickness" Value="1"/>
                                                                </Trigger>
                                                                <Trigger Property="IsSelected" Value="True">
                                                                    <Setter TargetName="DayBorder" Property="Background" Value="{DynamicResource AccentBrush}"/>
                                                                    <Setter TargetName="DayBorder" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                                                    <Setter TargetName="DayBorder" Property="BorderThickness" Value="1"/>
                                                                    <Setter Property="Foreground" Value="{DynamicResource AccentForegroundBrush}"/>
                                                                </Trigger>
                                                                <Trigger Property="IsInactive" Value="True">
                                                                    <Setter Property="Opacity" Value="0.45"/>
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                            </Style>
                                            <Style x:Key="WidgetCalendarButton" TargetType="{x:Type CalendarButton}">
                                                <Setter Property="Background" Value="Transparent"/>
                                                <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                                                <Setter Property="BorderThickness" Value="0"/>
                                                <Setter Property="Padding" Value="4,2"/>
                                                <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                                <Setter Property="VerticalContentAlignment" Value="Center"/>
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="{x:Type CalendarButton}">
                                                            <Border x:Name="CalendarButtonBorder"
                                                                    Background="{TemplateBinding Background}"
                                                                    CornerRadius="7"
                                                                    Padding="{TemplateBinding Padding}">
                                                                <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                                                                  Content="{TemplateBinding Content}"
                                                                                  ContentTemplate="{TemplateBinding ContentTemplate}"
                                                                                  TextElement.Foreground="{TemplateBinding Foreground}"/>
                                                            </Border>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter TargetName="CalendarButtonBorder" Property="Background" Value="{DynamicResource ControlHoverBrush}"/>
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                            </Style>
                                            <Style TargetType="{x:Type Calendar}">
                                                <Setter Property="Background" Value="{DynamicResource CardBrush}"/>
                                                <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                                                <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}"/>
                                                <Setter Property="BorderThickness" Value="0"/>
                                                <Setter Property="Padding" Value="7"/>
                                                <Setter Property="FontSize" Value="11"/>
                                                <Setter Property="CalendarDayButtonStyle" Value="{StaticResource WidgetCalendarDayButton}"/>
                                                <Setter Property="CalendarButtonStyle" Value="{StaticResource WidgetCalendarButton}"/>
                                            </Style>
                                        </local:SafeDatePicker.Resources>
                                    </local:SafeDatePicker>
                                </Grid>

                                <ComboBox x:Name="YearCombo"
                                          Grid.Column="1"
                                          Tag="HideArrow"
                                          Height="30"
                                          Style="{StaticResource WidgetDateComboBox}"
                                          IsEditable="True"/>
                                <TextBlock Grid.Column="2"
                                           Text="년"
                                           Foreground="{DynamicResource SubTextBrush}"
                                           FontSize="10"
                                           VerticalAlignment="Center"
                                           Margin="1,0,3,0"/>
                                <ComboBox x:Name="MonthCombo"
                                          Grid.Column="3"
                                          Tag="HideArrow"
                                          Height="30"
                                          Style="{StaticResource WidgetDateComboBox}"/>
                                <TextBlock Grid.Column="4"
                                           Text="월"
                                           Foreground="{DynamicResource SubTextBrush}"
                                           FontSize="10"
                                           VerticalAlignment="Center"
                                           Margin="1,0,3,0"/>
                                <ComboBox x:Name="DayCombo"
                                          Grid.Column="5"
                                          Tag="HideArrow"
                                          Height="30"
                                          Style="{StaticResource WidgetDateComboBox}"/>
                                <TextBlock Grid.Column="6"
                                           Text="일"
                                           Foreground="{DynamicResource SubTextBrush}"
                                           FontSize="10"
                                           VerticalAlignment="Center"
                                           Margin="1,0,0,0"/>
                            </Grid>
                            </Border>

                            <Button x:Name="AddButton"
                                    Grid.Column="1"
                                    Content="추가"
                                    Width="58"
                                    Height="36"
                                    Margin="8,0,0,0"
                                    Style="{StaticResource WidgetPrimaryButton}"
                                     Click="AddButton_Click"/>
                        </Grid>
                        <Grid Grid.Row="2" Margin="0,6,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <CheckBox x:Name="AddTimeToggle"
                                          Content="시간 지정"
                                          Foreground="{DynamicResource TextBrush}"
                                          VerticalAlignment="Center"
                                          Checked="AddTimeToggle_Changed"
                                          Unchecked="AddTimeToggle_Changed"/>
                                <!-- 여러 날: shows the 종료 날짜 row below (10/8 ~ 10/10). -->
                                <CheckBox x:Name="AddRangeToggle"
                                          Content="여러 날"
                                          Margin="12,0,0,0"
                                          Foreground="{DynamicResource TextBrush}"
                                          VerticalAlignment="Center"
                                          ToolTip="여러 날 이어지는 일정 (종료 날짜 선택)"
                                          Checked="AddRangeToggle_Changed"
                                          Unchecked="AddRangeToggle_Changed"/>
                            </StackPanel>
                            <TextBox x:Name="AddTimeInput"
                                     Grid.Column="1"
                                     Text="09:00"
                                     Width="76"
                                     Height="32"
                                     MaxLength="5"
                                     IsEnabled="False"
                                     Style="{StaticResource WidgetTextBox}"
                                     HorizontalContentAlignment="Center"
                                     ToolTip="HH:mm"/>
                        </Grid>
                        <!-- 종료 날짜 (여러 날 only): the calendar button picks the range's last day. -->
                        <Border x:Name="AddEndRow"
                                Grid.Row="3"
                                Visibility="Collapsed"
                                Margin="0,6,0,0"
                                Height="34"
                                Background="{DynamicResource CardBrush}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="11"
                                Padding="5,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="29"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid Width="28" Height="28" HorizontalAlignment="Left" VerticalAlignment="Center">
                                    <Path Data="M2,3 H14 V14 H2 Z M5,1 V5 M11,1 V5 M2,6 H14"
                                          Width="15" Height="15" Stretch="Fill"
                                          Stroke="{DynamicResource AccentBrush}" StrokeThickness="1.3"
                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                          HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    <!-- Same look as CalendarPicker (its resources are shared in code). -->
                                    <local:SafeDatePicker x:Name="AddEndPicker"
                                                          Width="28" Height="28" Opacity="0"
                                                          ToolTip="달력에서 종료 날짜 선택"
                                                          AutomationProperties.Name="종료 날짜"
                                                          SelectedDateChanged="AddEndPicker_SelectedDateChanged"
                                                          BorderThickness="0" Background="Transparent"
                                                          FocusVisualStyle="{x:Null}" Focusable="False" IsTabStop="False"
                                                          VerticalAlignment="Center"/>
                                </Grid>
                                <TextBlock Grid.Column="1" Text="종료 날짜" Foreground="{DynamicResource SubTextBrush}"
                                           FontSize="10" VerticalAlignment="Center" Margin="1,0,8,0"/>
                                <TextBlock x:Name="AddEndText" Grid.Column="2" Foreground="{DynamicResource TextBrush}"
                                           FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                            </Grid>
                        </Border>
                    </Grid>
                </Border>
            </Grid>

            <!-- settings are shown in-place so the widget never loses context -->
            <Border x:Name="InlineSettingsPanel"
                    Background="{DynamicResource AuxCanvasBrush}"
                    BorderBrush="{DynamicResource AuxHairlineBrush}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="14,12,12,12"
                    Panel.ZIndex="10"
                    Visibility="Collapsed">
                <Border.Resources>
                    <ResourceDictionary>
                        <ResourceDictionary.MergedDictionaries>
                            <ResourceDictionary Source="/ScheduleWidget;component/Styles/AuxiliaryStyles.xaml"/>
                        </ResourceDictionary.MergedDictionaries>
                    </ResourceDictionary>
                </Border.Resources>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="38"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="40"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
