<Window x:Class="ScheduleWidget.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:ScheduleWidget"
        Height="500" Width="360"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="False"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">

    <Window.Resources>
        <Style x:Key="WidgetDateComboBox"
               TargetType="{x:Type ComboBox}"
               BasedOn="{StaticResource WidgetComboBox}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
        </Style>
    </Window.Resources>

    <Border x:Name="MainBorder"
            CornerRadius="20"
            ClipToBounds="True"
            Background="{DynamicResource BackgroundBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1"
            Padding="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="5" Opacity="0.2"/>
        </Border.Effect>

        <Grid x:Name="WidgetContent"
              ClipToBounds="True"
              SizeChanged="WidgetContent_SizeChanged">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="60"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="114"/>
                </Grid.RowDefinitions>

                <!-- compact header -->
                <Border Grid.Row="0"
                        Background="{DynamicResource TopBarBrush}"
                        CornerRadius="19,0,0,0"
                        Padding="16,0"
                        MouseLeftButtonDown="TopBar_MouseLeftButtonDown">
                    <Grid VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="32"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="32"/>
                            <ColumnDefinition Width="32"/>
                            <ColumnDefinition Width="32"/>
                        </Grid.ColumnDefinitions>

                        <Border Width="30" Height="30"
                                CornerRadius="15"
                                Background="{DynamicResource AccentBrush}"
                                VerticalAlignment="Center">
                            <Path Data="M2,3 H14 V14 H2 Z M5,1 V5 M11,1 V5 M2,6 H14"
                                  Width="16"
                                  Height="16"
                                  Stretch="Fill"
                                  Stroke="{DynamicResource AccentForegroundBrush}"
                                  StrokeThickness="1.35"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  StrokeLineJoin="Round"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Grid.Column="1"
                                   Text="일정"
                                   Foreground="{DynamicResource TextBrush}"
                                   FontSize="17"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center"
                                   Margin="10,0,0,0"/>
                        <ToggleButton x:Name="ModeToggle"
                                      Grid.Column="2"
                                      Style="{StaticResource WidgetModeButton}"
                                      ToolTip="이동/크기 조절"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"
                                      Checked="ModeToggle_Checked"
                                      Unchecked="ModeToggle_Unchecked">
                            <ToggleButton.Content>
                                <Path Data="M10,0 L14,4 L11,4 L11,9 L16,9 L16,6 L20,10 L16,14 L16,11 L11,11 L11,16 L14,16 L10,20 L6,16 L9,16 L9,11 L4,11 L4,14 L0,10 L4,6 L4,9 L9,9 L9,4 L6,4 Z"
                                      Width="16"
                                      Height="16"
                                      Stretch="Fill"
                                      Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type ToggleButton}}}"/>
                            </ToggleButton.Content>
                        </ToggleButton>
                        <Button Grid.Column="3"
                                Style="{StaticResource WidgetIconButton}"
                                Width="32"
                                Height="32"
                                ToolTip="설정"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Click="SettingsButton_Click"
                                Visibility="Collapsed">
                            <Path Data="M19.43,12.98C19.47,12.66 19.5,12.33 19.43,11.02L21.54,9.37C21.73,9.22 21.78,8.95 21.66,8.73L19.66,5.27C19.54,5.05 19.27,4.96 19.05,5.05L16.56,6.05C16.04,5.66 15.5,5.32 14.87,5.07L14.5,2.42C14.46,2.18 14.25,2 14,2H10C9.75,2 9.54,2.18 9.5,2.42L9.13,5.07C8.5,5.32 7.96,5.66 7.44,6.05L4.95,5.05C4.73,4.97 4.46,5.05 4.34,5.27L2.34,8.73C2.21,8.95 2.27,9.22 2.46,9.37L4.57,11.02C4.53,11.34 4.5,11.67 4.57,12.98L2.46,14.63C2.27,14.78 2.22,15.05 2.34,15.27L4.34,18.73C4.46,18.95 4.73,19.04 4.95,18.95L7.44,17.95C7.96,18.34 8.5,18.68 9.13,18.93L9.5,21.58C9.54,21.82 9.75,21.82 9.5,21.58L14.87,18.93C15.5,18.68 16.04,18.34 16.56,17.95L19.05,18.95C19.27,19.03 19.54,18.95 19.66,18.73L21.66,15.27C21.78,15.05 21.73,14.78 21.54,14.63L19.43,12.98ZM12,15.5C10.07,15.5 8.5,13.93 8.5,12C8.5,10.07 10.07,8.5 12,8.5C13.93,8.5 15.5,10.07 15.5,15.5Z"
                                  Width="16"
                                  Height="16"
                                  Stretch="Fill"
                                  Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"/>
                        </Button>
                        <Button x:Name="MonitorButton"
                                Grid.Column="3"
                                Style="{StaticResource WidgetIconButton}"
                                Width="32"
                                Height="32"
                                ToolTip="모니터 선택"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Click="MonitorButton_Click">
                            <Path Data="M2,3 H18 V14 H2 Z M6,18 H14 M10,14 V18"
                                  Width="17"
                                  Height="17"
                                  Stretch="Fill"
                                  Stroke="{DynamicResource SubTextBrush}"
                                  StrokeThickness="1.5"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  StrokeLineJoin="Round"/>
                        </Button>
                        <Button Grid.Column="4"
                                Style="{StaticResource WidgetIconButton}"
                                Width="32"
                                Height="32"
                                ToolTip="설정"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Click="SettingsButton_Click">
                            <Grid Width="17" Height="17">
                                <Rectangle Width="3.5"
                                           Height="17"
                                           Fill="{DynamicResource SubTextBrush}"
                                           RadiusX="1.5"
                                           RadiusY="1.5"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                                <Rectangle Width="3.5"
                                           Height="17"
                                           Fill="{DynamicResource SubTextBrush}"
                                           RadiusX="1.5"
                                           RadiusY="1.5"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           RenderTransformOrigin="0.5,0.5">
                                    <Rectangle.RenderTransform>
                                        <RotateTransform Angle="45"/>
                                    </Rectangle.RenderTransform>
                                </Rectangle>
                                <Rectangle Width="3.5"
                                           Height="17"
                                           Fill="{DynamicResource SubTextBrush}"
                                           RadiusX="1.5"
                                           RadiusY="1.5"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           RenderTransformOrigin="0.5,0.5">
                                    <Rectangle.RenderTransform>
                                        <RotateTransform Angle="90"/>
                                    </Rectangle.RenderTransform>
                                </Rectangle>
                                <Rectangle Width="3.5"
                                           Height="17"
                                           Fill="{DynamicResource SubTextBrush}"
                                           RadiusX="1.5"
                                           RadiusY="1.5"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           RenderTransformOrigin="0.5,0.5">
                                    <Rectangle.RenderTransform>
                                        <RotateTransform Angle="135"/>
                                    </Rectangle.RenderTransform>
                                </Rectangle>
                                <Ellipse Width="7"
                                         Height="7"
                                         Fill="{DynamicResource TopBarBrush}"
                                         Stroke="{DynamicResource SubTextBrush}"
                                         StrokeThickness="2"
                                         HorizontalAlignment="Center"
                                         VerticalAlignment="Center"/>
                            </Grid>
                        </Button>
                    </Grid>
                </Border>

                <!-- schedule list -->
                <Border Grid.Row="1"
                        Background="{DynamicResource BackgroundBrush}"
                        Padding="13,13,13,3">
                    <ScrollViewer VerticalScrollBarVisibility="Hidden"
                                  HorizontalScrollBarVisibility="Disabled"
                                  CanContentScroll="True"
                                  PanningMode="VerticalOnly">
                        <ItemsControl x:Name="ScheduleList" BorderThickness="0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{DynamicResource CardBrush}"
                                            CornerRadius="13"
                                            Margin="0,0,0,8"
                                            BorderBrush="{DynamicResource CardBorderBrush}"
                                            BorderThickness="1"
                                            ClipToBounds="True"
                                            SnapsToDevicePixels="True">
                                        <Border.ContextMenu>
                                            <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                                <MenuItem Header="수정" Click="EditSchedule_Click"/>
                                                <MenuItem Header="제거" Click="RemoveSchedule_Click"/>
                                            </ContextMenu>
                                        </Border.ContextMenu>

                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="4"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <Border Grid.Column="0"
                                                    Background="{DynamicResource AccentBrush}"
                                                    CornerRadius="12,0,0,12"
                                                    Margin="0,1,0,1"/>

                                            <StackPanel Grid.Column="1"
                                                        VerticalAlignment="Center"
                                                        Margin="12,11,8,11">
                                                <TextBlock Text="{Binding Title}"
                                                           Foreground="{DynamicResource TextBrush}"
                                                           FontSize="{DynamicResource TitleFontSize}"
                                                           FontWeight="SemiBold"
                                                           TextWrapping="Wrap"
                                                           TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding DateString}"
                                                           Foreground="{DynamicResource SubTextBrush}"
                                                           FontSize="10"
                                                           Margin="0,5,0,0"/>
                                            </StackPanel>

                                            <Border Grid.Column="2"
                                                    Background="{DynamicResource ControlHoverBrush}"
                                                    CornerRadius="9"
                                                    Padding="8,5"
                                                    MinWidth="52"
                                                    Margin="0,10,10,10"
                                                    VerticalAlignment="Center">
                                                <TextBlock Text="{Binding DDay}"
                                                           FontSize="{DynamicResource DDayFontSize}"
                                                           FontWeight="Bold"
                                                           HorizontalAlignment="Center"
                                                           TextAlignment="Center">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Status}" Value="Today">
                                                                    <Setter Property="Foreground" Value="#FF3B82F6"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Status}" Value="Past">
                                                                    <Setter Property="Foreground" Value="#FFEF4444"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Border>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Border>

                <!-- add schedule -->
                <Border Grid.Row="2"
                        Background="{DynamicResource BottomBarBrush}"
                        CornerRadius="0,0,0,19"
                        Padding="13,11,13,12"
                        BorderBrush="{DynamicResource CardBorderBrush}"
                        BorderThickness="0,1,0,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="36"/>
                            <RowDefinition Height="44"/>
                        </Grid.RowDefinitions>

                        <TextBox x:Name="TitleInput"
                                 Grid.Row="0"
                                 Height="36"
                                 Style="{StaticResource WidgetTextBox}"
                                 FontSize="12"
                                 ToolTip="일정 제목"
                                 KeyDown="TitleInput_KeyDown"/>

                        <Grid Grid.Row="1"
                              Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0"
                                Background="{DynamicResource CardBrush}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="11"
                                HorizontalAlignment="Stretch"
                                Padding="5,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="29"/>
                                    <ColumnDefinition Width="42"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="24"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="24"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Grid Grid.Column="0"
                                      Width="28"
                                      Height="28"
                                      HorizontalAlignment="Left"
                                      VerticalAlignment="Center">
                                    <Border Background="Transparent"
                                            CornerRadius="8">
                                        <Path Data="M2,3 H14 V14 H2 Z M5,1 V5 M11,1 V5 M2,6 H14"
                                              Width="15"
                                              Height="15"
                                              Stretch="Fill"
                                              Stroke="{DynamicResource AccentBrush}"
                                              StrokeThickness="1.3"
                                              StrokeStartLineCap="Round"
                                              StrokeEndLineCap="Round"
                                              StrokeLineJoin="Round"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                                    </Border>
                                    <DatePicker x:Name="CalendarPicker"
                                                Width="28"
                                                Height="28"
                                                Opacity="0"
                                                ToolTip="달력에서 날짜 선택"
                                                SelectedDateChanged="CalendarPicker_SelectedDateChanged"
                                                BorderThickness="0"
                                                Background="Transparent"
                                                FocusVisualStyle="{x:Null}"
                                                Focusable="False"
                                                IsTabStop="False"
                                                VerticalAlignment="Center">
                                        <DatePicker.Resources>
                                            <Style TargetType="DatePickerTextBox">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </Style>
                                            <Style x:Key="WidgetCalendarDayButton" TargetType="{x:Type CalendarDayButton}">
                                                <Setter Property="Background" Value="Transparent"/>
                                                <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                                                <Setter Property="BorderBrush" Value="Transparent"/>
                                                <Setter Property="BorderThickness" Value="0"/>
                                                <Setter Property="Width" Value="24"/>
                                                <Setter Property="Height" Value="24"/>
                                                <Setter Property="Margin" Value="1"/>
                                                <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                                <Setter Property="VerticalContentAlignment" Value="Center"/>
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="{x:Type CalendarDayButton}">
                                                            <Border x:Name="DayBorder"
                                                                    Background="{TemplateBinding Background}"
                                                                    BorderBrush="{TemplateBinding BorderBrush}"
                                                                    BorderThickness="{TemplateBinding BorderThickness}"
                                                                    CornerRadius="7">
                                                                <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                                                                  Content="{TemplateBinding Content}"
                                                                                  ContentTemplate="{TemplateBinding ContentTemplate}"
                                                                                  TextElement.Foreground="{TemplateBinding Foreground}"/>
                                                            </Border>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter TargetName="DayBorder" Property="Background" Value="{DynamicResource ControlHoverBrush}"/>
                                                                </Trigger>
                                                                <Trigger Property="IsToday" Value="True">
                                                                    <Setter TargetName="DayBorder" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                                                    <Setter TargetName="DayBorder" Property="BorderThickness" Value="1"/>
                                                                </Trigger>
                                                                <Trigger Property="IsSelected" Value="True">
                                                                    <Setter TargetName="DayBorder" Property="Background" Value="{DynamicResource AccentBrush}"/>
                                                                    <Setter TargetName="DayBorder" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                                                    <Setter TargetName="DayBorder" Property="BorderThickness" Value="1"/>
                                                                    <Setter Property="Foreground" Value="{DynamicResource AccentForegroundBrush}"/>
                                                                </Trigger>
                                                                <Trigger Property="IsInactive" Value="True">
                                                                    <Setter Property="Opacity" Value="0.45"/>
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                            </Style>
                                            <Style x:Key="WidgetCalendarButton" TargetType="{x:Type CalendarButton}">
                                                <Setter Property="Background" Value="Transparent"/>
                                                <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                                                <Setter Property="BorderThickness" Value="0"/>
                                                <Setter Property="Padding" Value="4,2"/>
                                                <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                                <Setter Property="VerticalContentAlignment" Value="Center"/>
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="{x:Type CalendarButton}">
                                                            <Border x:Name="CalendarButtonBorder"
                                                                    Background="{TemplateBinding Background}"
                                                                    CornerRadius="7"
                                                                    Padding="{TemplateBinding Padding}">
                                                                <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                                                                  Content="{TemplateBinding Content}"
                                                                                  ContentTemplate="{TemplateBinding ContentTemplate}"
                                                                                  TextElement.Foreground="{TemplateBinding Foreground}"/>
                                                            </Border>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter TargetName="CalendarButtonBorder" Property="Background" Value="{DynamicResource ControlHoverBrush}"/>
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                            </Style>
                                            <Style TargetType="{x:Type Calendar}">
                                                <Setter Property="Background" Value="{DynamicResource CardBrush}"/>
                                                <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                                                <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}"/>
                                                <Setter Property="BorderThickness" Value="0"/>
                                                <Setter Property="Padding" Value="7"/>
                                                <Setter Property="FontSize" Value="11"/>
                                                <Setter Property="CalendarDayButtonStyle" Value="{StaticResource WidgetCalendarDayButton}"/>
                                                <Setter Property="CalendarButtonStyle" Value="{StaticResource WidgetCalendarButton}"/>
                                            </Style>
                                        </DatePicker.Resources>
                                    </DatePicker>
                                </Grid>

                                <ComboBox x:Name="YearCombo"
                                          Grid.Column="1"
                                          Tag="HideArrow"
                                          Height="30"
                                          Style="{StaticResource WidgetDateComboBox}"
                                          IsEditable="True"/>
                                <TextBlock Grid.Column="2"
                                           Text="년"
                                           Foreground="{DynamicResource SubTextBrush}"
                                           FontSize="10"
                                           VerticalAlignment="Center"
                                           Margin="1,0,3,0"/>
                                <ComboBox x:Name="MonthCombo"
                                          Grid.Column="3"
                                          Tag="HideArrow"
                                          Height="30"
                                          Style="{StaticResource WidgetDateComboBox}"/>
                                <TextBlock Grid.Column="4"
                                           Text="월"
                                           Foreground="{DynamicResource SubTextBrush}"
                                           FontSize="10"
                                           VerticalAlignment="Center"
                                           Margin="1,0,3,0"/>
                                <ComboBox x:Name="DayCombo"
                                          Grid.Column="5"
                                          Tag="HideArrow"
                                          Height="30"
                                          Style="{StaticResource WidgetDateComboBox}"/>
                                <TextBlock Grid.Column="6"
                                           Text="일"
                                           Foreground="{DynamicResource SubTextBrush}"
                                           FontSize="10"
                                           VerticalAlignment="Center"
                                           Margin="1,0,0,0"/>
                            </Grid>
                            </Border>

                            <Button x:Name="AddButton"
                                    Grid.Column="1"
                                    Content="추가"
                                    Width="58"
                                    Height="36"
                                    Margin="8,0,0,0"
                                    Style="{StaticResource WidgetPrimaryButton}"
                                    Click="AddButton_Click"/>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>

            <!-- thin movement/settings rail -->
            <Border Grid.Column="1"
                    Background="{DynamicResource BottomBarBrush}"
                    CornerRadius="0,19,19,0"
                    BorderBrush="{DynamicResource CardBorderBrush}"
                    BorderThickness="1,0,0,0"
                    Visibility="Collapsed">
                <Grid>
                    <Border Width="40"
                            Height="88"
                            Background="{DynamicResource CardBrush}"
                            BorderBrush="{DynamicResource CardBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="20"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Top"
                            Margin="0,12,0,0"
                            Padding="4">
                        <StackPanel HorizontalAlignment="Center"
                                    VerticalAlignment="Center">
                            <ToggleButton x:Name="LegacyModeToggle"
                                          Style="{StaticResource WidgetModeButton}"
                                          ToolTip="이동/크기 조절"
                                          Checked="ModeToggle_Checked"
                                          Unchecked="ModeToggle_Unchecked">
                                <ToggleButton.Content>
                                    <Path Data="M10,0 L14,4 L11,4 L11,9 L16,9 L16,6 L20,10 L16,14 L16,11 L11,11 L11,16 L14,16 L10,20 L6,16 L9,16 L9,11 L4,11 L4,14 L0,10 L4,6 L4,9 L9,9 L9,4 L6,4 Z"
                                          Width="16"
                                          Height="16"
                                          Stretch="Fill"
                                          Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type ToggleButton}}}"/>
                                </ToggleButton.Content>
                            </ToggleButton>
                            <Border Width="18"
                                    Height="1"
                                    Background="{DynamicResource CardBorderBrush}"
                                    Margin="0,4"/>
                            <Button Style="{StaticResource WidgetIconButton}"
                                    Width="32"
                                    Height="32"
                                    ToolTip="설정"
                                    Click="SettingsButton_Click">
                                <Path Data="M19.43,12.98C19.47,12.66 19.5,12.33 19.5,12C19.5,11.67 19.47,11.34 19.43,11.02L21.54,9.37C21.73,9.22 21.78,8.95 21.66,8.73L19.66,5.27C19.54,5.05 19.27,4.96 19.05,5.05L16.56,6.05C16.04,5.66 15.5,5.32 14.87,5.07L14.5,2.42C14.46,2.18 14.25,2 14,2H10C9.75,2 9.54,2.18 9.5,2.42L9.13,5.07C8.5,5.32 7.96,5.66 7.44,6.05L4.95,5.05C4.73,4.97 4.46,5.05 4.34,5.27L2.34,8.73C2.21,8.95 2.27,9.22 2.46,9.37L4.57,11.02C4.53,11.34 4.5,11.67 4.57,12.98L2.46,14.63C2.27,14.78 2.22,15.05 2.34,15.27L4.34,18.73C4.46,18.95 4.73,19.04 4.95,18.95L7.44,17.95C7.96,18.34 8.5,18.68 9.13,18.93L9.5,21.58C9.54,21.82 9.75,22 10,22H14C14.25,22 14.46,21.82 14.5,21.58L14.87,18.93C15.5,18.68 16.04,18.34 16.56,17.95L19.05,18.95C19.27,19.03 19.54,18.95 19.66,18.73L21.66,15.27C21.78,15.05 21.73,14.78 21.54,14.63L19.43,12.98ZM12,15.5C10.07,15.5 8.5,13.93 8.5,12C8.5,10.07 10.07,8.5 12,8.5C13.93,8.5 15.5,10.07 15.5,12C15.5,13.93 13.93,15.5 12,15.5Z"
                                      Width="16"
                                      Height="16"
                                      Stretch="Fill"
                                      Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"/>
                            </Button>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- settings are shown in-place so the widget never loses context -->
            <Border x:Name="InlineSettingsPanel"
                    Background="{DynamicResource BackgroundBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="19"
                    Padding="18,16,16,14"
                    Panel.ZIndex="10"
                    Visibility="Collapsed">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="34"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="30"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Path Data="M19.43,12.98C19.47,12.66 19.5,12.33 19.5,12C19.5,11.67 19.47,11.34 19.43,11.02L21.54,9.37C21.73,9.22 21.78,8.95 21.66,8.73L19.66,5.27C19.54,5.05 19.27,4.96 19.05,5.05L16.56,6.05C16.04,5.66 15.5,5.32 14.87,5.07L14.5,2.42C14.46,2.18 14.25,2 14,2H10C9.75,2 9.54,2.18 9.5,2.42L9.13,5.07C8.5,5.32 7.96,5.66 7.44,6.05L4.95,5.05C4.73,4.97 4.46,5.05 4.34,5.27L2.34,8.73C2.21,8.95 2.27,9.22 2.46,9.37L4.57,11.02C4.53,11.34 4.5,11.67 4.57,12.98L2.46,14.63C2.27,14.78 2.22,15.05 2.34,15.27L4.34,18.73C4.46,18.95 4.73,19.04 4.95,18.95L7.44,17.95C7.96,18.34 8.5,18.68 9.13,18.93L9.5,21.58C9.54,21.82 9.75,22 10,22H14C14.25,22 14.46,21.82 14.5,21.58L14.87,18.93C15.5,18.68 16.04,18.34 16.56,17.95L19.05,18.95C19.27,19.03 19.54,18.95 19.66,18.73L21.66,15.27C21.78,15.05 21.73,14.78 21.54,14.63L19.43,12.98ZM12,15.5C10.07,15.5 8.5,13.93 8.5,12C8.5,10.07 10.07,8.5 12,8.5C13.93,8.5 15.5,10.07 15.5,12C15.5,13.93 13.93,15.5 12,15.5Z"
                                  Width="16"
                                  Height="16"
                                  Stretch="Fill"
                                  Fill="{DynamicResource AccentBrush}"
                                  Margin="0,0,8,0"/>
                            <TextBlock Text="설정"
                                       Foreground="{DynamicResource TextBrush}"
                                       FontSize="17"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                        <Button Grid.Column="1"
                                Style="{StaticResource WidgetIconButton}"
                                Width="30"
                                Height="30"
                                ToolTip="설정 닫기"
                                Click="InlineSettingsCloseButton_Click">
                            <Path Data="M4,4 L12,12 M12,4 L4,12"
                                  Width="13"
                                  Height="13"
                                  Stretch="Fill"
                                  Stroke="{DynamicResource SubTextBrush}"
                                  StrokeThickness="1.5"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"/>
                        </Button>
                    </Grid>

                    <ScrollViewer Grid.Row="1"
                                  Margin="0,14,0,12"
                                  VerticalScrollBarVisibility="Hidden"
                                  HorizontalScrollBarVisibility="Disabled">
                        <StackPanel>
                            <Border Background="{DynamicResource CardBrush}"
                                    BorderBrush="{DynamicResource CardBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="12"
                                    Padding="12,10"
                                    Margin="0,0,0,10">
                                <StackPanel>
                                    <Grid Margin="0,0,0,7">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="투명도"
                                                   Foreground="{DynamicResource TextBrush}"
                                                   FontWeight="SemiBold"/>
                                        <TextBlock x:Name="InlineOpacityValueText"
                                                   Grid.Column="1"
                                                   Text="100%"
                                                   Foreground="{DynamicResource AccentBrush}"
                                                   FontWeight="SemiBold"/>
                                    </Grid>
                                    <Slider x:Name="InlineOpacitySlider"
                                            Minimum="30"
                                            Maximum="100"
                                            TickFrequency="5"
                                            IsSnapToTickEnabled="True"
                                            Foreground="{DynamicResource AccentBrush}"
                                            IsMoveToPointEnabled="True"
                                            local:SliderInteraction.EnableMouseDrag="True"
                                            ValueChanged="InlineOpacitySlider_ValueChanged"/>
                                </StackPanel>
                            </Border>

                            <Border Background="{DynamicResource CardBrush}"
                                    BorderBrush="{DynamicResource CardBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="12"
                                    Padding="12,10"
                                    Margin="0,0,0,10">
                                <StackPanel>
                                    <StackPanel Margin="0,0,0,8">
                                        <StackPanel>
                                            <TextBlock Text="테마"
                                                       Foreground="{DynamicResource TextBrush}"
                                                       FontWeight="SemiBold"/>
                                            <TextBlock Text="위젯의 분위기를 선택하세요."
                                                       Foreground="{DynamicResource SubTextBrush}"
                                                       FontSize="10"
                                                       Margin="0,3,0,0"/>
                                        </StackPanel>
                                    </StackPanel>
                                    <ComboBox x:Name="InlinePresetCombo"
                                              Height="48"
                                              Style="{StaticResource WidgetComboBox}"
                                              ItemTemplate="{StaticResource ThemePresetTemplate}"
                                              ItemContainerStyle="{StaticResource ThemePresetItemStyle}"
                                              MaxDropDownHeight="240"
                                              SelectionChanged="InlinePresetCombo_SelectionChanged">
                                        <ComboBoxItem Content="Light" ContentTemplate="{StaticResource ThemePresetTemplate}"/>
                                        <ComboBoxItem Content="Dark" ContentTemplate="{StaticResource ThemePresetTemplate}"/>
                                        <ComboBoxItem Content="Blue" ContentTemplate="{StaticResource ThemePresetTemplate}"/>
                                        <ComboBoxItem Content="Pink" ContentTemplate="{StaticResource ThemePresetTemplate}"/>
                                    </ComboBox>
                                </StackPanel>
                            </Border>

                            <Border Background="{DynamicResource CardBrush}"
                                    BorderBrush="{DynamicResource CardBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="12"
                                    Padding="12,10">
                                <StackPanel>
                                    <TextBlock Text="폰트 크기"
                                               Foreground="{DynamicResource TextBrush}"
                                               FontWeight="SemiBold"
                                               Margin="0,0,0,10"/>
                                    <Border Background="{DynamicResource BackgroundBrush}"
                                            BorderBrush="{DynamicResource CardBorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="10"
                                            Padding="10,8"
                                            Margin="0,0,0,10">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="청년 희망 뭐시기 알아보기"
                                                           FontSize="{Binding Value, ElementName=InlineTitleFontSizeSlider}"
                                                           FontWeight="SemiBold"
                                                           Foreground="{DynamicResource TextBrush}"
                                                           TextTrimming="CharacterEllipsis"
                                                           TextWrapping="NoWrap"/>
                                                <TextBlock Text="09.06 (일)"
                                                           FontSize="10"
                                                           Foreground="{DynamicResource SubTextBrush}"
                                                           Margin="0,3,0,0"/>
                                            </StackPanel>
                                            <Border Grid.Column="1"
                                                    Background="{DynamicResource ControlHoverBrush}"
                                                    CornerRadius="8"
                                                    Padding="8,5"
                                                    Margin="8,0,0,0"
                                                    VerticalAlignment="Center">
                                                <TextBlock Text="D-12"
                                                           FontSize="{Binding Value, ElementName=InlineDDayFontSizeSlider}"
                                                           FontWeight="Bold"
                                                           Foreground="{DynamicResource AccentBrush}"
                                                           HorizontalAlignment="Center"/>
                                            </Border>
                                        </Grid>
                                    </Border>
                                    <Grid Margin="0,0,0,9">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="52"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="28"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="제목"
                                                   Foreground="{DynamicResource SubTextBrush}"
                                                   VerticalAlignment="Center"/>
                                        <Slider x:Name="InlineTitleFontSizeSlider"
                                                Grid.Column="1"
                                                Minimum="10"
                                                Maximum="24"
                                                TickFrequency="1"
                                                IsSnapToTickEnabled="True"
                                                Foreground="{DynamicResource AccentBrush}"
                                                VerticalAlignment="Center"
                                                IsMoveToPointEnabled="True"
                                                local:SliderInteraction.EnableMouseDrag="True"
                                                ValueChanged="InlineFontSizeSlider_ValueChanged"/>
                                        <TextBlock x:Name="InlineTitleFontSizeText"
                                                   Grid.Column="2"
                                                   TextAlignment="Right"
                                                   Foreground="{DynamicResource AccentBrush}"
                                                   VerticalAlignment="Center"/>
                                    </Grid>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="52"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="28"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="D-Day"
                                                   Foreground="{DynamicResource SubTextBrush}"
                                                   VerticalAlignment="Center"/>
                                        <Slider x:Name="InlineDDayFontSizeSlider"
                                                Grid.Column="1"
                                                Minimum="10"
                                                Maximum="24"
                                                TickFrequency="1"
                                                IsSnapToTickEnabled="True"
                                                Foreground="{DynamicResource AccentBrush}"
                                                VerticalAlignment="Center"
                                                IsMoveToPointEnabled="True"
                                                local:SliderInteraction.EnableMouseDrag="True"
                                                ValueChanged="InlineFontSizeSlider_ValueChanged"/>
                                        <TextBlock x:Name="InlineDDayFontSizeText"
                                                   Grid.Column="2"
                                                   TextAlignment="Right"
                                                   Foreground="{DynamicResource AccentBrush}"
                                                   VerticalAlignment="Center"/>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <Border Background="{DynamicResource CardBrush}"
                                    BorderBrush="{DynamicResource CardBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="12"
                                    Padding="12,10"
                                    Margin="0,10,0,0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="Windows 시작"
                                                   Foreground="{DynamicResource TextBrush}"
                                                   FontWeight="SemiBold"/>
                                        <TextBlock Text="로그인할 때 위젯을 자동으로 실행합니다."
                                                   Foreground="{DynamicResource SubTextBrush}"
                                                   FontSize="10"
                                                   Margin="0,4,0,0"/>
                                    </StackPanel>
                                    <ToggleButton x:Name="InlineStartupToggle"
                                                  Grid.Column="1"
                                                  Style="{StaticResource WidgetToggleButton}"
                                                  Width="46"
                                                  Height="24"
                                                  VerticalAlignment="Center"
                                                  Checked="InlineStartupToggle_Checked"
                                                  Unchecked="InlineStartupToggle_Unchecked"/>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <StackPanel Grid.Row="2"
                                Orientation="Horizontal"
                                HorizontalAlignment="Right">
                        <Button Content="취소"
                                Width="70"
                                Height="34"
                                Margin="0,0,8,0"
                                Style="{StaticResource WidgetSecondaryButton}"
                                Click="InlineSettingsCancelButton_Click"/>
                        <Button Content="저장"
                                Width="70"
                                Height="34"
                                Style="{StaticResource WidgetPrimaryButton}"
                                Click="InlineSettingsApplyButton_Click"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- monitor selection is kept inside the widget so it never floats above other apps -->
            <Border x:Name="MonitorPanel"
                    Background="#660B1220"
                    CornerRadius="19"
                    Panel.ZIndex="40"
                    Visibility="Collapsed">
                <Border Width="300"
                        Height="276"
                        Background="{DynamicResource CardBrush}"
                        BorderBrush="{DynamicResource CardBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="16"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Padding="18,16,18,14">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="20" ShadowDepth="4" Opacity="0.22"/>
                    </Border.Effect>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="34"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="30"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Path Data="M2,3 H18 V14 H2 Z M6,18 H14 M10,14 V18"
                                      Width="17"
                                      Height="17"
                                      Stretch="Fill"
                                      Stroke="{DynamicResource AccentBrush}"
                                      StrokeThickness="1.5"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
                                      StrokeLineJoin="Round"
                                      Margin="0,0,8,0"/>
                                <TextBlock Text="모니터 선택"
                                           Foreground="{DynamicResource TextBrush}"
                                           FontSize="17"
                                           FontWeight="SemiBold"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                            <Button Grid.Column="1"
                                    Style="{StaticResource WidgetIconButton}"
                                    Width="30"
                                    Height="30"
                                    ToolTip="모니터 선택 닫기"
                                    Click="MonitorPanelCloseButton_Click">
                                <Path Data="M4,4 L12,12 M12,4 L4,12"
                                      Width="13"
                                      Height="13"
                                      Stretch="Fill"
                                      Stroke="{DynamicResource SubTextBrush}"
                                      StrokeThickness="1.5"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"/>
                            </Button>
                        </Grid>

                        <TextBlock Grid.Row="1"
                                   Text="위젯을 표시할 모니터를 선택하세요."
                                   Foreground="{DynamicResource SubTextBrush}"
                                   FontSize="10"
                                   Margin="1,6,0,10"/>

                        <ScrollViewer Grid.Row="2"
                                      VerticalScrollBarVisibility="Hidden"
                                      HorizontalScrollBarVisibility="Disabled">
                            <ItemsControl x:Name="MonitorOptionsList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Tag="{Binding Id}"
                                                Style="{StaticResource WidgetSecondaryButton}"
                                                Height="52"
                                                Margin="0,0,0,7"
                                                HorizontalContentAlignment="Stretch"
                                                Click="MonitorOptionButton_Click">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="34"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <Border Width="28"
                                                        Height="28"
                                                        CornerRadius="8"
                                                        Background="{DynamicResource ControlHoverBrush}"
                                                        VerticalAlignment="Center">
                                                    <Path Data="M2,3 H18 V14 H2 Z M6,18 H14 M10,14 V18"
                                                          Width="16"
                                                          Height="16"
                                                          Stretch="Fill"
                                                          Stroke="{DynamicResource AccentBrush}"
                                                          StrokeThickness="1.35"
                                                          StrokeStartLineCap="Round"
                                                          StrokeEndLineCap="Round"
                                                          StrokeLineJoin="Round"
                                                          HorizontalAlignment="Center"
                                                          VerticalAlignment="Center"/>
                                                </Border>
                                                <StackPanel Grid.Column="1"
                                                            VerticalAlignment="Center"
                                                            Margin="9,0,6,0">
                                                    <TextBlock Text="{Binding DisplayName}"
                                                               Foreground="{DynamicResource TextBrush}"
                                                               FontWeight="SemiBold"/>
                                                    <TextBlock Text="{Binding Detail}"
                                                               Foreground="{DynamicResource SubTextBrush}"
                                                               FontSize="10"
                                                               Margin="0,3,0,0"/>
                                                </StackPanel>
                                                <TextBlock Grid.Column="2"
                                                           Text="{Binding StatusText}"
                                                           Foreground="{DynamicResource AccentBrush}"
                                                           FontSize="10"
                                                           FontWeight="SemiBold"
                                                           VerticalAlignment="Center"/>
                                            </Grid>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Border>

            <!-- edit dialog shown in the widget -->
            <Border x:Name="InlineEditPanel"
                    Background="#660B1220"
                    CornerRadius="19"
                    Panel.ZIndex="20"
                    Visibility="Collapsed">
                <Border Width="300"
                        Height="270"
                        Background="{DynamicResource CardBrush}"
                        BorderBrush="{DynamicResource CardBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="16"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Padding="18,16,18,14">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="20" ShadowDepth="4" Opacity="0.22"/>
                    </Border.Effect>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="34"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="30"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Path Data="M3,3 H13 V13 H3 Z M5,1 V5 M11,1 V5 M3,6 H13 M5,9 H7 M9,9 H11 M5,11 H7"
                                      Width="16"
                                      Height="16"
                                      Stretch="Fill"
                                      Stroke="{DynamicResource AccentBrush}"
                                      StrokeThickness="1.25"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
                                      StrokeLineJoin="Round"
                                      Margin="0,0,8,0"/>
                                <TextBlock Text="일정 수정"
                                           Foreground="{DynamicResource TextBrush}"
                                           FontSize="17"
                                           FontWeight="SemiBold"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                            <Button Grid.Column="1"
                                    Style="{StaticResource WidgetIconButton}"
                                    Width="30"
                                    Height="30"
                                    ToolTip="수정 닫기"
                                    Click="InlineEditCloseButton_Click">
                                <Path Data="M4,4 L12,12 M12,4 L4,12"
                                      Width="13"
                                      Height="13"
                                      Stretch="Fill"
                                      Stroke="{DynamicResource SubTextBrush}"
                                      StrokeThickness="1.5"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"/>
                            </Button>
                        </Grid>

                        <StackPanel Grid.Row="1" Margin="0,12,0,12">
                            <TextBlock Text="제목"
                                       Foreground="{DynamicResource SubTextBrush}"
                                       FontSize="10"
                                       Margin="1,0,0,5"/>
                            <TextBox x:Name="InlineEditTitleInput"
                                     Height="38"
                                     Style="{StaticResource WidgetTextBox}"
                                     FontSize="12"/>
                            <TextBlock Text="날짜"
                                       Foreground="{DynamicResource SubTextBrush}"
                                       FontSize="10"
                                       Margin="1,12,0,5"/>
                            <Border Background="{DynamicResource BackgroundBrush}"
                                    BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="10"
                                    Height="40"
                                    Padding="5,0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="45"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="29"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="29"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <ComboBox x:Name="InlineEditYearCombo"
                                              Grid.Column="0"
                                              Tag="HideArrow"
                                              Height="30"
                                              Style="{StaticResource WidgetDateComboBox}"
                                              IsEditable="True"/>
                                    <TextBlock Grid.Column="1"
                                               Text="년"
                                               Foreground="{DynamicResource SubTextBrush}"
                                               FontSize="10"
                                               VerticalAlignment="Center"
                                               Margin="1,0,3,0"/>
                                    <ComboBox x:Name="InlineEditMonthCombo"
                                              Grid.Column="2"
                                              Tag="HideArrow"
                                              Height="30"
                                              Style="{StaticResource WidgetDateComboBox}"/>
                                    <TextBlock Grid.Column="3"
                                               Text="월"
                                               Foreground="{DynamicResource SubTextBrush}"
                                               FontSize="10"
                                               VerticalAlignment="Center"
                                               Margin="1,0,3,0"/>
                                    <ComboBox x:Name="InlineEditDayCombo"
                                              Grid.Column="4"
                                              Tag="HideArrow"
                                              Height="30"
                                              Style="{StaticResource WidgetDateComboBox}"/>
                                    <TextBlock Grid.Column="5"
                                               Text="일"
                                               Foreground="{DynamicResource SubTextBrush}"
                                               FontSize="10"
                                               VerticalAlignment="Center"
                                               Margin="1,0,0,0"/>
                                </Grid>
                            </Border>
                        </StackPanel>

                        <StackPanel Grid.Row="2"
                                    Orientation="Horizontal"
                                    HorizontalAlignment="Right">
                            <Button Content="취소"
                                    Width="70"
                                    Height="36"
                                    Margin="0,0,8,0"
                                    Style="{StaticResource WidgetSecondaryButton}"
                                    Click="InlineEditCancelButton_Click"/>
                            <Button Content="저장"
                                    Width="70"
                                    Height="36"
                                    Style="{StaticResource WidgetPrimaryButton}"
                                    Click="InlineEditSaveButton_Click"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Border>

            <!-- remove confirmation shown in the widget -->
            <Border x:Name="RemoveConfirmPanel"
                    Background="#660B1220"
                    CornerRadius="19"
                    Panel.ZIndex="30"
                    Visibility="Collapsed">
                <Border Width="270"
                        Height="166"
                        Background="{DynamicResource CardBrush}"
                        BorderBrush="{DynamicResource CardBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="16"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Padding="18,16,18,14">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="20" ShadowDepth="4" Opacity="0.22"/>
                    </Border.Effect>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <StackPanel Orientation="Horizontal">
                            <Border Width="30"
                                    Height="30"
                                    CornerRadius="15"
                                    Background="#1AE2555D"
                                    VerticalAlignment="Center">
                                <Path Data="M12,3 L21,20 H3 Z M12,8 V13 M12,16 V16.2"
                                      Width="16"
                                      Height="16"
                                      Stretch="Fill"
                                      Stroke="#FFE2555D"
                                      StrokeThickness="1.4"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
                                      StrokeLineJoin="Round"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="일정 제거"
                                       Foreground="{DynamicResource TextBrush}"
                                       FontSize="16"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center"
                                       Margin="9,0,0,0"/>
                        </StackPanel>
                        <TextBlock x:Name="RemoveConfirmMessage"
                                   Grid.Row="1"
                                   Foreground="{DynamicResource SubTextBrush}"
                                   FontSize="11"
                                   TextWrapping="Wrap"
                                   VerticalAlignment="Center"
                                   Margin="1,10,0,8"/>
                        <StackPanel Grid.Row="2"
                                    Orientation="Horizontal"
                                    HorizontalAlignment="Right">
                            <Button Content="취소"
                                    Width="70"
                                    Height="32"
                                    Margin="0,0,8,0"
                                    Style="{StaticResource WidgetSecondaryButton}"
                                    Click="RemoveConfirmCancelButton_Click"/>
                            <Button Content="제거"
                                    Width="70"
                                    Height="32"
                                    Style="{StaticResource WidgetDangerButton}"
                                    Click="RemoveConfirmApplyButton_Click"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Border>
        </Grid>
    </Border>
</Window>
