                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="구글 캘린더 연동" Style="{StaticResource AuxSectionTitle}" FontSize="14"/>
                                            <TextBlock Text="일정을 구글 캘린더(기본 캘린더)와 양쪽으로 맞춥니다."
                                                       Style="{StaticResource AuxCaption}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                        </StackPanel>
                                        <ToggleButton x:Name="GoogleCalendarSwitch" Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center"
                                                      Style="{StaticResource AuxOnOffSwitch}" Click="GoogleCalendarSwitch_Click"
                                                      AutomationProperties.Name="구글 캘린더 연동 켜기/끄기"/>
                                    </Grid>
                                    <Grid Margin="0,8,0,0">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <TextBlock x:Name="GoogleCalendarStatus" Style="{StaticResource AuxCaption}" TextWrapping="Wrap" VerticalAlignment="Center"/>
                                        <Button x:Name="GoogleSyncNowButton" Grid.Column="1" Content="지금 동기화" Height="30" Padding="12,0" Margin="10,0,0,0"
                                                Style="{StaticResource AuxUtilityButton}" Click="GoogleSyncNow_Click"/>
                                    </Grid>
                                    <Grid Margin="0,14,0,0">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="캐릭터도 구글 드라이브에 보관" Style="{StaticResource AuxSectionTitle}" FontSize="14"/>
                                            <TextBlock Text="가져온 캐릭터를 드라이브에 보관하고 같은 계정의 다른 PC와 나눕니다."
                                                       Style="{StaticResource AuxCaption}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                        </StackPanel>
                                        <ToggleButton x:Name="GooglePetsSwitch" Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center"
                                                      Style="{StaticResource AuxOnOffSwitch}" Click="GooglePetsSwitch_Click"
                                                      AutomationProperties.Name="캐릭터 구글 드라이브 보관 켜기/끄기"/>
                                    </Grid>
                                    <TextBlock x:Name="GooglePetsStatus" Style="{StaticResource AuxCaption}" TextWrapping="Wrap" Margin="0,6,0,0"/>
                                </StackPanel>
                            </Border>

                            <!-- 업데이트: updates come from the public GitHub repository set in code (UpdateClient.GitHubRepository); nothing
                                 here is a setting. While it is blank the 업데이트 button is disabled. Pressed: check -> a newer, verified
                                 version is confirmed in a dialog -> download, verify, updater, the app closes. Otherwise the status line says why. -->
                            <Border x:Name="UpdateCard" Style="{StaticResource AuxRoundSection}" Padding="14,12" Margin="0,10,0,0">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <TextBlock Text="업데이트" Style="{StaticResource AuxSectionTitle}" FontSize="15" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="UpdateCurrentVersionText" Grid.Column="1" Style="{StaticResource AuxCaption}" VerticalAlignment="Center"
                                                   Margin="10,0,0,0"/>
                                    </Grid>
                                    <Button x:Name="UpdateButton" Content="업데이트" Height="36" Margin="0,12,0,0" IsEnabled="False"
                                            Style="{StaticResource AuxPrimaryButton}" Click="UpdateButton_Click"/>
                                    <TextBlock x:Name="UpdateStatusText" Style="{StaticResource AuxCaption}" TextWrapping="Wrap" Margin="0,8,0,0"
                                               Visibility="Collapsed"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <StackPanel Grid.Row="2"
                                Orientation="Horizontal"
                                HorizontalAlignment="Right">
                                <!-- 초기화: two presses; only the draft changes (저장 applies, 취소 reverts). Windows 시작 is left alone. -->
                                <Button x:Name="InlineSettingsResetButton"
                                        Content="초기화"
                                        MinWidth="80"
                                        Height="40"
                                        Padding="12,0"
                                        Margin="0,0,8,0"
                                        Style="{StaticResource AuxCompactButton}"
                                        ToolTip="테마·투명도·글자 크기·할 일 색상·캐릭터 크기와 위치·창 표시·D-day 표시·넘김 애니메이션·단축키를 처음 값으로 되돌립니다 (저장해야 적용)"
                                        AutomationProperties.Name="설정 초기화"
                                        Click="InlineSettingsResetButton_Click"/>
                                <Button Content="취소"
                                        Width="80"
                                        Height="40"
                                        Margin="0,0,8,0"
                                        Style="{StaticResource AuxCancelButton}"
                                        Click="InlineSettingsCancelButton_Click"/>
                                <Button Content="저장"
                                        Width="80"
                                        Height="40"
                                        Style="{StaticResource AuxSaveButton}"
                                Click="InlineSettingsApplyButton_Click"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- monitor selection is kept inside the widget so it never floats above other apps -->
            <Border x:Name="MonitorPanel"
                    Background="#660B1220"
                    CornerRadius="19"
                    Panel.ZIndex="40"
                    Visibility="Collapsed">
                <Border Width="300"
                        Height="276"
                        Background="{DynamicResource CardBrush}"
                        BorderBrush="{DynamicResource CardBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="16"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Padding="18,16,18,14">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="20" ShadowDepth="4" Opacity="0.22"/>
                    </Border.Effect>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="34"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="30"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Path Data="M2,3 H18 V14 H2 Z M6,18 H14 M10,14 V18"
                                      Width="17"
                                      Height="17"
                                      Stretch="Fill"
                                      Stroke="{DynamicResource AccentBrush}"
                                      StrokeThickness="1.5"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
                                      StrokeLineJoin="Round"
                                      Margin="0,0,8,0"/>
                                <TextBlock Text="모니터 선택"
                                           Foreground="{DynamicResource TextBrush}"
                                           FontSize="17"
                                           FontWeight="SemiBold"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                            <Button Grid.Column="1"
                                    Style="{StaticResource WidgetIconButton}"
                                    Width="30"
                                    Height="30"
                                    ToolTip="모니터 선택 닫기"
                                    AutomationProperties.Name="모니터 선택 닫기"
                                    Click="MonitorPanelCloseButton_Click">
                                <Path Data="M4,4 L12,12 M12,4 L4,12"
                                      Width="13"
                                      Height="13"
                                      Stretch="Fill"
                                      Stroke="{DynamicResource SubTextBrush}"
                                      StrokeThickness="1.5"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"/>
                            </Button>
                        </Grid>

                        <TextBlock Grid.Row="1"
                                   Text="위젯을 표시할 모니터를 선택하세요."
                                   Foreground="{DynamicResource SubTextBrush}"
                                   FontSize="10"
                                   Margin="1,6,0,10"/>

                        <ScrollViewer Grid.Row="2"
                                      VerticalScrollBarVisibility="Hidden"
                                      HorizontalScrollBarVisibility="Disabled">
                            <ItemsControl x:Name="MonitorOptionsList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Tag="{Binding Id}"
                                                Style="{StaticResource WidgetSecondaryButton}"
                                                Height="52"
                                                Margin="0,0,0,7"
                                                HorizontalContentAlignment="Stretch"
                                                Click="MonitorOptionButton_Click">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="34"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <Border Width="28"
                                                        Height="28"
                                                        CornerRadius="8"
                                                        Background="{DynamicResource ControlHoverBrush}"
                                                        VerticalAlignment="Center">
                                                    <Path Data="M2,3 H18 V14 H2 Z M6,18 H14 M10,14 V18"
                                                          Width="16"
                                                          Height="16"
                                                          Stretch="Fill"
                                                          Stroke="{DynamicResource AccentBrush}"
                                                          StrokeThickness="1.35"
                                                          StrokeStartLineCap="Round"
                                                          StrokeEndLineCap="Round"
                                                          StrokeLineJoin="Round"
                                                          HorizontalAlignment="Center"
                                                          VerticalAlignment="Center"/>
                                                </Border>
                                                <StackPanel Grid.Column="1"
                                                            VerticalAlignment="Center"
                                                            Margin="9,0,6,0">
                                                    <TextBlock Text="{Binding DisplayName}"
                                                               Foreground="{DynamicResource TextBrush}"
                                                               FontWeight="SemiBold"/>
                                                    <TextBlock Text="{Binding Detail}"
                                                               Foreground="{DynamicResource SubTextBrush}"
                                                               FontSize="10"
                                                               Margin="0,3,0,0"/>
                                                </StackPanel>
                                                <TextBlock Grid.Column="2"
                                                           Text="{Binding StatusText}"
                                                           Foreground="{DynamicResource AccentBrush}"
                                                           FontSize="10"
                                                           FontWeight="SemiBold"
                                                           VerticalAlignment="Center"/>
                                            </Grid>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Border>

            <!-- edit dialog shown in the widget -->
            <Border x:Name="InlineEditPanel"
                    Background="#660B1220"
                    CornerRadius="19"
                    Panel.ZIndex="20"
                    Visibility="Collapsed">
                <Border Width="300"
                        Height="350"
                        Background="{DynamicResource CardBrush}"
                        BorderBrush="{DynamicResource CardBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="16"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Padding="18,16,18,14">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="20" ShadowDepth="4" Opacity="0.22"/>
                    </Border.Effect>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="34"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="30"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Path Data="M3,3 H13 V13 H3 Z M5,1 V5 M11,1 V5 M3,6 H13 M5,9 H7 M9,9 H11 M5,11 H7"
                                      Width="16"
                                      Height="16"
                                      Stretch="Fill"
                                      Stroke="{DynamicResource AccentBrush}"
                                      StrokeThickness="1.25"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
                                      StrokeLineJoin="Round"
                                      Margin="0,0,8,0"/>
                                <TextBlock Text="일정 수정"
                                           Foreground="{DynamicResource TextBrush}"
                                           FontSize="17"
                                           FontWeight="SemiBold"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                            <Button Grid.Column="1"
                                    Style="{StaticResource WidgetIconButton}"
                                    Width="30"
                                    Height="30"
                                    ToolTip="수정 닫기"
                                    AutomationProperties.Name="수정 닫기"
                                    Click="InlineEditCloseButton_Click">
                                <Path Data="M4,4 L12,12 M12,4 L4,12"
                                      Width="13"
                                      Height="13"
                                      Stretch="Fill"
                                      Stroke="{DynamicResource SubTextBrush}"
                                      StrokeThickness="1.5"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"/>
                            </Button>
                        </Grid>

                        <StackPanel Grid.Row="1" Margin="0,8,0,8">
                            <TextBlock Text="제목"
                                       Foreground="{DynamicResource SubTextBrush}"
                                       FontSize="10"
                                       Margin="1,0,0,5"/>
                            <TextBox x:Name="InlineEditTitleInput"
                                     Height="38"
                                     Style="{StaticResource WidgetTextBox}"
                                     FontSize="12"/>
                            <TextBlock Text="날짜"
                                       Foreground="{DynamicResource SubTextBrush}"
                                       FontSize="10"
                                       Margin="1,8,0,4"/>
                            <Border Background="{DynamicResource BackgroundBrush}"
                                    BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="10"
                                    Height="40"
                                    Padding="5,0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="45"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="29"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="29"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <ComboBox x:Name="InlineEditYearCombo"
                                              Grid.Column="0"
                                              Tag="HideArrow"
                                              Height="30"
                                              Style="{StaticResource WidgetDateComboBox}"
                                              IsEditable="True"/>
                                    <TextBlock Grid.Column="1"
                                               Text="년"
                                               Foreground="{DynamicResource SubTextBrush}"
                                               FontSize="10"
                                               VerticalAlignment="Center"
                                               Margin="1,0,3,0"/>
                                    <ComboBox x:Name="InlineEditMonthCombo"
                                              Grid.Column="2"
                                              Tag="HideArrow"
                                              Height="30"
                                              Style="{StaticResource WidgetDateComboBox}"/>
                                    <TextBlock Grid.Column="3"
                                               Text="월"
                                               Foreground="{DynamicResource SubTextBrush}"
                                               FontSize="10"
                                               VerticalAlignment="Center"
                                               Margin="1,0,3,0"/>
                                    <ComboBox x:Name="InlineEditDayCombo"
                                              Grid.Column="4"
                                              Tag="HideArrow"
                                              Height="30"
                                              Style="{StaticResource WidgetDateComboBox}"/>
                                    <TextBlock Grid.Column="5"
                                               Text="일"
                                               Foreground="{DynamicResource SubTextBrush}"
                                               FontSize="10"
                                               VerticalAlignment="Center"
                                               Margin="1,0,0,0"/>
                                </Grid>
                            </Border>
                            <!-- 여러 날: the range's last day (10/8 ~ 10/10); off = one day. -->
                            <Grid Height="34" Margin="0,6,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <CheckBox x:Name="InlineEditRangeToggle"
                                          Content="여러 날"
                                          Foreground="{DynamicResource TextBrush}"
                                          VerticalAlignment="Center"
                                          ToolTip="여러 날 이어지는 일정 (종료 날짜 선택)"
                                          Checked="InlineEditRangeToggle_Changed"
                                          Unchecked="InlineEditRangeToggle_Changed"/>
                                <Border x:Name="InlineEditEndBox"
                                        Grid.Column="1"
                                        Margin="10,0,0,0"
                                        Height="32"
                                        IsEnabled="False"
                                        Background="{DynamicResource BackgroundBrush}"
                                        BorderBrush="{DynamicResource BorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="10"
                                        Padding="4,0">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Style.Triggers>
                                                <Trigger Property="IsEnabled" Value="False">
                                                    <Setter Property="Opacity" Value="0.45"/>
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="28"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid Width="26" Height="26" VerticalAlignment="Center">
                                            <Path Data="M2,3 H14 V14 H2 Z M5,1 V5 M11,1 V5 M2,6 H14"
                                                  Width="14" Height="14" Stretch="Fill"
                                                  Stroke="{DynamicResource AccentBrush}" StrokeThickness="1.3"
                                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            <local:SafeDatePicker x:Name="InlineEditEndPicker"
                                                                  Width="26" Height="26" Opacity="0"
                                                                  ToolTip="달력에서 종료 날짜 선택"
                                                                  AutomationProperties.Name="수정 종료 날짜"
                                                                  SelectedDateChanged="InlineEditEndPicker_SelectedDateChanged"
                                                                  BorderThickness="0" Background="Transparent"
                                                                  FocusVisualStyle="{x:Null}" Focusable="False" IsTabStop="False"
                                                                  VerticalAlignment="Center"/>
                                        </Grid>
                                        <TextBlock x:Name="InlineEditEndText" Grid.Column="1" Text="종료 날짜"
                                                   Foreground="{DynamicResource TextBrush}" FontSize="12"
                                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                    </Grid>
                                </Border>
                            </Grid>
                            <TextBlock Text="시간"
                                       Foreground="{DynamicResource SubTextBrush}"
                                       FontSize="10"
                                       Margin="1,8,0,4"/>
                            <Grid Height="34">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <CheckBox x:Name="InlineEditTimeToggle"
                                          Content="시간 지정"
                                          Foreground="{DynamicResource TextBrush}"
                                          VerticalAlignment="Center"
                                          Checked="InlineEditTimeToggle_Changed"
                                          Unchecked="InlineEditTimeToggle_Changed"/>
                                <TextBox x:Name="InlineEditTimeInput"
                                         Grid.Column="1"
                                         Text="09:00"
                                         Width="76"
                                         Height="32"
                                         MaxLength="5"
                                         IsEnabled="False"
                                         Style="{StaticResource WidgetTextBox}"
                                         HorizontalContentAlignment="Center"
                                         ToolTip="HH:mm"/>
                            </Grid>
                        </StackPanel>

                        <StackPanel Grid.Row="2"
                                    Orientation="Horizontal"
                                    HorizontalAlignment="Right">
                            <Button Content="취소"
                                    Width="70"
                                    Height="36"
                                    Margin="0,0,8,0"
                                    Style="{StaticResource WidgetSecondaryButton}"
                                    Click="InlineEditCancelButton_Click"/>
                            <Button Content="저장"
                                    Width="70"
                                    Height="36"
                                    Style="{StaticResource WidgetPrimaryButton}"
                                    Click="InlineEditSaveButton_Click"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Border>

            <!-- delete confirmation shown in the widget (grows for the Google Calendar note) -->
            <Border x:Name="RemoveConfirmPanel"
                    Background="#660B1220"
                    CornerRadius="19"
                    Panel.ZIndex="30"
                    Visibility="Collapsed">
                <Border Width="270"
                        MinHeight="166"
                        Background="{DynamicResource CardBrush}"
                        BorderBrush="{DynamicResource CardBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="16"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Padding="18,16,18,14">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="20" ShadowDepth="4" Opacity="0.22"/>
                    </Border.Effect>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <StackPanel Orientation="Horizontal">
                            <Border Width="30"
                                    Height="30"
                                    CornerRadius="15"
                                    Background="#1AE2555D"
                                    VerticalAlignment="Center">
                                <Path Data="M12,3 L21,20 H3 Z M12,8 V13 M12,16 V16.2"
                                      Width="16"
                                      Height="16"
                                      Stretch="Fill"
                                      Stroke="#FFE2555D"
                                      StrokeThickness="1.4"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
                                      StrokeLineJoin="Round"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="일정 삭제"
                                       Foreground="{DynamicResource TextBrush}"
                                       FontSize="16"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center"
                                       Margin="9,0,0,0"/>
                        </StackPanel>
                        <TextBlock x:Name="RemoveConfirmMessage"
                                   Grid.Row="1"
                                   Foreground="{DynamicResource SubTextBrush}"
                                   FontSize="11"
                                   TextWrapping="Wrap"
                                   VerticalAlignment="Center"
                                   Margin="1,10,0,8"/>
                        <StackPanel Grid.Row="2"
                                    Orientation="Horizontal"
                                    HorizontalAlignment="Right">
                            <Button Content="취소"
                                    Width="70"
                                    Height="32"
                                    Margin="0,0,8,0"
                                    Style="{StaticResource WidgetSecondaryButton}"
                                    Click="RemoveConfirmCancelButton_Click"/>
                            <Button Content="삭제"
                                    Width="70"
                                    Height="32"
                                    Style="{StaticResource WidgetDangerButton}"
                                    Click="RemoveConfirmApplyButton_Click"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Border>
        </Grid>
    </Border>
</Window>
