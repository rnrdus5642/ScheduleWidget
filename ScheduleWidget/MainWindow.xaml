<Window x:Class="ScheduleWidget.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Height="400" Width="300"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="False">

    <Border x:Name="MainBorder" CornerRadius="15"
            Background="{DynamicResource BackgroundBrush}"
            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="40"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="70"/>
            </Grid.RowDefinitions>

            <!-- 상단 영역 -->
            <Border Grid.Row="0" Background="{DynamicResource TopBarBrush}"
                    CornerRadius="15,15,0,0"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1"
                    MouseLeftButtonDown="TopBar_MouseLeftButtonDown">
                <DockPanel VerticalAlignment="Center" Margin="5,0,5,0" LastChildFill="False">

                    <TextBlock Text="&#x1F4C5;" FontSize="20" VerticalAlignment="Center" DockPanel.Dock="Left"/>

                    <!-- 오른쪽 버튼 영역 -->
                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center" Margin="0,0,7,0">
                        <!-- 위치/크기 전환 슬라이딩 토글 -->
                        <ToggleButton x:Name="ModeToggle" Width="50" Height="24" Margin="0,0,8,0"
                                     Checked="ModeToggle_Checked" Unchecked="ModeToggle_Unchecked">
                            <ToggleButton.Style>
                                <Style TargetType="ToggleButton">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ToggleButton">
                                                <Grid Width="{TemplateBinding Width}" Height="{TemplateBinding Height}">
                                                    <Border x:Name="SwitchBackground"
                                                        Background="LightGray"
                                                        CornerRadius="12"
                                                        BorderThickness="1"
                                                        BorderBrush="Gray"/>
                                                    <Ellipse x:Name="Knob"
                                                        Width="20" Height="20"
                                                        Fill="White"
                                                        Margin="2"
                                                        HorizontalAlignment="Left"/>
                                                </Grid>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsChecked" Value="True">
                                                        <Setter TargetName="SwitchBackground" Property="Background" Value="LightGreen"/>
                                                        <Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ToggleButton.Style>
                        </ToggleButton>

                        <!-- 설정 버튼 -->
                        <Button Content="&#x2699;" FontSize="20" Width="30" Height="30"
                                BorderThickness="0" Background="Transparent"
                                Foreground="{DynamicResource TextBrush}"
                                Click="SettingsButton_Click"/>
                    </StackPanel>

                </DockPanel>
            </Border>

            <!-- 중간 영역 -->
            <Border Grid.Row="1" Background="{DynamicResource BackgroundBrush}"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,1">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="ScheduleList" BorderThickness="0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{DynamicResource CardBrush}" CornerRadius="8" Margin="5"
                                    Padding="8" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" SnapsToDevicePixels="True">

                                    <Border.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="수정" Click="EditSchedule_Click"/>
                                            <MenuItem Header="제거" Click="RemoveSchedule_Click"/>
                                        </ContextMenu>
                                    </Border.ContextMenu>

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Text="{Binding Title}"
                                               FontWeight="Bold"
                                               FontSize="{DynamicResource TitleFontSize}"
                                               Foreground="{DynamicResource TextBrush}"
                                               TextWrapping="Wrap"
                                               TextTrimming="CharacterEllipsis"
                                               Grid.Column="0"
                                               VerticalAlignment="Center"/>

                                        <StackPanel Grid.Column="1"
                                            VerticalAlignment="Top"
                                            HorizontalAlignment="Right"
                                            Orientation="Vertical">

                                            <TextBlock Text="{Binding DDay}"
                                                   FontWeight="SemiBold"
                                                   FontSize="{DynamicResource DDayFontSize}"
                                                   HorizontalAlignment="Right">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Status}" Value="Today">
                                                                <Setter Property="Foreground" Value="Blue"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Status}" Value="Past">
                                                                <Setter Property="Foreground" Value="Red"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>

                                            <TextBlock Text="{Binding DateString}"
                                                   FontSize="11"
                                                   Foreground="{DynamicResource SubTextBrush}"
                                                   HorizontalAlignment="Right"
                                                   Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Border>

            <!-- 하단 영역 -->
            <Border Grid.Row="2" Background="{DynamicResource BottomBarBrush}"
                    CornerRadius="0,0,15,15"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0">
                <Grid Margin="5">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="5,0,0,5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="60"/>
                        </Grid.ColumnDefinitions>

                        <TextBox x:Name="TitleInput" KeyDown="TitleInput_KeyDown" Grid.Column="0" Height="25" Margin="0,0,5,0"/>
                        <Button x:Name="AddButton" Grid.Column="1" Content="추가" Width="60" Height="25" Click="AddButton_Click"/>
                    </Grid>

                    <StackPanel Grid.Row="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="5,0,0,0">
                        <ComboBox x:Name="YearCombo" Width="70" Height="25" Margin="0,0,5,0"/>
                        <ComboBox x:Name="MonthCombo" Width="50" Height="25" Margin="0,0,5,0"/>
                        <ComboBox x:Name="DayCombo" Width="50" Height="25" Margin="0,0,5,0"/>

                        <DatePicker x:Name="CalendarPicker"
                            Width="30" Height="25"
                            SelectedDateChanged="CalendarPicker_SelectedDateChanged"
                            BorderThickness="0"
                            Background="Transparent"
                            VerticalAlignment="Center">
                            <DatePicker.Resources>
                                <Style TargetType="DatePickerTextBox">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </Style>
                            </DatePicker.Resources>
                        </DatePicker>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
