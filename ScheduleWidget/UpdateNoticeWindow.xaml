<Window x:Class="ScheduleWidget.UpdateNoticeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="업데이트 알림" AutomationProperties.Name="업데이트 알림"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent" ResizeMode="NoResize"
        ShowInTaskbar="False" ShowActivated="False" Topmost="False" Focusable="False"
        SizeToContent="WidthAndHeight" WindowStartupLocation="Manual" Left="-32000" Top="-32000" UseLayoutRounding="True">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Styles/AuxiliaryStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    <!-- The pets' speech bubble (the same look as the mini window's DayPopup / BlockPopup): its tail points at the pet
         (or the calendar's top band) below it, or above it when there is no room over the anchor. -->
    <Grid x:Name="Bubble" Width="300">
        <Border x:Name="BubbleFace" Background="{DynamicResource AuxSurfaceBrush}" BorderBrush="{DynamicResource AuxHairlineBrush}"
                BorderThickness="1" CornerRadius="12" Padding="14,10,10,12" Margin="0,0,0,9">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBlock x:Name="NoticeTitle" Text="최신 업데이트 발견!" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource AuxInkBrush}"
                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,6,0"/>
                    <Button x:Name="NoticeSnoozeButton" Grid.Column="1" Content="하루 동안 안 보기" Height="24" MinHeight="24" Padding="8,0" FontSize="11"
                            Style="{StaticResource AuxCompactButton}" Focusable="False" Click="Snooze_Click"
                            ToolTip="24시간 동안 이 알림을 띄우지 않습니다" AutomationProperties.Name="하루 동안 안 보기"/>
                    <Button x:Name="NoticeCloseButton" Grid.Column="2" Width="24" Height="24" MinHeight="24" Padding="0" Margin="4,0,0,0"
                            Style="{StaticResource AuxCompactButton}" Focusable="False" Click="Close_Click"
                            ToolTip="닫기" AutomationProperties.Name="업데이트 알림 닫기">
                        <Path Data="M1,1 L9,9 M9,1 L1,9" Stroke="{DynamicResource AuxInkBrush}" StrokeThickness="1.5" Width="10" Height="10"/>
                    </Button>
                </Grid>
                <TextBlock x:Name="NoticeVersion" FontSize="12" Foreground="{DynamicResource AuxMutedBrush}" Margin="0,3,0,10"/>
                <TextBlock x:Name="NoticeStatus" FontSize="11" Foreground="{DynamicResource AuxMutedBrush}" TextWrapping="Wrap"
                           Visibility="Collapsed" Margin="0,-4,0,10" AutomationProperties.Name="업데이트 진행 상태"/>
                <Button x:Name="NoticeUpdateButton" Content="업데이트" HorizontalAlignment="Left" Height="28" MinHeight="28" Padding="16,0" FontSize="12"
                        Style="{StaticResource AuxPrimaryButton}" Focusable="False" Click="Update_Click"
                        ToolTip="새 버전을 내려받아 설치합니다" AutomationProperties.Name="지금 업데이트"/>
            </StackPanel>
        </Border>
        <Path x:Name="TailDown" Data="M0,0 L9,9 L18,0" Width="18" Height="10" Fill="{DynamicResource AuxSurfaceBrush}"
              Stroke="{DynamicResource AuxHairlineBrush}" StrokeThickness="1"
              HorizontalAlignment="Left" VerticalAlignment="Bottom" IsHitTestVisible="False"/>
        <Path x:Name="TailUp" Data="M0,10 L9,1 L18,10" Width="18" Height="10" Fill="{DynamicResource AuxSurfaceBrush}"
              Stroke="{DynamicResource AuxHairlineBrush}" StrokeThickness="1" Visibility="Collapsed"
              HorizontalAlignment="Left" VerticalAlignment="Top" IsHitTestVisible="False"/>
    </Grid>
</Window>
