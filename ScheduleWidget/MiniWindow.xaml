<Window x:Class="ScheduleWidget.MiniWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        xmlns:local="clr-namespace:ScheduleWidget"
        Title="캐릭터와 주간 달력" Width="800" Height="320"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" Topmost="False" ShowActivated="False"
        WindowStartupLocation="CenterScreen" UseLayoutRounding="True" PreviewKeyDown="Mini_KeyDown">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Styles/AuxiliaryStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        <Style x:Key="WeekArrow" TargetType="Button">
            <Setter Property="Width" Value="24"/><Setter Property="Height" Value="22"/>
            <Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="{DynamicResource AuxInkBrush}"/>
            <Setter Property="Template"><Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="ArrowFace" Background="{TemplateBinding Background}" CornerRadius="8">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ArrowFace" Property="Background" Value="{DynamicResource MiniHoverBrush}"/></Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="ArrowFace" Property="Background" Value="{DynamicResource MiniHoverBrush}"/></Trigger>
                        <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.35"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value></Setter>
        </Style>
        <Style x:Key="DayButton" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource MiniDayBrush}"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="Margin" Value="1,0"/>
            <Setter Property="Padding" Value="4,5,4,4"/>
            <Setter Property="Foreground" Value="{DynamicResource MiniInkBrush}"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="DayFace" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="3" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              Content="{TemplateBinding Content}"
                                              ContentTemplate="{TemplateBinding ContentTemplate}"
                                              TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="DayFace" Property="Opacity" Value="0.86"/></Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="DayFace" Property="BorderBrush" Value="{DynamicResource MiniFrameBrush}"/></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="DayFace" Property="Opacity" Value="0.72"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsToday}" Value="True">
                    <Setter Property="BorderBrush" Value="{DynamicResource MiniTodayBorderBrush}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <local:KeepAllConverter x:Key="KeepAll"/>
        <!-- Apple-style dropdown chip: pearl pill, hairline ring, ink text, press = scale 0.95, focus = 2px focus blue. -->
        <Style x:Key="DropdownPill" TargetType="Button">
            <Setter Property="FontFamily" Value="Segoe UI"/><Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{DynamicResource AuxInkBrush}"/><Setter Property="Background" Value="{DynamicResource AuxSurfaceBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AuxHairlineBrush}"/><Setter Property="Height" Value="26"/><Setter Property="Padding" Value="12,0,10,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle"><Setter.Value><Style><Setter Property="Control.Template"><Setter.Value><ControlTemplate>
                <Border BorderBrush="#0071E3" BorderThickness="2" CornerRadius="14" Margin="-2"/>
            </ControlTemplate></Setter.Value></Setter></Style></Setter.Value></Setter>
            <Setter Property="Template"><Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Face" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                            CornerRadius="13" Padding="{TemplateBinding Padding}" RenderTransformOrigin="0.5,0.5">
                        <ContentPresenter VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsPressed" Value="True"><Setter TargetName="Face" Property="RenderTransform"><Setter.Value><ScaleTransform ScaleX="0.95" ScaleY="0.95"/></Setter.Value></Setter></Trigger>
                        <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Face" Property="Opacity" Value="0.4"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value></Setter>
        </Style>
        <Style x:Key="PlayerButton" TargetType="Button" BasedOn="{StaticResource WeekArrow}">
            <Setter Property="Width" Value="30"/><Setter Property="Height" Value="28"/>
        </Style>
        <Style x:Key="PlayerTextButton" TargetType="Button" BasedOn="{StaticResource WeekArrow}">
            <Setter Property="Width" Value="Auto"/><Setter Property="Height" Value="26"/><Setter Property="Padding" Value="9,0"/>
            <Setter Property="FontSize" Value="11"/><Setter Property="Foreground" Value="{DynamicResource MiniInkBrush}"/>
            <Setter Property="Template"><Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Face" Background="{TemplateBinding Background}" BorderBrush="{DynamicResource MiniFrameBrush}" BorderThickness="1" CornerRadius="8" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Face" Property="Opacity" Value="0.8"/></Trigger>
                        <Trigger Property="IsPressed" Value="True"><Setter TargetName="Face" Property="Opacity" Value="0.65"/></Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Face" Property="BorderThickness" Value="2"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value></Setter>
        </Style>
        <Style x:Key="BubbleDoneButton" TargetType="Button" BasedOn="{StaticResource AuxPrimaryButton}">
            <Setter Property="MinHeight" Value="26"/><Setter Property="FontSize" Value="11"/><Setter Property="Padding" Value="2,0"/>
        </Style>
        <Style x:Key="BubbleDeleteButton" TargetType="Button" BasedOn="{StaticResource AuxPrimaryButton}">
            <Setter Property="MinHeight" Value="26"/><Setter Property="FontSize" Value="11"/><Setter Property="Padding" Value="4,0"/>
            <Setter Property="Background" Value="#D93F4C"/><Setter Property="BorderBrush" Value="#D93F4C"/><Setter Property="Foreground" Value="White"/>
        </Style>
        <Style x:Key="ResizeGrip" TargetType="Thumb">
            <Setter Property="Width" Value="16"/><Setter Property="Height" Value="16"/>
            <Setter Property="Panel.ZIndex" Value="10"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template"><Setter.Value>
                <ControlTemplate TargetType="Thumb"><Border Background="Transparent"/></ControlTemplate>
            </Setter.Value></Setter>
        </Style>
        </ResourceDictionary>
    </Window.Resources>
    <Grid x:Name="OuterRoot">
    <!-- The board: calendar + music bar. Its margin leaves room for pets placed outside it. -->
    <Grid x:Name="MiniRoot" Margin="4" SizeChanged="MiniRoot_SizeChanged">
        <!-- MP3-style player bar under the calendar: playlist button | ⏮ ▶/⏸ ⏭ (centered) | play mode; current song below. -->
        <Border x:Name="PlayerBar" Grid.Column="2" VerticalAlignment="Bottom" MinHeight="40" Margin="0,0,2,6"
                Background="{DynamicResource MiniPaperBrush}" BorderBrush="{DynamicResource MiniFrameBrush}" BorderThickness="2.5" CornerRadius="8" SizeChanged="PlayerBar_SizeChanged"
                MouseEnter="PlayerBar_HoverChanged" MouseLeave="PlayerBar_HoverChanged">
            <Grid Margin="6,2,6,2">
                <Grid.RowDefinitions><RowDefinition Height="32"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <!-- Left column: playlist-settings button at the far left; playlist dropdown right next to ⏮. -->
                <DockPanel LastChildFill="True">
                    <Button x:Name="PlayerOpen" DockPanel.Dock="Left" Style="{StaticResource PlayerButton}" Click="PlayerOpen_Click"
                            ToolTip="플레이리스트 설정 열기" AutomationProperties.Name="플레이리스트 설정 열기">
                        <Path Data="M1,2 L9,2 M1,6 L9,6 M1,10 L6,10 M12,11 L12,2 L15,3.5" Stroke="{DynamicResource MiniInkBrush}" StrokeThickness="1.7"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                    </Button>
                    <Button x:Name="PlayerPlaylist" HorizontalAlignment="Right" MaxWidth="150" Margin="6,0,8,0" Style="{StaticResource DropdownPill}"
                            Click="PlayerPlaylist_Click" AutomationProperties.Name="재생목록 선택">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBlock x:Name="PlayerPlaylistText" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                            <Path Grid.Column="1" Data="M1,1 L4.5,4.5 L8,1" Stroke="{DynamicResource AuxInkBrush}" StrokeThickness="1.4" StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round" StrokeLineJoin="Round" Margin="6,1,0,0" VerticalAlignment="Center"/>
                        </Grid>
                    </Button>
                </DockPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button x:Name="PlayerPrevious" Style="{StaticResource PlayerButton}" Click="PlayerPrevious_Click" ToolTip="이전 곡" AutomationProperties.Name="이전 곡">
                        <Path Data="M2,1 L2,11 M10,1 L4,6 L10,11 Z" Stroke="{DynamicResource MiniInkBrush}" Fill="{DynamicResource MiniInkBrush}" StrokeThickness="1.6" StrokeLineJoin="Round"/>
                    </Button>
                    <Button x:Name="PlayerPlay" Style="{StaticResource PlayerButton}" Margin="4,0" Click="PlayerPlay_Click" ToolTip="재생" AutomationProperties.Name="재생 / 일시정지">
                        <Grid>
                            <Path x:Name="PlayIcon" Data="M3,1 L11,6.5 L3,12 Z" Fill="{DynamicResource MiniInkBrush}" Stroke="{DynamicResource MiniInkBrush}" StrokeThickness="1" StrokeLineJoin="Round"/>
                            <Path x:Name="PauseIcon" Data="M3,1 L3,12 M9,1 L9,12" Stroke="{DynamicResource MiniInkBrush}" StrokeThickness="2.6" Visibility="Collapsed"/>
                        </Grid>
                    </Button>
                    <Button x:Name="PlayerNext" Style="{StaticResource PlayerButton}" Click="PlayerNext_Click" ToolTip="다음 곡" AutomationProperties.Name="다음 곡">
                        <Path Data="M10,1 L10,11 M2,1 L8,6 L2,11 Z" Stroke="{DynamicResource MiniInkBrush}" Fill="{DynamicResource MiniInkBrush}" StrokeThickness="1.6" StrokeLineJoin="Round"/>
                    </Button>
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="PlayerVolume" Margin="0,0,4,0" Style="{StaticResource PlayerButton}"
                        Click="PlayerVolume_Click" MouseWheel="PlayerVolume_MouseWheel" AutomationProperties.Name="음량"
                        MouseEnter="PlayerVolume_HoverChanged" MouseLeave="PlayerVolume_HoverChanged"
                        GotKeyboardFocus="PlayerVolume_HoverChanged" LostKeyboardFocus="PlayerVolume_HoverChanged"
                        PreviewKeyDown="PlayerVolume_PreviewKeyDown">
                    <Grid Width="16" Height="14">
                        <Path Data="M1,5 L4,5 L8,2 L8,12 L4,9 L1,9 Z" Fill="{DynamicResource MiniInkBrush}"/>
                        <Path x:Name="VolumeWaveLow" Data="M10,4.5 Q12,7 10,9.5" Stroke="{DynamicResource MiniInkBrush}" StrokeThickness="1.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                        <Path x:Name="VolumeWaveHigh" Data="M12,2.5 Q15.5,7 12,11.5" Stroke="{DynamicResource MiniInkBrush}" StrokeThickness="1.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                        <Path x:Name="VolumeMuted" Data="M10.5,5 L14.5,9 M14.5,5 L10.5,9" Stroke="{DynamicResource MiniHolidayBrush}" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Visibility="Collapsed"/>
                    </Grid>
                </Button>
                <!-- One button cycles 순차 → 랜덤 → 1곡 (한 곡 반복). -->
                <Button x:Name="PlayerMode" Style="{StaticResource PlayerTextButton}"
                        Click="PlayerMode_Click" AutomationProperties.Name="재생 순서">
                    <StackPanel Orientation="Horizontal">
                        <Grid Width="14" Height="14" Margin="0,0,5,0" VerticalAlignment="Center">
                            <Path x:Name="ModeSequentialIcon" Data="M1,7 L13,7 M9,3 L13,7 L9,11" Stroke="{DynamicResource MiniInkBrush}" StrokeThickness="1.6"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                            <Path x:Name="ModeShuffleIcon" Data="M1,3 L4,3 L10,11 L13,11 M11,9 L13,11 L11,13 M1,11 L4,11 L10,3 L13,3 M11,1 L13,3 L11,5"
                                  Stroke="{DynamicResource MiniInkBrush}" StrokeThickness="1.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Visibility="Collapsed"/>
                            <Grid x:Name="ModeRepeatOneIcon" Visibility="Collapsed">
                                <Path Data="M2,7 L2,4 L11,4 M9,2 L11,4 L9,6 M12,7 L12,10 L3,10 M5,8 L3,10 L5,12" Stroke="{DynamicResource MiniInkBrush}" StrokeThickness="1.4"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                                <TextBlock Text="1" FontSize="7" FontWeight="Bold" Foreground="{DynamicResource MiniInkBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Grid>
                        </Grid>
                        <TextBlock x:Name="PlayerModeText" Text="순차" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                </StackPanel>
                <!-- Third line under the scrolling title while a song is loaded: current time ━━●━━ length. Drag or click to move;
                     the wheel moves 5 seconds. The title stays above it (click → now-playing list). -->
                <Grid x:Name="SeekRow" Grid.Row="2" Grid.ColumnSpan="3" Height="16" Margin="2,0,2,3" Visibility="Collapsed">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBlock x:Name="SeekCurrent" Text="0:00" FontSize="10" Foreground="{DynamicResource MiniInkBrush}" VerticalAlignment="Center" MinWidth="30"/>
                    <Slider x:Name="SeekSlider" Grid.Column="1" Minimum="0" Maximum="1" IsMoveToPointEnabled="True" SmallChange="5" LargeChange="10"
                            VerticalAlignment="Center" Margin="6,0" ValueChanged="SeekSlider_ValueChanged"
                            Thumb.DragStarted="SeekSlider_DragStarted" Thumb.DragCompleted="SeekSlider_DragCompleted"
                            AutomationProperties.Name="재생 위치"/>
                    <TextBlock x:Name="SeekTotal" Grid.Column="2" Text="--:--" FontSize="10" Foreground="{DynamicResource MiniInkBrush}" VerticalAlignment="Center"
                               MinWidth="30" TextAlignment="Right"/>
                </Grid>
                <!-- Song title scrolls right → left like an MP3 player display. -->
                <!-- Also reachable with Tab: Enter / Space open what a click opens. -->
                <Canvas x:Name="PlayerTitleHost" Grid.Row="1" Grid.ColumnSpan="3" Height="16" Margin="4,0,4,3" ClipToBounds="True"
                        Background="Transparent" Visibility="Collapsed" Cursor="Hand" MouseLeftButtonUp="PlayerTitle_Click"
                        Focusable="True" KeyDown="PlayerTitle_KeyDown" SizeChanged="PlayerTitleHost_SizeChanged">
                    <TextBlock x:Name="PlayerTitle" FontSize="11" Foreground="{DynamicResource MiniInkBrush}">
                        <TextBlock.RenderTransform><TranslateTransform x:Name="PlayerTitleShift"/></TextBlock.RenderTransform>
                    </TextBlock>
                </Canvas>
            </Grid>
        </Border>
        <!-- Illustrated paper, with no rectangular window surface behind it. -->
        <Grid x:Name="WeekCalendar" Grid.Column="2" Margin="0,4,2,8" SizeChanged="WeekCalendar_SizeChanged"
              MouseRightButtonUp="Calendar_RightClick"
              PreviewMouseLeftButtonDown="Calendar_PreviewMouseDown" PreviewMouseMove="Calendar_PreviewMouseMove">
            <Border Margin="0,8,0,0" CornerRadius="8" Background="{DynamicResource MiniPaperBrush}" BorderBrush="{DynamicResource MiniFrameBrush}" BorderThickness="2.5">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="30"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <Border x:Name="CalendarHeader" Background="{DynamicResource MiniHeaderBrush}" CornerRadius="8,8,0,0" BorderBrush="{DynamicResource MiniFrameBrush}" BorderThickness="0,0,0,2"
                            MouseLeftButtonUp="CalendarHeader_Click" Cursor="Hand">
                        <!-- Arrows at the far ends; today beside ‹, schedule list beside ›, period label centered. -->
                        <Grid Margin="3,2,3,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Button x:Name="PreviousWeek" Style="{StaticResource WeekArrow}" Tag="-1" Click="Week_Click" AutomationProperties.Name="이전 주">
                                <Path Data="M7,1 L2,6 7,11" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                            </Button>
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <!-- Back to today's page: the same as the menu's 오늘로 이동; dimmed while today is already on the page. -->
                            <Button x:Name="TodayButton" Margin="1,0,0,0" Style="{StaticResource WeekArrow}" Click="TodayButton_Click"
                                    AutomationProperties.Name="오늘로 이동">
                                <TextBlock Text="↺" FontFamily="Segoe UI Symbol" FontSize="13" FontWeight="Bold"
                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"/>
                            </Button>
                            </StackPanel>
                            <Button x:Name="RangeLabelButton" Grid.Column="2" Width="Auto" Padding="8,0" HorizontalAlignment="Center" IsHitTestVisible="False" Style="{StaticResource WeekArrow}" Click="RangeLabel_Click"
                                    AutomationProperties.Name="표시할 날짜 수 선택">
                                <TextBlock x:Name="WeekLabel" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource MiniInkBrush}" TextTrimming="CharacterEllipsis"/>
                            </Button>
                            <!-- ⚙ settings (same as the menu's 설정), left of the TODO button. -->
                            <Button x:Name="HeaderSettingsButton" Grid.Column="3" Margin="0,0,1,0" Style="{StaticResource WeekArrow}" Click="Settings_Click" AutomationProperties.Name="설정">
                                <TextBlock Text="⚙" FontFamily="Segoe UI Symbol" FontSize="13" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"/>
                            </Button>
                            <!-- Straight back to the original TODO list window. -->
                            <Button x:Name="TodoButton" Grid.Column="4" Margin="0,0,2,0" Style="{StaticResource WeekArrow}" Click="Full_Click" ToolTip="일정 목록 열기 / 닫기" AutomationProperties.Name="일정 목록 열기 / 닫기">
                                <Path Data="M1,2.5 L2.5,4 L5,1 M1,8.5 L2.5,10 L5,7 M7.5,2.5 L13,2.5 M7.5,8.5 L13,8.5" Width="14" Height="11"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}" StrokeThickness="1.6"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                            </Button>
                            <Button x:Name="NextWeek" Grid.Column="5" Style="{StaticResource WeekArrow}" Tag="1" Click="Week_Click" AutomationProperties.Name="다음 주">
                                <Path Data="M2,1 L7,6 2,11" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                            </Button>
                        </Grid>
                    </Border>
                    <ItemsControl x:Name="WeekDays" Grid.Row="1" Margin="8,4,8,10" ClipToBounds="True" SizeChanged="WeekDays_SizeChanged"
                                  AutomationProperties.Name="선택한 기간의 달력">
                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Rows="1"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate><DataTemplate>
                            <Button Style="{StaticResource DayButton}" Tag="{Binding Date}" Click="Day_Click"
                                    ToolTip="{Binding Hint}" ToolTipService.InitialShowDelay="250" AutomationProperties.Name="{Binding Hint}">
                                <Grid>
                                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                    <StackPanel VerticalAlignment="Top">
                                        <TextBlock Text="{Binding Weekday}" HorizontalAlignment="Center" FontSize="10" Foreground="{Binding Ink}"/>
                                        <TextBlock Text="{Binding Day}" HorizontalAlignment="Center" FontSize="18" FontWeight="SemiBold" Foreground="{Binding DayInk}" Margin="0,1,0,0"/>
                                        <TextBlock Text="{Binding Holiday}" HorizontalAlignment="Center" FontSize="9" Foreground="{DynamicResource MiniHolidayBrush}" TextTrimming="CharacterEllipsis" Margin="0,1,0,0"
                                                  ToolTip="{Binding Holiday}">
                                            <TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers>
                                                <DataTrigger Binding="{Binding Holiday}" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                                            </Style.Triggers></Style></TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                    <ItemsControl Grid.Row="1" ItemsSource="{Binding TaskPreviews}" Margin="0,8,0,0" VerticalAlignment="Top">
                                        <ItemsControl.ItemTemplate><DataTemplate>
                                            <!-- Each block: left click falls through to the day button (opens the day bubble); right click opens 수정/완료/삭제. -->
                                            <Border Background="{Binding BlockColor}" CornerRadius="2" Padding="5,4" Margin="0,0,0,5"
                                                    MouseRightButtonUp="Block_RightClick" ToolTip="{Binding Hint}">
                                                <Border.Style><Style TargetType="Border"><Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsCompleted}" Value="True"><Setter Property="Opacity" Value="0.6"/></DataTrigger>
                                                </Style.Triggers></Style></Border.Style>
                                                <StackPanel>
                                                    <!-- Top line: time (if any) on the left, D-day on the right. -->
                                                    <Grid Margin="0,0,0,2">
                                                        <Grid.Style><Style TargetType="Grid"><Style.Triggers>
                                                            <DataTrigger Binding="{Binding ShowTopLine}" Value="False"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                                                        </Style.Triggers></Style></Grid.Style>
                                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                        <TextBlock Text="{Binding Time}" Foreground="{Binding BlockInk}" FontSize="10" TextTrimming="CharacterEllipsis"/>
                                                        <TextBlock Grid.Column="1" Text="{Binding DDay}" Foreground="{Binding BlockInk}" FontSize="10" FontWeight="Bold" Margin="4,0,0,0"/>
                                                    </Grid>
                                                    <TextBlock Text="{Binding Title, Converter={StaticResource KeepAll}}" Foreground="{Binding BlockInk}" FontSize="11" LineHeight="14"
                                                               TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="{Binding TitleMaxHeight}">
                                                        <TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsCompleted}" Value="True"><Setter Property="TextDecorations" Value="Strikethrough"/></DataTrigger>
                                                        </Style.Triggers></Style></TextBlock.Style>
                                                    </TextBlock>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate></ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <TextBlock Grid.Row="2" Text="{Binding MoreLabel}" FontSize="10" Foreground="{DynamicResource MiniInkBrush}" Margin="0,3,0,0">
                                        <TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers>
                                            <DataTrigger Binding="{Binding MoreLabel}" Value=""><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                                        </Style.Triggers></Style></TextBlock.Style>
                                    </TextBlock>
                                </Grid>
                            </Button>
                        </DataTemplate></ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>
            </Border>
            <!-- Two binder rings at 30% / 70% of the band, clear of the buttons at both ends. -->
            <Grid Height="24" VerticalAlignment="Top" IsHitTestVisible="False">
                <Grid.ColumnDefinitions><ColumnDefinition Width="3*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="4*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="3*"/></Grid.ColumnDefinitions>
                <Border Grid.Column="1" Width="9" Height="24" Background="{DynamicResource MiniRingBrush}" BorderBrush="{DynamicResource MiniFrameBrush}" BorderThickness="2" CornerRadius="3"/>
                <Border Grid.Column="3" Width="9" Height="24" Background="{DynamicResource MiniRingBrush}" BorderBrush="{DynamicResource MiniFrameBrush}" BorderThickness="2" CornerRadius="3"/>
            </Grid>
            <!-- Corner grips: drag any corner of the calendar to resize the mini window. The top two are smaller and sit on the
                 frame's outer corner, clear of the ‹ / › buttons (a press there used to start a resize instead of paging): they
                 end one DIP above the buttons' top (touching them, at 100 % scaling a press on the buttons' top row resized). -->
            <Thumb Tag="TL" Style="{StaticResource ResizeGrip}" Width="12" Height="12" Cursor="SizeNWSE" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="-4,1,0,0"
                   DragStarted="ResizeGrip_DragStarted" DragDelta="ResizeGrip_DragDelta" DragCompleted="ResizeGrip_DragCompleted"/>
            <Thumb Tag="TR" Style="{StaticResource ResizeGrip}" Width="12" Height="12" Cursor="SizeNESW" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,1,-4,0"
                   DragStarted="ResizeGrip_DragStarted" DragDelta="ResizeGrip_DragDelta" DragCompleted="ResizeGrip_DragCompleted"/>
            <Thumb Tag="BL" Style="{StaticResource ResizeGrip}" Cursor="SizeNESW" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="-3,0,0,-3"
                   DragStarted="ResizeGrip_DragStarted" DragDelta="ResizeGrip_DragDelta" DragCompleted="ResizeGrip_DragCompleted"/>
            <Thumb Tag="BR" Cursor="SizeNWSE" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-3,-3"
                   DragStarted="ResizeGrip_DragStarted" DragDelta="ResizeGrip_DragDelta" DragCompleted="ResizeGrip_DragCompleted">
                <Thumb.Style><Style TargetType="Thumb" BasedOn="{StaticResource ResizeGrip}">
                    <Setter Property="Template"><Setter.Value>
                        <ControlTemplate TargetType="Thumb">
                            <Grid Background="Transparent">
                                <Path Data="M13,5 L5,13 M13,9 L9,13" Stroke="{DynamicResource MiniMutedBrush}" StrokeThickness="1.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value></Setter>
                </Style></Thumb.Style>
            </Thumb>
        </Grid>
        <Popup x:Name="ActionsPopup" PlacementTarget="{Binding ElementName=CharacterView}" Placement="Top"
               AllowsTransparency="True" StaysOpen="False" PopupAnimation="Fade">
            <Border Background="{DynamicResource AuxSurfaceBrush}" BorderBrush="{DynamicResource AuxHairlineBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="14" Width="268">
                <StackPanel>
                    <!-- 캐릭터 동작 moved to the 캐릭터 설정 window (right-click a pet); kept hidden here. -->
                    <TextBlock x:Name="AnimationTitle" Visibility="Collapsed" Text="캐릭터 동작" Style="{StaticResource AuxSectionTitle}" Margin="0,0,0,8" TextTrimming="CharacterEllipsis"/>
                    <ItemsControl x:Name="AnimationButtons" Visibility="Collapsed">
                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="3"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate><DataTemplate>
                            <Button Content="{Binding Name}" Tag="{Binding Key}" ToolTip="{Binding Tip}" Click="Animation_Click" Height="30" Margin="2" Padding="3,0">
                                <Button.Style><Style TargetType="Button" BasedOn="{StaticResource AuxCompactButton}">
                                    <Style.Triggers><DataTrigger Binding="{Binding Selected}" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource AuxActionBrush}"/><Setter Property="Foreground" Value="White"/>
                                    </DataTrigger></Style.Triggers>
                                </Style></Button.Style>
                            </Button>
                        </DataTemplate></ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock x:Name="AnimationHint" Visibility="Collapsed" TextWrapping="Wrap" Style="{StaticResource AuxCaption}" Margin="2,7,0,10"/>
                    <CheckBox x:Name="PlayerVisibleToggle" Content="달력 아래 음악 막대 표시" Style="{StaticResource AuxCheckBox}" Margin="2,0,0,6"
                              Click="PlayerVisible_Click"/>
                    <CheckBox x:Name="CharacterVisibleToggle" Content="캐릭터 표시" Style="{StaticResource AuxCheckBox}" Margin="2,0,0,8"
                              Click="CharacterVisible_Click"
                              ToolTip="끄면 달력만 표시합니다. 달력을 우클릭하면 이 메뉴가, 달력 위쪽 띠를 끌면 창이 이동합니다."/>
                    <Grid Margin="2,0,2,2">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBlock x:Name="CharacterScaleLabel" Text="캐릭터 크기" Style="{StaticResource AuxCaption}" FontWeight="SemiBold" Foreground="{DynamicResource AuxInkBrush}"/>
                        <TextBlock x:Name="CharacterScaleText" Grid.Column="1" Text="100%" Style="{StaticResource AuxCaption}" Foreground="{DynamicResource AuxInkBrush}"/>
                    </Grid>
                    <Slider x:Name="CharacterScaleSlider" Minimum="50" Maximum="300" TickFrequency="10" IsSnapToTickEnabled="True"
                            IsMoveToPointEnabled="True" Margin="0,0,0,10" ValueChanged="CharacterScale_ValueChanged"
                            ToolTip="100% = 달력 높이의 절반" AutomationProperties.Name="캐릭터 크기"/>
                    <Button Content="일정 목록 열기 / 닫기" Height="34" Margin="0,0,0,6" Style="{StaticResource AuxPrimaryButton}" Click="Full_Click"/>
                    <Button Content="캐릭터 설정" Height="32" Margin="0,0,0,6" Style="{StaticResource AuxCompactButton}" Click="PetSettingsMenu_Click"/>
                    <!-- Up to three pets side by side; the one right-clicked is the one these buttons act on. -->
                    <UniformGrid x:Name="CharacterSlotButtons" Columns="2" Margin="0,0,0,6">
                        <Button x:Name="AddCharacterButton" Content="캐릭터 추가" Height="32" Margin="0,0,4,0" Style="{StaticResource AuxCompactButton}" Click="AddCharacter_Click"/>
                        <Button x:Name="RemoveCharacterButton" Content="이 캐릭터 빼기" Height="32" Margin="4,0,0,0" Style="{StaticResource AuxCompactButton}" Click="RemoveCharacter_Click"/>
                    </UniformGrid>
                    <UniformGrid Columns="2">
                        <Button Content="음악" Height="32" Margin="0,0,4,0" Style="{StaticResource AuxCompactButton}" Click="Music_Click" PreviewMouseRightButtonUp="Music_RightClick" ToolTip="좌클릭: 음악 창 · 우클릭: 반복, 랜덤, 곡 선택"/>
                        <Button Content="연락 · 알림" Height="32" Margin="4,0,0,0" Style="{StaticResource AuxCompactButton}" Click="Contacts_Click"/>
                    </UniformGrid>
                    <!-- Bottom row: 설정 bottom-left, 종료 bottom-right. -->
                    <Grid Margin="0,8,0,0">
                        <Button Content="종료" Height="30" HorizontalAlignment="Right"
                                Style="{StaticResource AuxCompactButton}" Click="Exit_Click"/>
                        <Button x:Name="SettingsMenuButton" Height="30" HorizontalAlignment="Left" AutomationProperties.Name="설정"
                                Style="{StaticResource AuxCompactButton}" Click="Settings_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="⚙" FontFamily="Segoe UI Symbol" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                <TextBlock Text="설정" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </Grid>
                </StackPanel>
            </Border>
        </Popup>
        <!-- Style (theme) dropdown next to the left arrow. -->
        <Popup x:Name="RangePopup" PlacementTarget="{Binding ElementName=RangeLabelButton}" Placement="Bottom" VerticalOffset="4"
               AllowsTransparency="True" StaysOpen="False" PopupAnimation="Fade">
            <Border Background="{DynamicResource AuxSurfaceBrush}" BorderBrush="{DynamicResource AuxHairlineBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="12" Width="286">
                <StackPanel>
                    <TextBlock Text="며칠씩 보여 줄까요?" Style="{StaticResource AuxSectionTitle}" Margin="0,0,0,8"/>
                    <ItemsControl x:Name="DayCountButtons" AutomationProperties.Name="표시할 날짜 수">
                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Rows="1"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate><DataTemplate>
                            <Button Content="{Binding Label}" Tag="{Binding Count}" Click="DayCount_Click" Height="30" Margin="1.5" Padding="0" FontSize="11"
                                    AutomationProperties.Name="{Binding Label}">
                                <Button.Style><Style TargetType="Button" BasedOn="{StaticResource AuxCompactButton}">
                                    <Style.Triggers><DataTrigger Binding="{Binding Selected}" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource AuxActionBrush}"/><Setter Property="Foreground" Value="White"/>
                                    </DataTrigger></Style.Triggers>
                                </Style></Button.Style>
                            </Button>
                        </DataTemplate></ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="화살표를 누르면 선택한 일수만큼 이동합니다." TextWrapping="Wrap" Style="{StaticResource AuxCaption}" FontSize="11" Margin="2,7,0,8"/>
                    <StackPanel Orientation="Horizontal">
                        <Button Content="오늘로 이동" Height="30" Padding="10,0" Margin="0,0,6,0"
                                Style="{StaticResource AuxCompactButton}" Click="Today_Click"/>
                        <Button x:Name="RangeCalendarButton" Content="달력" Height="30" Padding="12,0"
                                Style="{StaticResource AuxCompactButton}" Click="RangeCalendarButton_Click"
                                ToolTip="날짜를 고르면 그 날짜를 기준으로 선택한 일수만큼 보여줍니다"/>
                    </StackPanel>
                    <Calendar x:Name="RangeCalendar" Visibility="Collapsed" Margin="0,8,0,0" HorizontalAlignment="Center"
                              SelectionMode="SingleDate" SelectedDatesChanged="RangeCalendar_SelectedDatesChanged"
                              AutomationProperties.Name="기준 날짜 선택"/>
                </StackPanel>
            </Border>
        </Popup>
        <!-- Now-playing list: opened from the song title under the player bar. Separate from the playlist settings window. -->
        <Popup x:Name="QueuePopup" PlacementTarget="{Binding ElementName=PlayerBar}" Placement="Top" VerticalOffset="-4"
               AllowsTransparency="True" StaysOpen="False" PopupAnimation="Fade">
            <Border Background="{DynamicResource AuxSurfaceBrush}" BorderBrush="{DynamicResource AuxHairlineBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="12" Width="330">
                <StackPanel>
                    <TextBlock x:Name="QueueTitle" Text="지금 재생 목록" Style="{StaticResource AuxSectionTitle}" Margin="0,0,0,4"/>
                    <StackPanel x:Name="QueueSection">
                    <TextBlock Text="곡을 누르면 재생 · ▲▼로 순서 변경" Style="{StaticResource AuxCaption}" FontSize="11" Margin="0,0,0,8"/>
                    <!-- Virtualized (a YouTube playlist can hold thousands of songs): only the rows in view are built. -->
                    <ItemsControl x:Name="QueueList" MaxHeight="260" VirtualizingPanel.IsVirtualizing="True"
                                  VirtualizingPanel.VirtualizationMode="Recycling" VirtualizingPanel.ScrollUnit="Item">
                        <ItemsControl.Template><ControlTemplate TargetType="ItemsControl">
                            <ScrollViewer x:Name="QueueScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                          CanContentScroll="True" Focusable="False">
                                <ItemsPresenter/>
                            </ScrollViewer>
                        </ControlTemplate></ItemsControl.Template>
                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><VirtualizingStackPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate><DataTemplate>
                            <Grid Margin="0,1">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <Button Click="QueuePlay_Click" HorizontalContentAlignment="Left" Padding="6,4" MinHeight="28"
                                        ToolTip="{Binding Title}" AutomationProperties.Name="{Binding Title}">
                                    <Button.Style><Style TargetType="Button" BasedOn="{StaticResource AuxCompactButton}">
                                        <Setter Property="BorderBrush" Value="Transparent"/>
                                        <Style.Triggers><DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource MiniHeaderBrush}"/><Setter Property="FontWeight" Value="SemiBold"/>
                                        </DataTrigger></Style.Triggers>
                                    </Style></Button.Style>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Marker}" Width="18" Foreground="{DynamicResource MiniFrameBrush}"/>
                                        <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" MaxWidth="200"/>
                                    </StackPanel>
                                </Button>
                                <Button Grid.Column="1" Tag="-1" Click="QueueMove_Click" Width="26" Height="26" MinHeight="26" Padding="0" Margin="3,0,0,0"
                                        Style="{StaticResource AuxCompactButton}" ToolTip="위로" AutomationProperties.Name="위로"
                                        IsEnabled="{Binding CanUp}">
                                    <Path Data="M1,6 L5,2 L9,6" Stroke="{DynamicResource AuxInkBrush}" StrokeThickness="1.5"/>
                                </Button>
                                <Button Grid.Column="2" Tag="1" Click="QueueMove_Click" Width="26" Height="26" MinHeight="26" Padding="0" Margin="3,0,0,0"
                                        Style="{StaticResource AuxCompactButton}" ToolTip="아래로" AutomationProperties.Name="아래로"
                                        IsEnabled="{Binding CanDown}">
                                    <Path Data="M1,2 L5,6 L9,2" Stroke="{DynamicResource AuxInkBrush}" StrokeThickness="1.5"/>
                                </Button>
                            </Grid>
                        </DataTemplate></ItemsControl.ItemTemplate>
                    </ItemsControl>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Popup>
        <!-- Volume bar: a vertical bar centred above the speaker while the pointer is on the speaker or on the bar (a click on
             the speaker mutes / unmutes). The nearly transparent strip under the card touches the button, so the pointer can
             move up onto the bar without leaving both (fully transparent pixels would let it fall through). -->
        <Popup x:Name="VolumePopup" PlacementTarget="{Binding ElementName=PlayerVolume}" Placement="Custom"
               AllowsTransparency="True" StaysOpen="True" PopupAnimation="Fade">
            <Grid x:Name="VolumeBar" Background="#01FFFFFF" MouseEnter="PlayerVolume_HoverChanged" MouseLeave="PlayerVolume_HoverChanged">
                <Border Margin="0,0,0,6" Background="{DynamicResource AuxSurfaceBrush}" BorderBrush="{DynamicResource AuxHairlineBrush}"
                        BorderThickness="1" CornerRadius="10" Padding="6,8,6,10">
                    <StackPanel>
                        <TextBlock x:Name="VolumeText" MinWidth="32" TextAlignment="Center" HorizontalAlignment="Center" Margin="0,0,0,6"
                                   Style="{StaticResource AuxCaption}" Foreground="{DynamicResource AuxInkBrush}"/>
                        <Slider x:Name="VolumeSlider" Orientation="Vertical" Height="110" HorizontalAlignment="Center"
                                Minimum="0" Maximum="100" SmallChange="5" LargeChange="10" IsMoveToPointEnabled="True"
                                ValueChanged="VolumeSlider_ValueChanged" AutomationProperties.Name="음량"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Popup>
        <!-- Source dropdown (Apple-style): card, 1px hairline, no shadow; the chosen source is marked in the theme's action
             color for text (readable on the card in every theme).
             Section 1: the widget's playlists. Section 2: other apps playing media right now (browser YouTube, …). -->
        <Popup x:Name="PlaylistPopup" PlacementTarget="{Binding ElementName=PlayerPlaylist}" Placement="Top" VerticalOffset="-6"
               AllowsTransparency="True" StaysOpen="False" PopupAnimation="Fade">
            <Popup.Resources>
                <DataTemplate x:Key="SourceRow">
                    <Button Click="PlaylistChoice_Click" AutomationProperties.Name="{Binding Name}" Cursor="Hand" FocusVisualStyle="{x:Null}">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="Row" Background="Transparent" CornerRadius="8" Padding="10,7" RenderTransformOrigin="0.5,0.5">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="18"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <Path x:Name="Check" Data="M1,5 L4,8 L10,1" Stroke="{DynamicResource AuxActionTextBrush}" StrokeThickness="1.8" StrokeStartLineCap="Round"
                                              StrokeEndLineCap="Round" StrokeLineJoin="Round" VerticalAlignment="Center" Visibility="Hidden"/>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock x:Name="Name" Text="{Binding Name}" FontFamily="Segoe UI" FontSize="13" Foreground="{DynamicResource AuxInkBrush}"
                                                       TextTrimming="CharacterEllipsis" MaxWidth="230"/>
                                            <TextBlock x:Name="Sub" Text="{Binding Sub}" FontFamily="Segoe UI" FontSize="11" Foreground="{DynamicResource AuxMutedBrush}"
                                                       TextTrimming="CharacterEllipsis" MaxWidth="230" Margin="0,1,0,0"/>
                                        </StackPanel>
                                        <TextBlock Grid.Column="2" Text="{Binding CountLabel}" FontFamily="Segoe UI" FontSize="11" Foreground="{DynamicResource AuxMutedBrush}"
                                                   Margin="12,0,0,0" VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Row" Property="Background" Value="{DynamicResource AuxCanvasBrush}"/></Trigger>
                                    <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Row" Property="Background" Value="{DynamicResource AuxCanvasBrush}"/></Trigger>
                                    <Trigger Property="IsPressed" Value="True"><Setter TargetName="Row" Property="RenderTransform"><Setter.Value><ScaleTransform ScaleX="0.97" ScaleY="0.97"/></Setter.Value></Setter></Trigger>
                                    <DataTrigger Binding="{Binding Sub}" Value=""><Setter TargetName="Sub" Property="Visibility" Value="Collapsed"/></DataTrigger>
                                    <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                        <Setter TargetName="Check" Property="Visibility" Value="Visible"/>
                                        <Setter TargetName="Name" Property="Foreground" Value="{DynamicResource AuxActionTextBrush}"/>
                                        <Setter TargetName="Name" Property="FontWeight" Value="SemiBold"/>
                                    </DataTrigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </DataTemplate>
            </Popup.Resources>
            <Border Background="{DynamicResource AuxSurfaceBrush}" BorderBrush="{DynamicResource AuxHairlineBrush}" BorderThickness="1" CornerRadius="12" Padding="6" MinWidth="220">
                <ScrollViewer MaxHeight="320" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="재생목록" FontFamily="Segoe UI" FontSize="11" Foreground="{DynamicResource AuxMutedBrush}" Margin="10,4,0,4"/>
                        <ItemsControl x:Name="PlaylistChoices" ItemTemplate="{StaticResource SourceRow}"/>
                        <StackPanel x:Name="AppChoicesSection">
                            <Border Height="1" Background="{DynamicResource AuxHairlineBrush}" Margin="8,6"/>
                            <TextBlock Text="다른 앱에서 재생 중" FontFamily="Segoe UI" FontSize="11" Foreground="{DynamicResource AuxMutedBrush}" Margin="10,2,0,4"/>
                            <ItemsControl x:Name="AppChoices" ItemTemplate="{StaticResource SourceRow}"/>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Popup>
        <!-- › hover: summary of the schedules after this page; content and placement in MiniWindow.UpcomingPreview.cs. -->
        <Popup x:Name="UpcomingPopup" Placement="Custom" AllowsTransparency="True" StaysOpen="True" Focusable="False" PopupAnimation="Fade"/>
        <!-- Right-click menu for one schedule block: a small speech bubble above the block with 수정 / 완료 / 삭제. -->
        <Popup x:Name="BlockPopup" Placement="Custom" AllowsTransparency="True" StaysOpen="False" PopupAnimation="Fade">
            <Grid x:Name="BlockBubble" PreviewKeyDown="BlockPopup_KeyDown">
                <Border Background="{DynamicResource AuxSurfaceBrush}" BorderBrush="{DynamicResource AuxHairlineBrush}"
                        BorderThickness="1" CornerRadius="10" Padding="10,8" Margin="0,0,0,9">
                    <StackPanel>
                        <TextBlock x:Name="BlockPopupTitle" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource AuxInkBrush}"
                                   MaxWidth="210" TextTrimming="CharacterEllipsis" Margin="0,0,0,6"/>
                        <StackPanel Orientation="Horizontal">
                            <Button x:Name="BlockEdit" Content="수정" Height="26" MinHeight="26" Padding="10,0" FontSize="11"
                                    Style="{StaticResource AuxCompactButton}" Click="BlockEdit_Click"/>
                            <Button x:Name="BlockDone" Content="완료" Width="52" Height="26" Margin="4,0,0,0"
                                    Style="{StaticResource BubbleDoneButton}" Click="BlockDone_Click"/>
                            <Button x:Name="BlockDelete" Content="삭제" MinWidth="44" Height="26" Margin="4,0,0,0"
                                    Style="{StaticResource BubbleDeleteButton}" Click="BlockDelete_Click" ToolTip="한 번 더 누르면 삭제됩니다"/>
                        </StackPanel>
                        <!-- While 삭제 waits for its second press: what that does on Google Calendar, for a linked schedule. -->
                        <TextBlock x:Name="BlockDeleteNote" Visibility="Collapsed" Style="{StaticResource AuxCaption}" FontSize="11"
                                   MaxWidth="210" TextWrapping="Wrap" HorizontalAlignment="Left" Margin="0,6,0,0"/>
                    </StackPanel>
                </Border>
                <Path Data="M0,0 L9,9 L18,0" Width="18" Height="10" Fill="{DynamicResource AuxSurfaceBrush}"
                      Stroke="{DynamicResource AuxHairlineBrush}" StrokeThickness="1"
                      HorizontalAlignment="Center" VerticalAlignment="Bottom" IsHitTestVisible="False"/>
            </Grid>
        </Popup>
        <Popup x:Name="DayPopup" Placement="Top" AllowsTransparency="True" StaysOpen="False"
               PopupAnimation="Fade" Opened="DayPopup_Opened" Closed="DayPopup_Closed">
            <Grid x:Name="DayBubble" Width="380" PreviewKeyDown="DayPopup_KeyDown" GotKeyboardFocus="DayBubble_GotKeyboardFocus" SizeChanged="DayBubble_SizeChanged">
            <Border x:Name="DayBubbleFace" Background="{DynamicResource AuxSurfaceBrush}" BorderBrush="{DynamicResource AuxHairlineBrush}"
                    BorderThickness="1" CornerRadius="12" Padding="16" Margin="0,0,0,10">
                <StackPanel>
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBlock x:Name="DayPopupTitle" Style="{StaticResource AuxSectionTitle}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <Button x:Name="CloseDayBubble" Grid.Column="1" Width="28" Height="28" Padding="0" MinHeight="28"
                                Style="{StaticResource AuxCompactButton}" Click="CloseDayPopup_Click" ToolTip="닫기" AutomationProperties.Name="일정 말풍선 닫기">
                            <Path Data="M1,1 L11,11 M11,1 L1,11" Stroke="{DynamicResource AuxInkBrush}" StrokeThickness="1.5" Width="12" Height="12"/>
                        </Button>
                    </Grid>
                    <ScrollViewer MaxHeight="220" VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="DaySchedules">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,5,0,5">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Title, Converter={StaticResource KeepAll}}" Foreground="{DynamicResource AuxInkBrush}" TextWrapping="Wrap" FontSize="13" Margin="0,0,8,0">
                                                <TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsCompleted}" Value="True"><Setter Property="TextDecorations" Value="Strikethrough"/></DataTrigger>
                                                </Style.Triggers></Style></TextBlock.Style>
                                            </TextBlock>
                                            <TextBlock Text="{Binding DateString}" Foreground="{DynamicResource AuxMutedBrush}" FontSize="11" Margin="0,3,0,0"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Button Width="52" Height="26" Margin="6,0,0,0" Padding="2,0" FontSize="11"
                                                    Click="CompleteMiniSchedule_Click">
                                                <Button.Style><Style TargetType="Button" BasedOn="{StaticResource BubbleDoneButton}">
                                                    <Setter Property="Content" Value="완료"/>
                                                    <Setter Property="ToolTip" Value="완료로 표시"/>
                                                    <Style.Triggers><DataTrigger Binding="{Binding IsCompleted}" Value="True">
                                                        <Setter Property="Content" Value="미완료"/>
                                                        <Setter Property="ToolTip" Value="완료 표시 취소"/>
                                                    </DataTrigger></Style.Triggers>
                                                </Style></Button.Style>
                                            </Button>
                                            <Button Content="수정" Width="44" Height="26" Margin="4,0,0,0"
                                                    Padding="2,0" FontSize="11" Style="{StaticResource AuxCompactButton}"
                                                    Click="EditMiniSchedule_Click"/>
                                            <Button Content="삭제" MinWidth="44" Height="26" Margin="4,0,0,0"
                                                    Padding="4,0" FontSize="11" Style="{StaticResource BubbleDeleteButton}"
                                                    Click="DeleteMiniSchedule_Click" ToolTip="한 번 더 누르면 삭제됩니다"/>
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                    <TextBlock x:Name="MiniScheduleEmpty" Text="이 날에는 일정이 없습니다." Style="{StaticResource AuxCaption}"
                               FontSize="11" Margin="0,2,0,5"/>
                    <!-- While a row's 삭제 waits for its second press: what that does on Google Calendar, for a linked schedule. -->
                    <TextBlock x:Name="DayDeleteNote" Visibility="Collapsed" Style="{StaticResource AuxCaption}" FontSize="11"
                               TextWrapping="Wrap" Margin="0,2,0,6"/>
                    <Button Content="새 일정" Height="30" Padding="8,0" HorizontalAlignment="Left"
                            Style="{StaticResource AuxCompactButton}" Click="NewMiniSchedule_Click"/>
                    <StackPanel x:Name="MiniEditorPanel" Visibility="Collapsed">
                    <Separator Margin="0,8,0,7"/>
                    <TextBlock Text="제목" Style="{StaticResource AuxCaption}" FontSize="11"/>
                    <TextBox x:Name="MiniTitleInput" MaxHeight="120" Padding="10,5" Margin="0,3,0,7" Style="{StaticResource AuxTextBox}"
                             TextWrapping="Wrap" AcceptsReturn="False" VerticalScrollBarVisibility="Auto"
                             AutomationProperties.Name="미니 일정 제목"/>
                    <TextBlock Text="날짜" Style="{StaticResource AuxCaption}" FontSize="11"/>
                    <!-- SafeDatePicker: a DatePicker that screen readers / UI Automation can't crash (this one sits in a popup). -->
                    <local:SafeDatePicker x:Name="MiniDateInput" Height="34" Margin="0,3,0,3" SelectedDateFormat="Short"
                                SelectedDateChanged="MiniDateInput_SelectedDateChanged" PreviewTextInput="MiniDateInput_EditStarted"
                                PreviewKeyDown="MiniDateInput_EditKey" DataObject.Pasting="MiniDateInput_Pasting"
                                CalendarOpened="MiniDateInput_CalendarOpened" CalendarClosed="MiniDateInput_CalendarClosed"
                                DateValidationError="MiniDateInput_DateValidationError" AutomationProperties.Name="미니 일정 날짜"/>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,2,0,3">
                        <CheckBox x:Name="MiniTimeToggle" Content="시간 지정" IsChecked="False" Style="{StaticResource AuxCheckBox}"
                                  Checked="MiniTimeToggle_Changed" Unchecked="MiniTimeToggle_Changed"/>
                        <TextBox x:Name="MiniTimeInput" Text="09:00" Width="72" Height="36" Padding="8,2" Margin="8,0,0,0"
                                 IsEnabled="False" Style="{StaticResource AuxTextBox}" AutomationProperties.Name="미니 일정 시간"/>
                        <!-- 여러 날: shows 종료 날짜 below (10/8 ~ 10/10). -->
                        <CheckBox x:Name="MiniRangeToggle" Content="여러 날" IsChecked="False" Style="{StaticResource AuxCheckBox}" Margin="14,0,0,0"
                                  ToolTip="여러 날 이어지는 일정 (종료 날짜 선택)" Checked="MiniRangeToggle_Changed" Unchecked="MiniRangeToggle_Changed"/>
                    </StackPanel>
                    <StackPanel x:Name="MiniEndPanel" Visibility="Collapsed">
                        <TextBlock Text="종료 날짜" Style="{StaticResource AuxCaption}" FontSize="11"/>
                        <local:SafeDatePicker x:Name="MiniEndDateInput" Height="34" Margin="0,3,0,3" SelectedDateFormat="Short"
                                    SelectedDateChanged="MiniEndDateInput_SelectedDateChanged" PreviewTextInput="MiniEndDateInput_EditStarted"
                                    CalendarOpened="MiniDateInput_CalendarOpened" CalendarClosed="MiniDateInput_CalendarClosed"
                                    DateValidationError="MiniEndDateInput_DateValidationError" AutomationProperties.Name="미니 일정 종료 날짜"/>
                    </StackPanel>
                    <TextBlock x:Name="MiniEditorMessage" TextWrapping="Wrap" Style="{StaticResource AuxCaption}"
                               Foreground="{DynamicResource AuxActionBrush}" FontSize="10" Margin="0,1,0,5"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="취소" Width="58" Height="28" Margin="0,0,6,0" Padding="4,0"
                                Style="{StaticResource AuxCancelCompactButton}" Click="CancelMiniSchedule_Click"/>
                        <Button Content="저장" Width="58" Height="28" Padding="4,0"
                                Style="{StaticResource AuxSaveCompactButton}" Click="SaveMiniSchedule_Click"/>
                    </StackPanel>
                    </StackPanel>
                    <!-- The editor's message line while the editor is folded away: what 완료, 삭제 or 저장 just did ("…일정을
                         삭제했습니다."). The open editor shows it in its own place above; no message, no line. -->
                    <TextBlock x:Name="MiniStatusMessage" Text="{Binding Text, ElementName=MiniEditorMessage}" TextWrapping="Wrap"
                               Foreground="{DynamicResource AuxActionBrush}" FontSize="10" Margin="0,7,0,0">
                        <TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource AuxCaption}"><Style.Triggers>
                            <DataTrigger Binding="{Binding Visibility, ElementName=MiniEditorPanel}" Value="{x:Static Visibility.Visible}">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Text, RelativeSource={RelativeSource Self}}" Value="">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </Style.Triggers></Style></TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </Border>
                <Path x:Name="DayBubbleTail" Data="M0,0 L12,11 L24,0" Width="24" Height="12"
                      Fill="{DynamicResource AuxSurfaceBrush}" Stroke="{DynamicResource AuxHairlineBrush}" StrokeThickness="1"
                      VerticalAlignment="Bottom" HorizontalAlignment="Left" Margin="158,0,0,0" IsHitTestVisible="False"/>
            </Grid>
        </Popup>
    </Grid>
        <!-- Pets float over the whole window: anywhere around the calendar (or on it). The WebView only draws them
             and never takes the mouse; the invisible PetHit boxes over each pet do (left click 캐릭터 선택, right click
             캐릭터 설정; dragging a pet only in 드래그로 위치 설정 — the window moves by the calendar's top band). -->
        <Canvas x:Name="CharacterHost" ClipToBounds="False"
                PreviewMouseLeftButtonDown="Character_MouseDown" PreviewMouseMove="Character_MouseMove"
                PreviewMouseLeftButtonUp="Character_MouseUp" PreviewMouseRightButtonUp="Character_RightClick">
            <wv:WebView2CompositionControl x:Name="CharacterView" Width="120" Height="130" IsHitTestVisible="False"
                Background="Transparent" AllowExternalDrop="False"
                AutomationProperties.Name="캐릭터 · 좌클릭 캐릭터 선택, 우클릭 캐릭터 설정"/>
            <!-- #01000000, not Transparent: this is a layered (AllowsTransparency) window, and Windows sends a click on a fully
                 transparent pixel to the window behind. With Transparent boxes, clicks between the sprite's drawn pixels (or
                 while a frame was being swapped) went through the pet: left / right clicks worked only now and then. Black at
                 alpha 1: it still takes the clicks, and captures as pure black, so the "pets vanished" pixel check (ReadPetPixels)
                 still sees an empty pet as empty. -->
            <Border x:Name="PetHit0" Background="#01000000" Cursor="Hand" Visibility="Collapsed"/>
            <Border x:Name="PetHit1" Background="#01000000" Cursor="Hand" Visibility="Collapsed"/>
            <Border x:Name="PetHit2" Background="#01000000" Cursor="Hand" Visibility="Collapsed"/>
            <TextBlock x:Name="CharacterError" Visibility="Collapsed" TextWrapping="Wrap" FontSize="11" MaxWidth="160"
                Foreground="{DynamicResource MiniFrameBrush}" Background="{DynamicResource MiniPaperBrush}" Padding="6"/>
        </Canvas>
        <!-- 드래그로 위치 설정 (from 캐릭터 설정, or 캐릭터 선택 opened for a pet): shown above the calendar (outside it) while
             pets can be dragged; below it, or on it, only when the screen has no room above. Placed by PlacePlacementBanner.
             After CharacterHost, so a pet dragged under it never blocks 완료. -->
        <Border x:Name="PlacementBanner" VerticalAlignment="Top" HorizontalAlignment="Center" Margin="8,44,8,0"
                Visibility="Collapsed" Background="{DynamicResource AuxSurfaceBrush}" BorderBrush="{DynamicResource MiniFrameBrush}"
                BorderThickness="1.5" CornerRadius="8" Padding="10,8">
            <StackPanel>
                <TextBlock x:Name="PlacementBannerText" Text="캐릭터를 끌어서 원하는 자리에 놓으세요" Style="{StaticResource AuxCaption}" FontWeight="SemiBold"
                           Foreground="{DynamicResource AuxInkBrush}" TextWrapping="Wrap" Margin="0,0,0,6"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="처음 배치로" Height="28" Padding="10,0" Margin="0,0,6,0" Style="{StaticResource AuxCompactButton}" Click="PlacementReset_Click"/>
                    <Button Content="완료" Height="28" Padding="14,0" Style="{StaticResource AuxPrimaryButton}" Click="PlacementDone_Click"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</Window>
