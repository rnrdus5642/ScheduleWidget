<Window x:Class="ScheduleWidget.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="설정" Height="320" Width="340"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        WindowStyle="SingleBorderWindow">

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">

            <!-- 투명도 -->
            <TextBlock Text="투명도" FontWeight="Bold" FontSize="14" Margin="0,0,0,5"/>
            <DockPanel Margin="0,0,0,15">
                <TextBlock x:Name="OpacityValueText" DockPanel.Dock="Right" Width="35" TextAlignment="Right"
                           VerticalAlignment="Center" Text="100%"/>
                <Slider x:Name="OpacitySlider" Minimum="30" Maximum="100" Value="100"
                        TickFrequency="5" IsSnapToTickEnabled="True"
                        ValueChanged="OpacitySlider_ValueChanged"/>
            </DockPanel>

            <!-- 테마 프리셋 -->
            <TextBlock Text="테마 프리셋" FontWeight="Bold" FontSize="14" Margin="0,0,0,5"/>
            <ComboBox x:Name="PresetCombo" Width="200" HorizontalAlignment="Left" Margin="0,0,0,15"
                      SelectionChanged="PresetCombo_SelectionChanged">
                <ComboBoxItem Content="Light"/>
                <ComboBoxItem Content="Dark"/>
                <ComboBoxItem Content="Blue"/>
                <ComboBoxItem Content="Pink"/>
            </ComboBox>

            <!-- 폰트 크기 -->
            <TextBlock Text="폰트 크기" FontWeight="Bold" FontSize="14" Margin="0,0,0,5"/>
            <DockPanel Margin="0,0,0,5">
                <TextBlock Text="제목" Width="60" VerticalAlignment="Center"/>
                <TextBlock x:Name="TitleFontSizeText" DockPanel.Dock="Right" Width="25" TextAlignment="Right"
                           VerticalAlignment="Center"/>
                <Slider x:Name="TitleFontSizeSlider" Minimum="10" Maximum="24" Value="14"
                        TickFrequency="1" IsSnapToTickEnabled="True"
                        ValueChanged="FontSizeSlider_ValueChanged"/>
            </DockPanel>
            <DockPanel Margin="0,0,0,10">
                <TextBlock Text="D-Day" Width="60" VerticalAlignment="Center"/>
                <TextBlock x:Name="DDayFontSizeText" DockPanel.Dock="Right" Width="25" TextAlignment="Right"
                           VerticalAlignment="Center"/>
                <Slider x:Name="DDayFontSizeSlider" Minimum="10" Maximum="24" Value="13"
                        TickFrequency="1" IsSnapToTickEnabled="True"
                        ValueChanged="FontSizeSlider_ValueChanged"/>
            </DockPanel>

        </StackPanel>

        <!-- 하단 버튼 -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="확인" Width="70" Height="28" Margin="0,0,8,0" Click="ApplyButton_Click"/>
            <Button Content="취소" Width="70" Height="28" Click="CancelButton_Click"/>
        </StackPanel>
    </Grid>
</Window>
