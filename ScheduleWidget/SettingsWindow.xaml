<Window x:Class="ScheduleWidget.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:ScheduleWidget"
        Title="설정"
        Height="390"
        Width="380"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        WindowStyle="SingleBorderWindow"
        Background="{DynamicResource BackgroundBrush}"
        Foreground="{DynamicResource TextBrush}"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">

    <Grid Margin="22,20,22,18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="위젯 꾸미기"
                       FontSize="22"
                       FontWeight="Bold"
                       Foreground="{DynamicResource TextBrush}"/>
            <TextBlock Text="분위기와 글꼴을 원하는 대로 조절해 보세요."
                       FontSize="11"
                       Foreground="{DynamicResource SubTextBrush}"
                       Margin="0,5,0,0"/>
        </StackPanel>

        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      Margin="0,20,0,16"
                      CanContentScroll="True">
            <StackPanel>
                <Grid Margin="0,0,0,7">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="투명도"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextBrush}"
                               VerticalAlignment="Center"/>
                    <TextBlock x:Name="OpacityValueText"
                               Grid.Column="1"
                               TextAlignment="Right"
                               Foreground="{DynamicResource AccentBrush}"
                               FontWeight="SemiBold"
                               Text="100%"/>
                </Grid>
                <Slider x:Name="OpacitySlider"
                        Minimum="30"
                        Maximum="100"
                        Value="100"
                        TickFrequency="5"
                        IsSnapToTickEnabled="True"
                        IsMoveToPointEnabled="True"
                        local:SliderInteraction.EnableMouseDrag="True"
                        Foreground="{DynamicResource AccentBrush}"
                        ValueChanged="OpacitySlider_ValueChanged"/>

                <TextBlock Text="테마 프리셋"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TextBrush}"
                           Margin="0,22,0,7"/>
                <ComboBox x:Name="PresetCombo"
                          Height="34"
                          HorizontalAlignment="Stretch"
                          Style="{StaticResource WidgetComboBox}"
                          SelectionChanged="PresetCombo_SelectionChanged">
                    <ComboBoxItem Content="Light"/>
                    <ComboBoxItem Content="Dark"/>
                    <ComboBoxItem Content="Blue"/>
                    <ComboBoxItem Content="Pink"/>
                </ComboBox>

                <TextBlock Text="폰트 크기"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TextBrush}"
                           Margin="0,22,0,10"/>
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="55"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="28"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="제목"
                               Foreground="{DynamicResource SubTextBrush}"
                               VerticalAlignment="Center"/>
                    <Slider x:Name="TitleFontSizeSlider"
                            Grid.Column="1"
                            Minimum="10"
                            Maximum="24"
                            Value="14"
                            TickFrequency="1"
                            IsSnapToTickEnabled="True"
                            IsMoveToPointEnabled="True"
                            local:SliderInteraction.EnableMouseDrag="True"
                            Foreground="{DynamicResource AccentBrush}"
                            VerticalAlignment="Center"
                            ValueChanged="FontSizeSlider_ValueChanged"/>
                    <TextBlock x:Name="TitleFontSizeText"
                               Grid.Column="2"
                               TextAlignment="Right"
                               Foreground="{DynamicResource AccentBrush}"
                               VerticalAlignment="Center"/>
                </Grid>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="55"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="28"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="D-Day"
                               Foreground="{DynamicResource SubTextBrush}"
                               VerticalAlignment="Center"/>
                    <Slider x:Name="DDayFontSizeSlider"
                            Grid.Column="1"
                            Minimum="10"
                            Maximum="24"
                            Value="13"
                            TickFrequency="1"
                            IsSnapToTickEnabled="True"
                            IsMoveToPointEnabled="True"
                            local:SliderInteraction.EnableMouseDrag="True"
                            Foreground="{DynamicResource AccentBrush}"
                            VerticalAlignment="Center"
                            ValueChanged="FontSizeSlider_ValueChanged"/>
                    <TextBlock x:Name="DDayFontSizeText"
                               Grid.Column="2"
                               TextAlignment="Right"
                               Foreground="{DynamicResource AccentBrush}"
                               VerticalAlignment="Center"/>
                </Grid>
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right">
            <Button Content="취소"
                    Width="78"
                    Height="34"
                    Margin="0,0,8,0"
                    Style="{StaticResource WidgetSecondaryButton}"
                    Click="CancelButton_Click"/>
            <Button Content="확인"
                    Width="78"
                    Height="34"
                    Style="{StaticResource WidgetPrimaryButton}"
                    Click="ApplyButton_Click"/>
        </StackPanel>
    </Grid>
</Window>
