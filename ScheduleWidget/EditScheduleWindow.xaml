<Window x:Class="ScheduleWidget.EditScheduleWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="일정 수정" Height="180" Width="300"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        WindowStyle="SingleBorderWindow">

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 제목 -->
        <DockPanel Grid.Row="0" Margin="0,0,0,10">
            <TextBlock Text="제목" Width="40" VerticalAlignment="Center"/>
            <TextBox x:Name="TitleInput" Height="25"/>
        </DockPanel>

        <!-- 날짜 -->
        <DockPanel Grid.Row="1" Margin="0,0,0,10">
            <TextBlock Text="날짜" Width="40" VerticalAlignment="Center"/>
            <StackPanel Orientation="Horizontal">
                <ComboBox x:Name="YearCombo" Width="70" Height="25" Margin="0,0,5,0" IsEditable="True"/>
                <ComboBox x:Name="MonthCombo" Width="50" Height="25" Margin="0,0,5,0"/>
                <ComboBox x:Name="DayCombo" Width="50" Height="25"/>
            </StackPanel>
        </DockPanel>

        <!-- 버튼 -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="확인" Width="70" Height="28" Margin="0,0,8,0" Click="OkButton_Click"/>
            <Button Content="취소" Width="70" Height="28" Click="CancelButton_Click"/>
        </StackPanel>
    </Grid>
</Window>
