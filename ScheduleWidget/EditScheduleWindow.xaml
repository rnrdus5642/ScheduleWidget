<Window x:Class="ScheduleWidget.EditScheduleWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="일정 수정"
        Height="280"
        Width="360"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        WindowStyle="SingleBorderWindow"
        Background="{DynamicResource BackgroundBrush}"
        Foreground="{DynamicResource TextBrush}"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">

    <Window.Resources>
        <Style x:Key="EditDateComboBox"
               TargetType="{x:Type ComboBox}"
               BasedOn="{StaticResource WidgetComboBox}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="Tag" Value="HideArrow"/>
        </Style>
    </Window.Resources>

    <Grid Margin="22,20,22,18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="일정 수정"
                       FontSize="22"
                       FontWeight="Bold"
                       Foreground="{DynamicResource TextBrush}"/>
            <TextBlock Text="제목과 날짜를 수정합니다."
                       FontSize="11"
                       Foreground="{DynamicResource SubTextBrush}"
                       Margin="0,5,0,0"/>
        </StackPanel>

        <StackPanel Grid.Row="1" Margin="0,18,0,14">
            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="42"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="제목"
                           Foreground="{DynamicResource SubTextBrush}"
                           VerticalAlignment="Center"/>
                <TextBox x:Name="TitleInput"
                         Grid.Column="1"
                         Height="34"
                         Style="{StaticResource WidgetTextBox}"
                         FontSize="12"/>
            </Grid>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="42"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="날짜"
                           Foreground="{DynamicResource SubTextBrush}"
                           VerticalAlignment="Center"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <ComboBox x:Name="YearCombo"
                              Width="58"
                              Height="32"
                              Style="{StaticResource EditDateComboBox}"
                              IsEditable="True"/>
                    <TextBlock Text="년"
                               Foreground="{DynamicResource SubTextBrush}"
                               FontSize="10"
                               VerticalAlignment="Center"
                               Margin="2,0,4,0"/>
                    <ComboBox x:Name="MonthCombo"
                              Width="32"
                              Height="32"
                              Style="{StaticResource EditDateComboBox}"/>
                    <TextBlock Text="월"
                               Foreground="{DynamicResource SubTextBrush}"
                               FontSize="10"
                               VerticalAlignment="Center"
                               Margin="2,0,4,0"/>
                    <ComboBox x:Name="DayCombo"
                              Width="32"
                              Height="32"
                              Style="{StaticResource EditDateComboBox}"/>
                    <TextBlock Text="일"
                               Foreground="{DynamicResource SubTextBrush}"
                               FontSize="10"
                               VerticalAlignment="Center"
                               Margin="2,0,0,0"/>
                </StackPanel>
            </Grid>
        </StackPanel>

        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right">
            <Button Content="취소"
                    Width="78"
                    Height="34"
                    Margin="0,0,8,0"
                    Style="{StaticResource WidgetSecondaryButton}"
                    Click="CancelButton_Click"/>
            <Button Content="확인"
                    Width="78"
                    Height="34"
                    Style="{StaticResource WidgetPrimaryButton}"
                    Click="OkButton_Click"/>
        </StackPanel>
    </Grid>
</Window>
