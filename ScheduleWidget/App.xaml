<Application x:Class="ScheduleWidget.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:ScheduleWidget"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <!-- 테마 브러시 -->
        <SolidColorBrush x:Key="TopBarBrush" Color="#FFD9D9D9"/>
        <SolidColorBrush x:Key="BackgroundBrush" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="CardBrush" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="CardBorderBrush" Color="#DDDDDD"/>
        <SolidColorBrush x:Key="BottomBarBrush" Color="#FFE0E0E0"/>
        <SolidColorBrush x:Key="TextBrush" Color="#000000"/>
        <SolidColorBrush x:Key="SubTextBrush" Color="#808080"/>
        <SolidColorBrush x:Key="BorderBrush" Color="#808080"/>

        <!-- 폰트 크기 -->
        <sys:Double x:Key="TitleFontSize">14</sys:Double>
        <sys:Double x:Key="DDayFontSize">13</sys:Double>
    </Application.Resources>
</Application>
