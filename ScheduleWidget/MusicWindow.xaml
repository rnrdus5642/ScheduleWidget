<Window x:Class="ScheduleWidget.MusicWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        xmlns:local="clr-namespace:ScheduleWidget"
        Title="내 플레이리스트" Width="880" Height="840" MinWidth="650" MinHeight="480"
        WindowStartupLocation="CenterScreen" Background="{DynamicResource AuxCanvasBrush}"
        Foreground="{DynamicResource AuxInkBrush}" FontFamily="Segoe UI" FontSize="14" AllowDrop="True">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries><ResourceDictionary Source="Styles/AuxiliaryStyles.xaml"/></ResourceDictionary.MergedDictionaries>
            <local:TrackNumberConverter x:Key="TrackNumber"/>
            <Style x:Key="MusicCard" TargetType="Border" BasedOn="{StaticResource AuxRoundSection}">
                <Setter Property="Padding" Value="16"/><Setter Property="Margin" Value="0,0,0,12"/>
            </Style>
        </ResourceDictionary>
    </Window.Resources>
    <Grid x:Name="MusicSettingsContent" Drop="Window_Drop" DragOver="Window_DragOver" AllowDrop="True">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel x:Name="MusicHeading" Margin="0,0,40,20">
            <TextBlock Text="내 플레이리스트" Style="{StaticResource AuxTitle}"/>
        </StackPanel>
        <Grid x:Name="PlaylistToolbar" Grid.Row="1" Margin="0,0,8,12">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <ComboBox x:Name="PlaylistCombo" Style="{StaticResource AuxComboBox}" SelectionChanged="PlaylistChanged" Margin="0,0,12,0"
                      AutomationProperties.Name="플레이리스트 선택">
                <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"/></DataTemplate></ComboBox.ItemTemplate>
            </ComboBox>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button x:Name="AddPlaylistButton" Content="추가" Width="60" MinHeight="36" Padding="10,6" Margin="0,0,6,0"
                        Style="{StaticResource AuxPrimaryButton}" Click="AddPlaylist_Click" AutomationProperties.Name="플레이리스트 추가"/>
                <Button x:Name="EditPlaylistButton" Content="수정" Width="60" MinHeight="36" Padding="10,6" Margin="0,0,6,0"
                        Style="{StaticResource AuxSecondaryButton}" Click="EditPlaylist_Click" AutomationProperties.Name="플레이리스트 수정"/>
                <Button x:Name="DeletePlaylistButton" Content="삭제" Width="60" MinHeight="36" Padding="10,6"
                        Style="{StaticResource AuxUtilityButton}" Click="DeletePlaylist_Click" AutomationProperties.Name="플레이리스트 삭제"/>
            </StackPanel>
        </Grid>
        <ScrollViewer x:Name="MusicBodyScroll" Grid.Row="2" Padding="0,0,8,4" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <DockPanel Margin="0,0,0,8">
                    <TextBlock x:Name="TrackCount" Text="0곡" DockPanel.Dock="Right" Foreground="{DynamicResource AuxMutedBrush}"/>
                    <TextBlock Text="더블클릭으로 재생 · 끌어서 순서 변경" Foreground="{DynamicResource AuxMutedBrush}" FontSize="12"/>
                </DockPanel>
                <Grid Margin="0,0,0,14">
                    <ListBox x:Name="TrackList" MinHeight="180" MaxHeight="420" AlternationCount="2147483647"
                             Background="{DynamicResource AuxSurfaceBrush}" Foreground="{DynamicResource AuxInkBrush}"
                             BorderBrush="{DynamicResource AuxHairlineBrush}" BorderThickness="1" Padding="6"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled" MouseDoubleClick="Track_DoubleClick"
                             ScrollViewer.CanContentScroll="True" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                             HorizontalContentAlignment="Stretch" AllowDrop="True"
                             PreviewMouseLeftButtonDown="TrackList_PreviewMouseDown" PreviewMouseMove="TrackList_PreviewMouseMove"
                             PreviewMouseWheel="TrackList_PreviewMouseWheel"
                             DragOver="TrackList_DragOver" DragLeave="TrackList_DragLeave" Drop="TrackList_Drop" AutomationProperties.Name="곡 목록">
                        <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem">
                            <Setter Property="MaxWidth" Value="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=ScrollContentPresenter}}"/>
                        </Style></ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate><DataTemplate>
                            <Grid Margin="4,7" MinHeight="30">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="36"/><ColumnDefinition Width="*"/><ColumnDefinition Width="68"/></Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding (ItemsControl.AlternationIndex), RelativeSource={RelativeSource AncestorType=ListBoxItem}, Converter={StaticResource TrackNumber}}"
                                           Foreground="{DynamicResource AuxMutedBrush}" VerticalAlignment="Center"/>
                                <TextBlock x:Name="TrackTitle" Grid.Column="1" Text="{Binding Title}" FontSize="14" LineHeight="21" TextWrapping="Wrap" VerticalAlignment="Center">
                                    <TextBlock.ToolTip><StackPanel MaxWidth="480">
                                        <TextBlock Text="{Binding Title}" TextWrapping="Wrap" FontWeight="SemiBold"/>
                                        <TextBlock Text="{Binding Source}" TextWrapping="Wrap" Margin="0,5,0,0"/>
                                    </StackPanel></TextBlock.ToolTip>
                                </TextBlock>
                                <Border Grid.Column="2" Background="{DynamicResource AuxCanvasBrush}" CornerRadius="4" Padding="6,3" Margin="10,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Kind}" Foreground="{DynamicResource AuxMutedBrush}" FontSize="11" HorizontalAlignment="Center"/>
                                </Border>
                            </Grid>
                        </DataTemplate></ListBox.ItemTemplate>
                    </ListBox>
                    <TextBlock x:Name="EmptyTracksHint" Text="‘추가’ 또는 ‘수정’에서 곡을 넣어 주세요." TextWrapping="Wrap" HorizontalAlignment="Center" VerticalAlignment="Center"
                               Foreground="{DynamicResource AuxMutedBrush}" Margin="16" IsHitTestVisible="False" Visibility="Collapsed"/>
                    <Border x:Name="DropLine" Height="3" VerticalAlignment="Top" Margin="8,0,8,0" CornerRadius="1.5"
                            Background="{DynamicResource AuxActionBrush}" IsHitTestVisible="False" Visibility="Collapsed"/>
                </Grid>
        <Border x:Name="PlaybackControls" Style="{StaticResource MusicCard}">
            <StackPanel>
                <TextBlock Text="현재 재생" FontSize="12" Foreground="{DynamicResource AuxMutedBrush}"/>
                <TextBlock x:Name="NowPlaying" Text="재생할 곡을 선택하세요." TextWrapping="Wrap" TextTrimming="CharacterEllipsis"
                           MaxHeight="50" LineHeight="24" FontSize="17" FontWeight="SemiBold" Margin="0,5,0,14"
                           ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                <WrapPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,18,8">
                        <Button Content="이전" Width="60" MinHeight="38" Padding="8,0" Margin="0,0,6,0" Style="{StaticResource AuxUtilityButton}" Click="Previous_Click"/>
                        <Button x:Name="PlayButton" Content="재생" Width="96" MinHeight="38" Padding="8,0" Margin="0,0,6,0" Style="{StaticResource AuxPrimaryButton}" Click="Play_Click"/>
                        <Button Content="다음" Width="60" MinHeight="38" Padding="8,0" Margin="0,0,6,0" Style="{StaticResource AuxUtilityButton}" Click="Next_Click"/>
                        <Button Content="정지" Width="60" MinHeight="38" Padding="8,0" Style="{StaticResource AuxUtilityButton}" Click="Stop_Click"/>
                    </StackPanel>
                    <Grid Width="238" Height="38" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="40"/><ColumnDefinition Width="*"/><ColumnDefinition Width="44"/></Grid.ColumnDefinitions>
                        <TextBlock Text="음량" VerticalAlignment="Center" Foreground="{DynamicResource AuxMutedBrush}"/>
                        <Slider x:Name="VolumeSlider" Grid.Column="1" Minimum="0" Maximum="1" Value="0.5" SmallChange="0.05"
                                VerticalAlignment="Center" ValueChanged="VolumeChanged" AutomationProperties.Name="음량"/>
                        <TextBlock x:Name="VolumeValue" Grid.Column="2" Text="{Binding Value, ElementName=VolumeSlider, StringFormat={}{0:P0}}"
                                   VerticalAlignment="Center" TextAlignment="Right" Foreground="{DynamicResource AuxInkBrush}"/>
                    </Grid>
                </WrapPanel>
                <Border BorderBrush="{DynamicResource AuxHairlineBrush}" BorderThickness="0,1,0,0" Padding="0,12,0,0" Margin="0,4,0,0">
                    <WrapPanel>
                        <CheckBox x:Name="ShuffleToggle" Content="랜덤 재생" Style="{StaticResource AuxCheckBox}" Margin="0,4,18,6" Click="Shuffle_Click"/>
                        <CheckBox x:Name="RepeatOneToggle" Content="한 곡 반복" Style="{StaticResource AuxCheckBox}" Margin="0,4,18,6" Click="RepeatOne_Click"
                                  ToolTip="현재 곡을 반복합니다. 목록 반복과 랜덤보다 우선합니다."/>
                    </WrapPanel>
                </Border>
            </StackPanel>
        </Border>


        <Border Visibility="Collapsed" x:Name="VideoPreview" Background="{DynamicResource AuxDarkBrush}" Padding="12" Margin="0,0,0,12" CornerRadius="10" ClipToBounds="True">
            <Grid>
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <TextBlock Text="NOW PLAYING" Foreground="{DynamicResource AuxOnDarkMutedBrush}" FontSize="12" FontWeight="SemiBold"
                               HorizontalAlignment="Center"/>
                    <TextBlock Text="파일과 YouTube를 같은 목록에" Foreground="{DynamicResource AuxOnDarkBrush}" FontSize="24"
                               FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,10,0,0"/>
                    <TextBlock Text="아래에서 곡을 추가하고 재생하세요." Foreground="{DynamicResource AuxOnDarkMutedBrush}"
                               FontSize="14" HorizontalAlignment="Center" Margin="0,7,0,0"/>
                </StackPanel>
                <wv:WebView2 x:Name="YouTubePlayer" Visibility="Collapsed" MinWidth="480" MinHeight="180"
                             HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
            </Grid>
        </Border>


                <WrapPanel Margin="0,0,0,8">
                    <CheckBox x:Name="RepeatToggle" Content="목록 전체 반복" Style="{StaticResource AuxCheckBox}" Margin="0,0,18,6" Click="Repeat_Click"
                              ToolTip="마지막 곡을 재생한 뒤 목록의 처음부터 다시 재생합니다."/>
                    <Button x:Name="PlayOptionsResetButton" Content="재생 옵션 초기화" MinHeight="28" Padding="10,3" Margin="0,0,0,6"
                            Style="{StaticResource AuxCompactButton}" Click="PlayOptionsReset_Click"
                            ToolTip="반복·랜덤·한 곡 반복을 끄고 음량 50%, 재생목록 곡별 추가 켬으로 되돌립니다. 목록과 곡은 유지합니다."
                            AutomationProperties.Name="재생 옵션 초기화"/>
                </WrapPanel>
            </StackPanel>
        </ScrollViewer>
        <TextBlock x:Name="MusicStatus" Grid.Row="3" TextWrapping="Wrap" Foreground="{DynamicResource AuxMutedBrush}"
                   AutomationProperties.LiveSetting="Polite" Margin="0,6,8,0">
            <TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource AuxCaption}">
                <Style.Triggers><Trigger Property="Text" Value=""><Setter Property="Visibility" Value="Collapsed"/></Trigger></Style.Triggers>
            </Style></TextBlock.Style>
        </TextBlock>
    </Grid>
</Window>